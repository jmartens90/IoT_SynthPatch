{ V2Fix.pas - Generated by Claude for the V2 changes.
  FixPcb : run with IoT_SYNTHPATCH.PcbDoc active  -> ENC1 to EC11 geometry + J1 silk cleanup
  FixLib : run with IoT_SYNTHPATCH.PcbLib active  -> same on the library footprints
  FixSch : run with DISPLAY.SchDoc active          -> ENC1 comment to EC11
  Modify-only: no primitives are created or deleted. Log: Scripts\v2fix_log.txt }

Var Log : TStringList;

Function Sgn(V) : Integer;
Begin
  If V < 0 Then Result := -1 Else Result := 1;
End;

Function MM(C) : String;
Begin
  Result := FormatFloat('0.000', CoordToMMs(C));
End;

Procedure SetPadGeom(P, X, Y, SX, SY, Hole, HoleW);
Begin
  P.BeginModify;
  P.X := X; P.Y := Y;
  P.TopXSize := SX; P.TopYSize := SY;
  P.MidXSize := SX; P.MidYSize := SY;
  P.BotXSize := SX; P.BotYSize := SY;
  P.HoleSize := Hole;
  If HoleW > 0 Then P.HoleWidth := HoleW;
  P.EndModify;
  Log.Add('  pad ' + P.Name + ' -> ' + MM(X) + ',' + MM(Y));
End;

Procedure SetTrack(T, X1, Y1, X2, Y2);
Begin
  T.BeginModify;
  T.X1 := X1; T.Y1 := Y1; T.X2 := X2; T.Y2 := Y2;
  T.EndModify;
End;

{ ENC1: PEC16 -> EC11E with switch. A-C-B row 2.5 mm pitch, 7.5 mm from shaft,
  C (common, GND) in the middle. Lugs +-5.6 mm. Switch pins D/E unchanged (already 7.0 / 5 mm). }
Procedure FixEnc(Owner);
Var GIt, P, PA, PB, PC, L1, L2 : Variant;
    SX0, SY0, Dp, Sx, RowY, Lw, Bx1, Bx2, By1, By2 : Variant;
    Tr : Array[0..15] Of Variant; NT, I, K : Integer;
Begin
  PA := Nil; PB := Nil; PC := Nil; L1 := Nil; L2 := Nil; NT := 0;
  GIt := Owner.GroupIterator_Create;
  GIt.AddFilter_ObjectSet(MkSet(ePadObject));
  P := GIt.FirstPCBObject;
  While P <> Nil Do
  Begin
    If P.Name = 'A' Then PA := P
    Else If P.Name = 'B' Then PB := P
    Else If P.Name = 'C' Then PC := P
    Else If P.HoleType <> 0 Then
    Begin
      If L1 = Nil Then L1 := P Else L2 := P;
    End;
    P := GIt.NextPCBObject;
  End;
  Owner.GroupIterator_Destroy(GIt);
  If (PA = Nil) Or (PB = Nil) Or (PC = Nil) Or (L1 = Nil) Or (L2 = Nil) Then
  Begin
    Log.Add('ENC: pads not found, nothing changed'); Exit;
  End;
  If PA.HoleSize = MMsToCoord(1.0) Then
  Begin
    Log.Add('ENC: already EC11, skipped'); Exit;
  End;
  SX0 := (L1.X + L2.X) Div 2; SY0 := (L1.Y + L2.Y) Div 2;
  Dp := Sgn(PA.Y - SY0); Sx := Sgn(PC.X - PA.X);
  RowY := SY0 + Dp * MMsToCoord(7.5);
  Log.Add('ENC shaft ' + MM(SX0) + ',' + MM(SY0) + ' dp=' + IntToStr(Dp) + ' sx=' + IntToStr(Sx));
  SetPadGeom(PA, SX0 - Sx * MMsToCoord(2.5), RowY, MMsToCoord(1.8), MMsToCoord(1.8), MMsToCoord(1.0), 0);
  SetPadGeom(PC, SX0, RowY, MMsToCoord(1.8), MMsToCoord(1.8), MMsToCoord(1.0), 0);
  SetPadGeom(PB, SX0 + Sx * MMsToCoord(2.5), RowY, MMsToCoord(1.8), MMsToCoord(1.8), MMsToCoord(1.0), 0);
  SetPadGeom(L1, SX0 + Sgn(L1.X - SX0) * MMsToCoord(5.6), SY0, MMsToCoord(2.0), MMsToCoord(3.2), MMsToCoord(2.8), MMsToCoord(1.5));
  SetPadGeom(L2, SX0 + Sgn(L2.X - SX0) * MMsToCoord(5.6), SY0, MMsToCoord(2.0), MMsToCoord(3.2), MMsToCoord(2.8), MMsToCoord(1.5));

  Bx1 := SX0 - MMsToCoord(7.1); Bx2 := SX0 + MMsToCoord(7.1);
  By1 := SY0 - MMsToCoord(5.6); By2 := SY0 + MMsToCoord(5.6);
  GIt := Owner.GroupIterator_Create;
  GIt.AddFilter_ObjectSet(MkSet(eTrackObject, eArcObject));
  P := GIt.FirstPCBObject;
  While P <> Nil Do
  Begin
    If (P.Layer = eTopOverlay) Or (P.Layer = eBottomOverlay) Then
    Begin
      If P.ObjectId = eTrackObject Then
      Begin
        If NT <= 15 Then Begin Tr[NT] := P; NT := NT + 1; End;
      End
      Else
      Begin
        P.BeginModify;
        P.XCenter := SX0 - Sx * MMsToCoord(4.1);
        P.YCenter := RowY + Dp * MMsToCoord(1.0);
        P.EndModify;
        Log.Add('  silk dot -> ' + MM(P.XCenter) + ',' + MM(P.YCenter));
      End;
    End;
    P := GIt.NextPCBObject;
  End;
  Owner.GroupIterator_Destroy(GIt);
  For I := 0 To NT - 1 Do
  Begin
    K := I Mod 4;
    If K = 0 Then SetTrack(Tr[I], Bx1, By1, Bx2, By1)
    Else If K = 1 Then SetTrack(Tr[I], Bx2, By1, Bx2, By2)
    Else If K = 2 Then SetTrack(Tr[I], Bx2, By2, Bx1, By2)
    Else SetTrack(Tr[I], Bx1, By2, Bx1, By1);
  End;
  Log.Add('  ENC silk lines reshaped: ' + IntToStr(NT));
End;

{ J1: replace the 4 leftover Molex silk lines by two short side lines between the leg pads. }
Procedure FixJ1(Owner);
Var GIt, P, R1, R2, XL, XR, Y1, Y2, YA, YB, HA, HB : Variant;
    Tr : Array[0..15] Of Variant; NT, I : Integer; First : Boolean;
Begin
  NT := 0; First := True; XL := 0; XR := 0; YA := 0; YB := 0; HA := 0; HB := 0;
  GIt := Owner.GroupIterator_Create;
  GIt.AddFilter_ObjectSet(MkSet(ePadObject, eTrackObject));
  P := GIt.FirstPCBObject;
  While P <> Nil Do
  Begin
    If (P.ObjectId = ePadObject) Then
    Begin
      If P.HoleSize > 0 Then
      Begin
        If First Then
        Begin
          XL := P.X; XR := P.X; YA := P.Y; YB := P.Y; HA := P.TopYSize Div 2; HB := HA; First := False;
        End
        Else
        Begin
          If P.X < XL Then XL := P.X;
          If P.X > XR Then XR := P.X;
          If P.Y < YA Then Begin YA := P.Y; HA := P.TopYSize Div 2; End;
          If P.Y > YB Then Begin YB := P.Y; HB := P.TopYSize Div 2; End;
        End;
      End;
    End
    Else If (P.Layer = eTopOverlay) Or (P.Layer = eBottomOverlay) Then
    Begin
      If NT <= 15 Then Begin Tr[NT] := P; NT := NT + 1; End;
    End;
    P := GIt.NextPCBObject;
  End;
  Owner.GroupIterator_Destroy(GIt);
  If First Or (NT = 0) Then Begin Log.Add('J1: nothing found'); Exit; End;
  Y1 := YA + HA + MMsToCoord(0.27);
  Y2 := YB - HB - MMsToCoord(0.27);
  Log.Add('J1 legs x ' + MM(XL) + '..' + MM(XR) + ' y ' + MM(YA) + '..' + MM(YB) + ' silk y ' + MM(Y1) + '..' + MM(Y2));
  If Y2 <= Y1 Then Begin Log.Add('J1: no room, skipped'); Exit; End;
  For I := 0 To NT - 1 Do
  Begin
    If (I Mod 2) = 0 Then SetTrack(Tr[I], XL - MMsToCoord(0.8), Y1, XL - MMsToCoord(0.8), Y2)
    Else SetTrack(Tr[I], XR + MMsToCoord(0.8), Y1, XR + MMsToCoord(0.8), Y2);
  End;
  Log.Add('  J1 silk lines reshaped: ' + IntToStr(NT));
End;

Procedure FixPcb;
Var Board, It, C : Variant;
Begin
  Log := TStringList.Create;
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Begin Log.Add('No PCB active'); Log.SaveToFile('C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\v2fix_log.txt'); Exit; End;
  Log.Add('FixPcb on ' + Board.FileName);
  PCBServer.PreProcess;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eComponentObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  C := It.FirstPCBObject;
  While C <> Nil Do
  Begin
    If C.Name.Text = 'ENC1' Then Begin C.BeginModify; FixEnc(C); C.EndModify; End;
    If C.Name.Text = 'J1' Then Begin C.BeginModify; FixJ1(C); C.EndModify; End;
    C := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  Log.SaveToFile('C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\v2fix_log.txt');
End;

Procedure FixLib;
Var Lib, It, F : Variant;
Begin
  Log := TStringList.Create;
  Lib := PCBServer.GetCurrentPCBLibrary;
  If Lib = Nil Then Begin Log.Add('No PcbLib active'); Log.SaveToFile('C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\v2fix_lib_log.txt'); Exit; End;
  PCBServer.PreProcess;
  It := Lib.LibraryIterator_Create;
  It.SetState_FilterAll;
  F := It.FirstPCBObject;
  While F <> Nil Do
  Begin
    Log.Add('FP ' + F.Name);
    If F.Name = 'FP-PEC16-4115F-S0012-MFG' Then FixEnc(F);
    If F.Name = 'USB_C_HRO_TYPE-C-31-M-12' Then FixJ1(F);
    F := It.NextPCBObject;
  End;
  Lib.LibraryIterator_Destroy(It);
  PCBServer.PostProcess;
  Lib.RefreshView;
  Log.SaveToFile('C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\v2fix_lib_log.txt');
End;

Procedure FixSch;
Var Doc, It, C : Variant;
Begin
  Log := TStringList.Create;
  Doc := SchServer.GetCurrentSchDocument;
  If Doc <> Nil Then
  Begin
    SchServer.ProcessControl.PreProcess(Doc, '');
    It := Doc.SchIterator_Create;
    It.AddFilter_ObjectSet(MkSet(eSchComponent));
    C := It.FirstSchObject;
    While C <> Nil Do
    Begin
      If C.Designator.Text = 'ENC1' Then
      Begin
        Log.Add('ENC1 comment was ' + C.Comment.Text);
        C.Comment.Text := 'EC11E15244G1 (EC11 with switch)';
        C.GraphicallyInvalidate;
        Log.Add('ENC1 comment now ' + C.Comment.Text);
      End;
      C := It.NextSchObject;
    End;
    Doc.SchIterator_Destroy(It);
    SchServer.ProcessControl.PostProcess(Doc, '');
    Doc.GraphicallyInvalidate;
  End
  Else Log.Add('No SchDoc active');
  Log.SaveToFile('C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\v2fix_sch_log.txt');
End;
