{ CONNECTORS sheet: ties the VREF_5 wires of H1 pin 5 and H2 pin 5 together with net labels,
  so the two same-named ports form one net. Run with CONNECTORS.SchDoc active. Generated by Claude. }

Procedure AddLabel(Doc : ISch_Document; X, Y : Integer);
Var
  N : ISch_NetLabel;
Begin
  N := SchServer.SchObjectFactory(eNetLabel, eCreate_Default);
  N.Text := 'VREF_5';
  N.Location := Point(MilsToCoord(X), MilsToCoord(Y));
  Doc.RegisterSchObjectInContainer(N);
  SchServer.RobotManager.SendMessage(Doc.I_ObjectAddress, c_BroadCast, SCHM_PrimitiveRegistration, N.I_ObjectAddress);
End;

Procedure TieVref5;
Var
  Doc : ISch_Document;
Begin
  Doc := SchServer.GetCurrentSchDocument;
  If Doc = Nil Then Exit;
  If Pos('CONNECTORS', UpperCase(Doc.DocumentName)) = 0 Then
  Begin
    ShowMessage('Make the CONNECTORS sheet active first.');
    Exit;
  End;
  SchServer.ProcessControl.PreProcess(Doc, '');
  AddLabel(Doc, 1750, 6600);
  AddLabel(Doc, 4750, 6600);
  SchServer.ProcessControl.PostProcess(Doc, '');
  Doc.GraphicallyInvalidate;
  ShowMessage('VREF_5 net labels added. Save the sheet.');
End;
