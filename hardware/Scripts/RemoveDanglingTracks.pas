{ Removes dangling copper track stubs: a track with an end that touches no pad, via, fill, region,
  arc or other track on its layer. Repeats until nothing dangles any more, so chains of stubs go too.
  Skips polygon pour primitives, footprint tracks and every net that has a polygon pour (e.g. GND),
  because those can end inside a pour. Vias are never removed. Report: Scripts\remove_dangling.txt.
  Run with the PcbDoc active: File > Run Script > RemoveDanglingTracks.pas > RemoveDanglingTracks. Generated by Claude. }
Const
  RP = 'C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\remove_dangling.txt';

Var
  Board : IPCB_Board;
  Tol : TCoord;

Function NetName(O : IPCB_Primitive) : String;
Begin
  If O.Net = Nil Then Result := '' Else Result := O.Net.Name;
End;

Function SegDist(PX0, PY0, AX, AY, BX, BY : TCoord) : Double;
Var
  DX, DY, L2, U, QX, QY : Double;
Begin
  DX := (BX - AX) * 1.0;
  DY := (BY - AY) * 1.0;
  L2 := DX * DX + DY * DY;
  If L2 = 0 Then U := 0
  Else
  Begin
    QX := (PX0 - AX) * 1.0;
    QY := (PY0 - AY) * 1.0;
    U := (QX * DX + QY * DY) / L2;
  End;
  If U < 0 Then U := 0;
  If U > 1 Then U := 1;
  QX := (AX - PX0) + U * DX;
  QY := (AY - PY0) + U * DY;
  Result := Sqrt(QX * QX + QY * QY);
End;

{ True when point (X, Y) on layer L touches anything other than track T. }
Function Touches(T : IPCB_Track; X, Y : TCoord; L : TLayer) : Boolean;
Var
  It : IPCB_SpatialIterator;
  O : IPCB_Primitive;
  D, R, DX, DY : Double;
Begin
  Result := False;
  It := Board.SpatialIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eTrackObject, eArcObject, ePadObject, eViaObject, eFillObject, eRegionObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Area(X - Tol, Y - Tol, X + Tol, Y + Tol);
  O := It.FirstPCBObject;
  While (O <> Nil) And (Not Result) Do
  Begin
    If O.I_ObjectAddress <> T.I_ObjectAddress Then
    Begin
      If O.ObjectId = ePadObject Then
      Begin
        If (O.Layer = eMultiLayer) Or (O.Layer = L) Then Result := True;
      End
      Else If O.ObjectId = eViaObject Then Result := True
      Else If O.Layer = L Then
      Begin
        If O.ObjectId = eTrackObject Then
        Begin
          D := SegDist(X, Y, O.X1, O.Y1, O.X2, O.Y2);
          If D <= O.Width / 2 + Tol Then Result := True;
        End
        Else If O.ObjectId = eArcObject Then
        Begin
          DX := (X - O.XCenter) * 1.0;
          DY := (Y - O.YCenter) * 1.0;
          D := Sqrt(DX * DX + DY * DY);
          R := Abs(D - O.Radius);
          If R <= O.LineWidth / 2 + Tol Then Result := True;
        End
        Else Result := True;   { fill or region on this layer }
      End;
    End;
    O := It.NextPCBObject;
  End;
  Board.SpatialIterator_Destroy(It);
End;

Procedure RemoveDanglingTracks;
Var
  It : IPCB_BoardIterator;
  O : IPCB_Primitive;
  T : IPCB_Track;
  Tracks : TInterfaceList;
  PolyNets, Rep : TStringList;
  i, Pass, Hit, Total : Integer;
  Dangles : Boolean;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  Tol := MMsToCoord(0.01);
  Tracks := TInterfaceList.Create;
  PolyNets := TStringList.Create;
  Rep := TStringList.Create;

  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(ePolyObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  O := It.FirstPCBObject;
  While O <> Nil Do
  Begin
    If (NetName(O) <> '') And (PolyNets.IndexOf(NetName(O)) < 0) Then PolyNets.Add(NetName(O));
    O := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);

  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eTrackObject));
  It.AddFilter_LayerSet(MkSet(eTopLayer, eBottomLayer, eMidLayer1, eMidLayer2));
  It.AddFilter_Method(eProcessAll);
  O := It.FirstPCBObject;
  While O <> Nil Do
  Begin
    If (Not O.InPolygon) And (Not O.InComponent) And (PolyNets.IndexOf(NetName(O)) < 0) Then Tracks.Add(O);
    O := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  Rep.Add('tracks checked ' + IntToStr(Tracks.Count) + '; nets skipped (have a pour): ' + PolyNets.CommaText);

  Total := 0;
  PCBServer.PreProcess;
  For Pass := 1 To 50 Do
  Begin
    Hit := 0;
    For i := Tracks.Count - 1 DownTo 0 Do
    Begin
      T := Tracks.Items[i];
      Dangles := Not Touches(T, T.X1, T.Y1, T.Layer);
      If Not Dangles Then Dangles := Not Touches(T, T.X2, T.Y2, T.Layer);
      If Dangles Then
      Begin
        Rep.Add('pass ' + IntToStr(Pass) + ': ' + NetName(T) + ' on ' + Layer2String(T.Layer) + ' at ' +
          FloatToStr(CoordToMMs(T.X1)) + ',' + FloatToStr(CoordToMMs(T.Y1)) + ' - ' +
          FloatToStr(CoordToMMs(T.X2)) + ',' + FloatToStr(CoordToMMs(T.Y2)));
        Board.RemovePCBObject(T);
        Tracks.Delete(i);
        Hit := Hit + 1;
      End;
    End;
    Total := Total + Hit;
    If Hit = 0 Then Break;
  End;
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  Rep.Add('removed ' + IntToStr(Total) + ' dangling tracks');
  Rep.SaveToFile(RP);
  ShowMessage('Removed ' + IntToStr(Total) + ' dangling tracks. See Scripts\remove_dangling.txt. Save if it looks right.');
End;
