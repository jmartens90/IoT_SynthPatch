{ ReDes.pas - Generated by Claude. Run with POWER.SchDoc active: re-applies the designators
  of the new V2 parts through the normal modify messages so the compiler sees them. }
Procedure ReDes;
Var Doc, It, C, D, Log, S;
Begin
  Log := TStringList.Create;
  Doc := SchServer.GetCurrentSchDocument;
  If Doc = Nil Then Exit;
  SchServer.ProcessControl.PreProcess(Doc, '');
  It := Doc.SchIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eSchComponent));
  C := It.FirstSchObject;
  While C <> Nil Do
  Begin
    S := C.Designator.Text;
    If (S = 'DS20') Or (S = 'DS21') Or (S = 'D16') Or (S = 'D17') Or (S = 'J32') Or (S = 'tp9') Or (S = 'tp10') Or (S = 'R4') Or (S = 'R16') Then
    Begin
      D := C.Designator;
      SchServer.RobotManager.SendMessage(C.I_ObjectAddress, c_BroadCast, SCHM_BeginModify, c_NoEventData);
      SchServer.RobotManager.SendMessage(D.I_ObjectAddress, c_BroadCast, SCHM_BeginModify, c_NoEventData);
      D.Text := S + 'x';
      D.Text := S;
      SchServer.RobotManager.SendMessage(D.I_ObjectAddress, c_BroadCast, SCHM_EndModify, c_NoEventData);
      SchServer.RobotManager.SendMessage(C.I_ObjectAddress, c_BroadCast, SCHM_EndModify, c_NoEventData);
      Log.Add('re-set ' + S);
    End;
    C := It.NextSchObject;
  End;
  Doc.SchIterator_Destroy(It);
  SchServer.ProcessControl.PostProcess(Doc, '');
  Log.SaveToFile('C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\redes_log.txt');
End;
