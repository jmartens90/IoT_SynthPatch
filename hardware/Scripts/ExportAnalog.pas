{ Read-only. Lists all open connections, tracks, arcs, vias, pads, polygons and components
  in mm from the board corner. Writes Scripts\analog_export.txt.
  Generated by Claude. }
Function MM(C : TCoord) : String;
Begin
  Result := FloatToStrF(CoordToMMs(C), ffFixed, 8, 3);
End;

Procedure ExportAnalog;
Var
  Board : IPCB_Board;
  It : IPCB_BoardIterator;
  O : IPCB_Primitive;
  T : IPCB_Track;
  V : IPCB_Via;
  P : IPCB_Pad;
  A : IPCB_Arc;
  Cn : IPCB_Connection;
  L : TStringList;
  RC : TCoordRect;
  X0, Y0 : TCoord;
  N, CompName : String;
  Pg : IPCB_Polygon;
  C : IPCB_Component;
  R2 : TCoordRect;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  RC := Board.BoardOutline.BoundingRectangle;
  X0 := RC.Left;
  Y0 := RC.Bottom;
  L := TStringList.Create;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eConnectionObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  Cn := It.FirstPCBObject;
  While Cn <> Nil Do
  Begin
    L.Add('R;' + Cn.Net.Name + ';' + MM(Cn.X1 - X0) + ';' + MM(Cn.Y1 - Y0) + ';' + MM(Cn.X2 - X0) + ';' + MM(Cn.Y2 - Y0));
    Cn := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);

  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eTrackObject, eViaObject, ePadObject, eArcObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  O := It.FirstPCBObject;
  While O <> Nil Do
  Begin
    If O.Net = Nil Then N := '' Else N := O.Net.Name;
    If O.ObjectId = eTrackObject Then
    Begin
      T := O;
      If Not T.InPolygon Then
        L.Add('T;' + N + ';' + Layer2String(T.Layer) + ';' + MM(T.Width) + ';' + MM(T.X1 - X0) + ';' + MM(T.Y1 - Y0) + ';' + MM(T.X2 - X0) + ';' + MM(T.Y2 - Y0));
    End
    Else If O.ObjectId = eArcObject Then
    Begin
      A := O;
      If Not A.InPolygon Then
        L.Add('A;' + N + ';' + Layer2String(A.Layer) + ';' + MM(A.LineWidth) + ';' + MM(A.XCenter - X0) + ';' + MM(A.YCenter - Y0) + ';' + MM(A.Radius));
    End
    Else If O.ObjectId = eViaObject Then
    Begin
      V := O;
      L.Add('V;' + N + ';' + MM(V.Size) + ';' + MM(V.HoleSize) + ';' + MM(V.X - X0) + ';' + MM(V.Y - Y0) + ';' + Layer2String(V.LowLayer) + ';' + Layer2String(V.HighLayer));
    End
    Else If O.ObjectId = ePadObject Then
    Begin
      P := O;
      If P.Component = Nil Then CompName := '' Else CompName := P.Component.Name.Text;
      L.Add('P;' + CompName + '-' + P.Name + ';' + N + ';' + Layer2String(P.Layer) + ';' + MM(P.X - X0) + ';' + MM(P.Y - Y0) + ';' +
            MM(P.TopXSize) + ';' + MM(P.TopYSize) + ';' + FloatToStr(P.Rotation) + ';' + MM(P.HoleSize));
    End;
    O := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);

  L.Add('B;' + MM(RC.Right - RC.Left) + ';' + MM(RC.Top - RC.Bottom));
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(ePolyObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  Pg := It.FirstPCBObject;
  While Pg <> Nil Do
  Begin
    If Pg.Net = Nil Then N := '' Else N := Pg.Net.Name;
    R2 := Pg.BoundingRectangle;
    L.Add('G;' + Pg.Name + ';' + N + ';' + Layer2String(Pg.Layer) + ';' + MM(R2.Left - X0) + ';' + MM(R2.Bottom - Y0) + ';' + MM(R2.Right - X0) + ';' + MM(R2.Top - Y0));
    Pg := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eComponentObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  C := It.FirstPCBObject;
  While C <> Nil Do
  Begin
    R2 := C.BoundingRectangleNoNameComment;
    L.Add('C;' + C.Name.Text + ';' + Layer2String(C.Layer) + ';' + C.Pattern + ';' + MM(C.X - X0) + ';' + MM(C.Y - Y0) + ';' + MM(R2.Left - X0) + ';' + MM(R2.Bottom - Y0) + ';' + MM(R2.Right - X0) + ';' + MM(R2.Top - Y0));
    C := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  L.SaveToFile('C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\analog_export.txt');
  ShowMessage('Wrote analog_export.txt (' + IntToStr(L.Count) + ' lines).');
  L.Free;
End;
