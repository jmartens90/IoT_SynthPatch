{ Analog board: places all op-amp parts (bottom side), the pin headers H1-H3 (top side, facing the main board)
  and the four M3 holes. Run with IoT_SYNTHPATCH_ANALOG.PcbDoc active:
  File > Run Script > PlaceAnalogBoard.pas > PlaceAnalogBoard. Generated by Claude. }

Function Fld(S : String; Idx : Integer) : String;
Var
  i, n : Integer;
Begin
  Result := '';
  n := 0;
  For i := 1 To Length(S) Do
  Begin
    If S[i] = ';' Then n := n + 1
    Else If n = Idx Then Result := Result + S[i];
  End;
End;

Function Num(S : String) : Double;
Begin
  Result := StrToInt(S) / 1000;  { values in micrometres: no decimal separator, so the Dutch locale can't trip it }
End;

Function FindComp(Board : IPCB_Board; Des : String) : IPCB_Component;
Var
  It : IPCB_BoardIterator;
  C  : IPCB_Component;
Begin
  Result := Nil;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eComponentObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  C := It.FirstPCBObject;
  While C <> Nil Do
  Begin
    If C.Name.Text = Des Then Result := C;
    C := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
End;

Function Pad1(C : IPCB_Component) : IPCB_Pad;
Var
  GI : IPCB_GroupIterator;
  P  : IPCB_Pad;
Begin
  Result := Nil;
  GI := C.GroupIterator_Create;
  GI.AddFilter_ObjectSet(MkSet(ePadObject));
  P := GI.FirstPCBObject;
  While P <> Nil Do
  Begin
    If P.Name = '1' Then Result := P;
    P := GI.NextPCBObject;
  End;
  C.GroupIterator_Destroy(GI);
End;

Procedure PlaceOne(Board : IPCB_Board; C : IPCB_Component; X, Y, Rot : Double; Bottom : Boolean);
Begin
  PCBServer.SendMessageToRobots(C.I_ObjectAddress, c_Broadcast, PCBM_BeginModify, c_NoEventData);
  If Bottom Then C.Layer := eBottomLayer Else C.Layer := eTopLayer;
  C.Rotation := Rot;
  C.MoveToXY(Board.XOrigin + MMsToCoord(X), Board.YOrigin + MMsToCoord(Y));
  PCBServer.SendMessageToRobots(C.I_ObjectAddress, c_Broadcast, PCBM_EndModify, c_NoEventData);
End;

{ Places a header so that its pad 1 lands where pad 1 of the mating header on the other board is.
  Pad 1 target: rot 0 -> left end, rot 90 -> bottom end. Turns the part 180 deg if needed. }
Function PlaceHeader(Board : IPCB_Board; Des : String; X, Y, Rot : Double; N : Integer; Bottom : Boolean) : String;
Var
  C : IPCB_Component;
  P : IPCB_Pad;
  TX, TY, Half : Double;
Begin
  Result := Des + ' not found';
  C := FindComp(Board, Des);
  If C = Nil Then Exit;
  Half := (N - 1) * 2.54 / 2;
  If Rot = 0 Then Begin TX := X - Half; TY := Y; End Else Begin TX := X; TY := Y - Half; End;
  PlaceOne(Board, C, X, Y, Rot, Bottom);
  P := Pad1(C);
  If (Abs(CoordToMMs(P.X - Board.XOrigin) - TX) > 0.1) Or (Abs(CoordToMMs(P.Y - Board.YOrigin) - TY) > 0.1) Then
    PlaceOne(Board, C, X, Y, Rot + 180, Bottom);
  P := Pad1(C);
  Result := Des + ' pad 1 at ' + FloatToStrF(CoordToMMs(P.X - Board.XOrigin), ffFixed, 6, 2) + ', ' +
            FloatToStrF(CoordToMMs(P.Y - Board.YOrigin), ffFixed, 6, 2) + ' (target ' +
            FloatToStrF(TX, ffFixed, 6, 2) + ', ' + FloatToStrF(TY, ffFixed, 6, 2) + ')';
End;

Procedure AddHole(Board : IPCB_Board; X, Y : Double);
Var
  P : IPCB_Pad;
Begin
  P := PCBServer.PCBObjectFactory(ePadObject, eNoDimension, eCreate_Default);
  P.X := Board.XOrigin + MMsToCoord(X);
  P.Y := Board.YOrigin + MMsToCoord(Y);
  P.Layer := eMultiLayer;
  P.TopXSize := MMsToCoord(6.0);
  P.TopYSize := MMsToCoord(6.0);
  P.MidXSize := MMsToCoord(6.0);
  P.MidYSize := MMsToCoord(6.0);
  P.BotXSize := MMsToCoord(6.0);
  P.BotYSize := MMsToCoord(6.0);
  P.HoleSize := MMsToCoord(3.2);
  P.TopShape := eRounded;
  P.MidShape := eRounded;
  P.BotShape := eRounded;
  P.Plated := True;
  P.Name := 'MH';
  Board.AddPCBObject(P);
  PCBServer.SendMessageToRobots(Board.I_ObjectAddress, c_Broadcast, PCBM_BoardRegisteration, P.I_ObjectAddress);
End;

Procedure AddTrack(Board : IPCB_Board; Layer : TLayer; X1, Y1, X2, Y2, W : Double);
Var
  T : IPCB_Track;
Begin
  T := PCBServer.PCBObjectFactory(eTrackObject, eNoDimension, eCreate_Default);
  T.X1 := Board.XOrigin + MMsToCoord(X1);
  T.Y1 := Board.YOrigin + MMsToCoord(Y1);
  T.X2 := Board.XOrigin + MMsToCoord(X2);
  T.Y2 := Board.YOrigin + MMsToCoord(Y2);
  T.Layer := Layer;
  T.Width := MMsToCoord(W);
  Board.AddPCBObject(T);
  PCBServer.SendMessageToRobots(Board.I_ObjectAddress, c_Broadcast, PCBM_BoardRegisteration, T.I_ObjectAddress);
End;

