{ FixJackLib.pas - run with IoT_SYNTHPATCH.PcbLib active. In footprint THONK_PJ398SM-12 swaps the
  designators of pads 1 and 3, so pad 1 (signal) sits in the tip hole and pad 3 (GND) in the sleeve hole.
  Generated by Claude. }
Procedure FixJackLib;
Var Lib : IPCB_Library; It : IPCB_LibraryIterator; C, F : IPCB_LibComponent;
    GIt : IPCB_GroupIterator; P, P1, P3 : IPCB_Pad;
Begin
  Lib := PCBServer.GetCurrentPCBLibrary;
  If Lib = Nil Then Begin ShowMessage('Make the PcbLib active first'); Exit; End;
  F := Nil;
  It := Lib.LibraryIterator_Create; It.SetState_FilterAll;
  C := It.FirstPCBObject;
  While C <> Nil Do Begin If UpperCase(C.Name) = 'THONK_PJ398SM-12' Then F := C; C := It.NextPCBObject; End;
  Lib.LibraryIterator_Destroy(It);
  If F = Nil Then Begin ShowMessage('THONK_PJ398SM-12 not found'); Exit; End;
  P1 := Nil; P3 := Nil;
  GIt := F.GroupIterator_Create; GIt.AddFilter_ObjectSet(MkSet(ePadObject));
  P := GIt.FirstPCBObject;
  While P <> Nil Do Begin If P.Name = '1' Then P1 := P; If P.Name = '3' Then P3 := P; P := GIt.NextPCBObject; End;
  F.GroupIterator_Destroy(GIt);
  If (P1 = Nil) Or (P3 = Nil) Then Begin ShowMessage('pads 1/3 not found'); Exit; End;
  PCBServer.PreProcess;
  P1.BeginModify; P3.BeginModify;
  P1.Name := '3'; P3.Name := '1';
  P1.EndModify; P3.EndModify;
  PCBServer.PostProcess;
  Lib.CurrentComponent := F;
  Lib.Board.ViewManager_FullUpdate;
  ShowMessage('THONK_PJ398SM-12: pads 1 and 3 swapped. Save the PcbLib.');
End;
