{ Main board: cuts a void in every used internal plane layer under the ESP32 antenna,
  matching the Top/SIG_MID/Bottom pour cutout: x 14.80..33.45 mm, y 101.87 mm .. past the top edge,
  measured from the board outline's bottom-left corner. A fill on a plane layer = no copper.
  Generated by Claude. }
Procedure AntennaPlaneVoid;
Var
  Board : IPCB_Board;
  It : IPCB_BoardIterator;
  T : IPCB_Track;
  F : IPCB_Fill;
  RC : TCoordRect;
  X0, Y0 : TCoord;
  Cnt : Array[1..8] Of Integer;
  i, NF : Integer;
  Lay : TLayer;
  Msg : String;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  RC := Board.BoardOutline.BoundingRectangle;
  X0 := RC.Left;
  Y0 := RC.Bottom;
  For i := 1 To 8 Do Cnt[i] := 0;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eTrackObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  T := It.FirstPCBObject;
  While T <> Nil Do
  Begin
    For i := 1 To 8 Do
      If T.Layer = eInternalPlane1 + i - 1 Then Cnt[i] := Cnt[i] + 1;
    T := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);

  NF := 0;
  Msg := '';
  PCBServer.PreProcess;
  For i := 1 To 8 Do
    If Cnt[i] > 0 Then
    Begin
      Lay := eInternalPlane1 + i - 1;
      F := PCBServer.PCBObjectFactory(eFillObject, eNoDimension, eCreate_Default);
      F.X1Location := X0 + MMsToCoord(14.80);
      F.Y1Location := Y0 + MMsToCoord(101.87);
      F.X2Location := X0 + MMsToCoord(33.45);
      F.Y2Location := RC.Top + MMsToCoord(1.0);
      F.Rotation := 0;
      F.Layer := Lay;
      Board.AddPCBObject(F);
      PCBServer.SendMessageToRobots(Board.I_ObjectAddress, c_Broadcast, PCBM_BoardRegisteration, F.I_ObjectAddress);
      NF := NF + 1;
      Msg := Msg + Layer2String(Lay) + ' (' + Board.LayerName(Lay) + ')  ';
    End;
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  ShowMessage('Antenna voids placed: ' + IntToStr(NF) + ' on ' + Msg);
End;
