{ Tents every via on both sides (no solder mask opening), so vias next to pads stop making
  solder mask slivers. Undo with Ctrl+Z. Generated by Claude. }
Procedure TentViasA;
Var
  Board : IPCB_Board;
  It : IPCB_BoardIterator;
  V : IPCB_Via;
  L : TInterfaceList;
  i : Integer;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  L := TInterfaceList.Create;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eViaObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  V := It.FirstPCBObject;
  While V <> Nil Do
  Begin
    L.Add(V);
    V := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  PCBServer.PreProcess;
  For i := 0 To L.Count - 1 Do
  Begin
    V := L.Items[i];
    PCBServer.SendMessageToRobots(V.I_ObjectAddress, c_Broadcast, PCBM_BeginModify, c_NoEventData);
    V.IsTenting_Top := True;
    V.IsTenting_Bottom := True;
    PCBServer.SendMessageToRobots(V.I_ObjectAddress, c_Broadcast, PCBM_EndModify, c_NoEventData);
  End;
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  ShowMessage('Tented ' + IntToStr(L.Count) + ' vias.');
End;
