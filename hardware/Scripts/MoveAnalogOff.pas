{ Analog board only: moves every component except H1, H2 and H3 off the board, packed in rows to the right
  of the board outline (same side as before), sorted by designator. Generated by Claude. }
Procedure MoveAnalogOff;
Var
  Board : IPCB_Board;
  Iter  : IPCB_BoardIterator;
  C     : IPCB_Component;
  Names : TStringList;
  RC, BR : TCoordRect;
  i, n  : Integer;
  CX, CY, RowH, X0, XMax : TCoord;
  W, H  : TCoord;
  Gap   : TCoord;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  If Pos('\ANALOG\', UpperCase(Board.FileName)) = 0 Then
  Begin
    ShowMessage('Open the ANALOG PcbDoc first.');
    Exit;
  End;
  BR := Board.BoardOutline.BoundingRectangle;
  Names := TStringList.Create;
  Names.Sorted := True;
  Iter := Board.BoardIterator_Create;
  Iter.AddFilter_ObjectSet(MkSet(eComponentObject));
  Iter.AddFilter_LayerSet(AllLayers);
  Iter.AddFilter_Method(eProcessAll);
  C := Iter.FirstPCBObject;
  While C <> Nil Do
  Begin
    If (C.Name.Text <> 'H1') And (C.Name.Text <> 'H2') And (C.Name.Text <> 'H3') Then Names.Add(C.Name.Text);
    C := Iter.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(Iter);

  Gap := MMsToCoord(1.5);
  X0 := BR.Right + MMsToCoord(10);
  XMax := X0 + MMsToCoord(110);
  CX := X0;
  CY := BR.Top;
  RowH := 0;
  n := 0;
  PCBServer.PreProcess;
  For i := 0 To Names.Count - 1 Do
  Begin
    C := Nil;
    Iter := Board.BoardIterator_Create;
    Iter.AddFilter_ObjectSet(MkSet(eComponentObject));
    Iter.AddFilter_LayerSet(AllLayers);
    Iter.AddFilter_Method(eProcessAll);
    C := Iter.FirstPCBObject;
    While (C <> Nil) And (C.Name.Text <> Names.Strings[i]) Do C := Iter.NextPCBObject;
    Board.BoardIterator_Destroy(Iter);
    If C <> Nil Then
    Begin
      RC := C.BoundingRectangleNoNameComment;
      W := RC.Right - RC.Left;
      H := RC.Top - RC.Bottom;
      If (CX + W > XMax) And (CX > X0) Then
      Begin
        CX := X0;
        CY := CY - RowH - Gap;
        RowH := 0;
      End;
      PCBServer.SendMessageToRobots(C.I_ObjectAddress, c_Broadcast, PCBM_BeginModify, c_NoEventData);
      C.MoveByXY(CX - RC.Left, (CY - H) - RC.Bottom);
      PCBServer.SendMessageToRobots(C.I_ObjectAddress, c_Broadcast, PCBM_EndModify, c_NoEventData);
      CX := CX + W + Gap;
      If H > RowH Then RowH := H;
      n := n + 1;
    End;
  End;
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  ShowMessage('Moved ' + IntToStr(n) + ' parts off the board. Save if it looks right.');
  Names.Free;
End;
