{ Read-only: writes Scripts\silk_export.txt with designators (D), other overlay primitives
  (S tracks with ends+width, O other bboxes), pads (P bbox) and the board bbox (B), in mm from
  the board origin. Generated by Claude. }
Var Board : IPCB_Board;

Function F(C : TCoord; O : TCoord) : String;
Begin
  Result := FloatToStr(Round(CoordToMMs(C - O) * 1000) / 1000);
End;

Function Box(R : TCoordRect) : String;
Begin
  Result := F(R.Left, Board.XOrigin) + ';' + F(R.Bottom, Board.YOrigin) + ';' + F(R.Right, Board.XOrigin) + ';' + F(R.Top, Board.YOrigin);
End;

Function LName(L : TLayer) : String;
Begin
  If L = eTopOverlay Then Result := 'TO'
  Else If L = eBottomOverlay Then Result := 'BO'
  Else If L = eTopLayer Then Result := 'T'
  Else If L = eBottomLayer Then Result := 'B'
  Else If L = eMultiLayer Then Result := 'M'
  Else Result := 'X';
End;

Procedure ExportSilkA2;
Var
  It : IPCB_BoardIterator;
  O : IPCB_Primitive;
  C : IPCB_Component;
  T : IPCB_Track;
  S : TStringList;
  Own : String;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  S := TStringList.Create;
  S.Add('B;' + Box(Board.BoardOutline.BoundingRectangle));
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eComponentObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  C := It.FirstPCBObject;
  While C <> Nil Do
  Begin
    S.Add('C;' + C.Name.Text + ';' + LName(C.Layer) + ';' + Box(C.BoundingRectangleNoNameComment));
    If C.NameOn Then
      S.Add('D;' + C.Name.Text + ';' + LName(C.Name.Layer) + ';' + Box(C.Name.BoundingRectangle) + ';' +
        F(C.Name.Size, 0) + ';' + F(C.Name.Width, 0));
    C := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);

  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eTrackObject, eArcObject, eTextObject, eFillObject, eRegionObject));
  It.AddFilter_LayerSet(MkSet(eTopOverlay, eBottomOverlay));
  It.AddFilter_Method(eProcessAll);
  O := It.FirstPCBObject;
  While O <> Nil Do
  Begin
    If O.ObjectId = eTrackObject Then
    Begin
      T := O;
      S.Add('S;' + LName(O.Layer) + ';' + F(T.X1, Board.XOrigin) + ';' + F(T.Y1, Board.YOrigin) + ';' +
        F(T.X2, Board.XOrigin) + ';' + F(T.Y2, Board.YOrigin) + ';' + F(T.Width, 0));
    End
    Else If O.ObjectId = eTextObject Then
    Begin
      If (Not O.IsDesignator) And (Not O.IsComment) And (Not O.IsHidden) Then
        S.Add('O;' + LName(O.Layer) + ';' + Box(O.BoundingRectangle));
    End
    Else S.Add('O;' + LName(O.Layer) + ';' + Box(O.BoundingRectangle));
    O := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);

  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(ePadObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  O := It.FirstPCBObject;
  While O <> Nil Do
  Begin
    S.Add('P;' + LName(O.Layer) + ';' + Box(O.BoundingRectangle));
    O := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  S.SaveToFile('C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\silk_export.txt');
  ShowMessage('Exported ' + IntToStr(S.Count) + ' lines.');
End;
