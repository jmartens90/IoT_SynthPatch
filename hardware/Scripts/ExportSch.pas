{ Exports wires, junctions, power ports, net labels and pins of the active schematic sheet (in mils).
  Run with the schematic sheet active: File > Run Script > ExportSch.pas > ExportSch. Generated by Claude. }
Function Mil(C : Integer) : String;
Begin
  Result := IntToStr(Round(CoordToMils(C)));
End;

Procedure ExportSch;
Var
  Doc  : ISch_Document;
  Iter : ISch_Iterator;
  PIter : ISch_Iterator;
  O    : ISch_GraphicalObject;
  P    : ISch_Pin;
  L    : TStringList;
  S    : String;
  i    : Integer;
Begin
  Doc := SchServer.GetCurrentSchDocument;
  If Doc = Nil Then Exit;
  L := TStringList.Create;
  Iter := Doc.SchIterator_Create;
  Iter.AddFilter_ObjectSet(MkSet(eWire, eJunction, ePowerObject, eNetLabel, eSchComponent, ePort));
  O := Iter.FirstSchObject;
  While O <> Nil Do
  Begin
    If O.ObjectId = eWire Then
    Begin
      S := 'W';
      For i := 1 To O.VerticesCount Do
        S := S + ';' + Mil(O.Vertex[i].X) + ',' + Mil(O.Vertex[i].Y);
      L.Add(S);
    End
    Else If O.ObjectId = eJunction Then
      L.Add('J;' + Mil(O.Location.X) + ',' + Mil(O.Location.Y))
    Else If O.ObjectId = ePowerObject Then
      L.Add('G;' + O.Text + ';' + Mil(O.Location.X) + ',' + Mil(O.Location.Y))
    Else If O.ObjectId = eNetLabel Then
      L.Add('N;' + O.Text + ';' + Mil(O.Location.X) + ',' + Mil(O.Location.Y))
    Else If O.ObjectId = ePort Then
      L.Add('O;' + O.Name + ';' + Mil(O.Location.X) + ',' + Mil(O.Location.Y))
    Else If O.ObjectId = eSchComponent Then
    Begin
      PIter := O.SchIterator_Create;
      PIter.AddFilter_ObjectSet(MkSet(ePin));
      P := PIter.FirstSchObject;
      While P <> Nil Do
      Begin
        L.Add('P;' + O.Designator.Text + ';' + P.Designator + ';' + P.Name + ';' + Mil(P.Location.X) + ',' + Mil(P.Location.Y) + ';' +
              Mil(P.PinLength) + ';' + IntToStr(P.Orientation) + ';' + IntToStr(Ord(P.IsHidden)));
        P := PIter.NextSchObject;
      End;
      O.SchIterator_Destroy(PIter);
    End;
    O := Iter.NextSchObject;
  End;
  Doc.SchIterator_Destroy(Iter);
  L.SaveToFile('C:\Users\12502784\Documents\Altium_designs\IoT_SYNTHPATCH\Scripts\sch_export.txt');
  L.Free;
  ShowMessage('Export done');
End;
