{ Read-only: lists what is drawn directly on the Top/Bottom Solder (mask) layers and on Top/Bottom
  Paste, besides pads and vias. A big region or polygon there opens the mask over the whole board.
  Generated by Claude. }
Procedure CheckMask;
Var
  Board : IPCB_Board;
  It : IPCB_BoardIterator;
  O : IPCB_Primitive;
  R : TCoordRect;
  S : String;
  N : Integer;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  S := '';
  N := 0;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eTrackObject, eArcObject, eFillObject, eRegionObject, ePolyObject, eTextObject));
  It.AddFilter_LayerSet(MkSet(eTopSolder, eBottomSolder, eTopPaste, eBottomPaste));
  It.AddFilter_Method(eProcessAll);
  O := It.FirstPCBObject;
  While O <> Nil Do
  Begin
    N := N + 1;
    If N <= 15 Then
    Begin
      R := O.BoundingRectangle;
      S := S + Layer2String(O.Layer) + ' ' + O.ObjectIDString + ' ' +
        FloatToStr(Round(CoordToMMs(R.Right - R.Left))) + 'x' + FloatToStr(Round(CoordToMMs(R.Top - R.Bottom))) + ' mm' +
        ' comp=' + BoolToStr(O.InComponent, True) + #13#10;
    End;
    O := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  ShowMessage('Objects on mask/paste layers: ' + IntToStr(N) + #13#10 + S);
End;
