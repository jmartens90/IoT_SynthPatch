{ Exports the board outline vertices, all tracks/arcs on non-copper layers, and every component position (mm).
  Run with the PCB open: File > Run Script > ExportOutline.pas > ExportOutline. Generated by Claude. }
Function MM(C : TCoord) : String;
Begin
  Result := FloatToStr(CoordToMMs(C));
End;

Procedure ExportOutline;
Var
  Board : IPCB_Board;
  Iter  : IPCB_BoardIterator;
  O     : IPCB_Primitive;
  L     : TStringList;
  i     : Integer;
  X0, Y0 : TCoord;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  X0 := Board.XOrigin;
  Y0 := Board.YOrigin;
  L := TStringList.Create;
  L.Add('FILE;' + Board.FileName);
  For i := 0 To Board.BoardOutline.PointCount - 1 Do
    L.Add('B;' + IntToStr(i) + ';' + IntToStr(Board.BoardOutline.Segments[i].Kind) + ';' +
          MM(Board.BoardOutline.Segments[i].vx - X0) + ';' + MM(Board.BoardOutline.Segments[i].vy - Y0) + ';' +
          MM(Board.BoardOutline.Segments[i].cx - X0) + ';' + MM(Board.BoardOutline.Segments[i].cy - Y0) + ';' +
          MM(Board.BoardOutline.Segments[i].Radius));
  Iter := Board.BoardIterator_Create;
  Iter.AddFilter_ObjectSet(MkSet(eTrackObject, eArcObject, eComponentObject));
  Iter.AddFilter_LayerSet(AllLayers);
  Iter.AddFilter_Method(eProcessAll);
  O := Iter.FirstPCBObject;
  While O <> Nil Do
  Begin
    If (O.ObjectId = eTrackObject) And (O.Layer > 32) And (O.Component = Nil) Then
      L.Add('T;' + IntToStr(O.Layer) + ';' + MM(O.X1 - X0) + ';' + MM(O.Y1 - Y0) + ';' + MM(O.X2 - X0) + ';' + MM(O.Y2 - Y0) + ';' + MM(O.Width))
    Else If (O.ObjectId = eArcObject) And (O.Layer > 32) And (O.Component = Nil) Then
      L.Add('A;' + IntToStr(O.Layer) + ';' + MM(O.XCenter - X0) + ';' + MM(O.YCenter - Y0) + ';' + MM(O.Radius))
    Else If O.ObjectId = eComponentObject Then
      L.Add('C;' + O.Name.Text + ';' + O.Pattern + ';' + MM(O.X - X0) + ';' + MM(O.Y - Y0) + ';' + IntToStr(O.Layer) + ';' +
            MM(O.BoundingRectangleNoNameComment.Left - X0) + ';' + MM(O.BoundingRectangleNoNameComment.Right - X0));
    O := Iter.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(Iter);
  L.SaveToFile(ExtractFilePath(Board.FileName) + 'Scripts\outline_export.txt');
  L.Free;
  ShowMessage('Export done');
End;
