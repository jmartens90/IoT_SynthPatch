{ Moves the designators that break the Silk To Silk rule after Silkscreen Preparation by the
  smallest step (0.1 mm steps, 8 directions, up to 1.5 mm) that keeps 0.27 mm from all other
  silk and from pads on that side. Undo with Ctrl+Z. Generated by Claude. }
Var
  Board : IPCB_Board;
  Gap, PadGap, BL, BB, BRt, BT : TCoord;

Function Target(i : Integer) : String;
Begin
  Result := '';
  Case i Of
    0 : Result := 'C9';
    1 : Result := 'C17';
    2 : Result := 'DS2';
    3 : Result := 'IC7';
    4 : Result := 'R93';
  End;
End;

Function DirX(k : Integer) : Integer;
Begin
  Result := 0;
  Case k Of
    0 : Result := 1; 1 : Result := -1; 2 : Result := 0; 3 : Result := 0;
    4 : Result := 1; 5 : Result := -1; 6 : Result := 1; 7 : Result := -1;
  End;
End;

Function DirY(k : Integer) : Integer;
Begin
  Result := 0;
  Case k Of
    0 : Result := 0; 1 : Result := 0; 2 : Result := 1; 3 : Result := -1;
    4 : Result := 1; 5 : Result := 1; 6 : Result := -1; 7 : Result := -1;
  End;
End;

Function FindComp(Name : String) : IPCB_Component;
Var
  It : IPCB_BoardIterator;
  C : IPCB_Component;
Begin
  Result := Nil;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eComponentObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  C := It.FirstPCBObject;
  While C <> Nil Do
  Begin
    If UpperCase(C.Name.Text) = UpperCase(Name) Then Result := C;
    C := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
End;

Function Overlap(L, B, R, T : TCoord; O : IPCB_Primitive) : Boolean;
Var Q : TCoordRect; G : TCoord;
Begin
  Q := O.BoundingRectangle;
  If O.ObjectId = ePadObject Then G := PadGap Else G := Gap;
  Result := (L < Q.Right + G) And (Q.Left < R + G) And
            (B < Q.Top + G) And (Q.Bottom < T + G);
End;

Procedure Collect(T : IPCB_Text; L : TInterfaceList);
Var
  It : IPCB_SpatialIterator;
  O : IPCB_Primitive;
  R : TCoordRect;
  Side : TLayer;
  M : TCoord;
Begin
  If T.Layer = eTopOverlay Then Side := eTopLayer Else Side := eBottomLayer;
  R := T.BoundingRectangle;
  M := MMsToCoord(3);
  It := Board.SpatialIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eTrackObject, eArcObject, eTextObject, ePadObject));
  It.AddFilter_LayerSet(MkSet(T.Layer, Side, eMultiLayer));
  It.AddFilter_Area(R.Left - M, R.Bottom - M, R.Right + M, R.Top + M);
  O := It.FirstPCBObject;
  While O <> Nil Do
  Begin
    If Not (O.I_ObjectAddress = T.I_ObjectAddress) Then
    Begin
      If O.ObjectId = ePadObject Then L.Add(O)
      Else If O.Layer = T.Layer Then
      Begin
        If O.ObjectId = eTextObject Then
        Begin
          If Not O.IsHidden Then L.Add(O);
        End
        Else L.Add(O);
      End;
    End;
    O := It.NextPCBObject;
  End;
  Board.SpatialIterator_Destroy(It);
End;

Function Fits(R : TCoordRect; DX, DY : TCoord; L : TInterfaceList) : Boolean;
Var
  i : Integer;
  O : IPCB_Primitive;
  XL, XB, XR, XT : TCoord;
Begin
  XL := R.Left + DX; XR := R.Right + DX; XB := R.Bottom + DY; XT := R.Top + DY;
  Result := (XL > BL) And (XR < BRt) And (XB > BB) And (XT < BT);
  i := 0;
  While Result And (i < L.Count) Do
  Begin
    O := L.Items[i];
    If Overlap(XL, XB, XR, XT, O) Then Result := False;
    i := i + 1;
  End;
End;

Procedure NudgeDesignators2;
Var
  C : IPCB_Component;
  T : IPCB_Text;
  L : TInterfaceList;
  R, BR : TCoordRect;
  i, k, s : Integer;
  DX, DY : TCoord;
  Done : Boolean;
  Msg : String;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  Gap := MMsToCoord(0.26); PadGap := MMsToCoord(0.2);
  BR := Board.BoardOutline.BoundingRectangle;
  BL := BR.Left + MMsToCoord(0.6); BRt := BR.Right - MMsToCoord(0.6);
  BB := BR.Bottom + MMsToCoord(0.6); BT := BR.Top - MMsToCoord(0.6);
  Msg := '';
  PCBServer.PreProcess;
  For i := 0 To 4 Do
  Begin
    C := FindComp(Target(i));
    If C = Nil Then Msg := Msg + Target(i) + ' not found; '
    Else
    Begin
      T := C.Name;
      L := TInterfaceList.Create;
      Collect(T, L);
      R := T.BoundingRectangle;
      Done := False;
      For s := 0 To 50 Do
      Begin
        For k := 0 To 7 Do
        Begin
          If Not Done Then
          Begin
            DX := DirX(k) * MMsToCoord(0.05 * s);
            DY := DirY(k) * MMsToCoord(0.05 * s);
            If Fits(R, DX, DY, L) Then
            Begin
              Done := True;
              If (DX <> 0) Or (DY <> 0) Then
              Begin
                C.NameAutoPosition := eAutoPos_Manual;
                PCBServer.SendMessageToRobots(T.I_ObjectAddress, c_Broadcast, PCBM_BeginModify, c_NoEventData);
                T.MoveByXY(DX, DY);
                PCBServer.SendMessageToRobots(T.I_ObjectAddress, c_Broadcast, PCBM_EndModify, c_NoEventData);
              End;
              Msg := Msg + Target(i) + ' ' + FloatToStr(CoordToMMs(DX)) + '/' + FloatToStr(CoordToMMs(DY)) + '; ';
            End;
          End;
        End;
      End;
      If Not Done Then Msg := Msg + Target(i) + ' no spot; ';
    End;
  End;
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  ShowMessage('Designators: ' + Msg);
End;
