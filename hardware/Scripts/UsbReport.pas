{ CleanUsbVias.pas - run on the main PcbDoc after J1 has the HRO footprint.
  Removes vias that collide with J1's shell legs or locating pegs (hole/copper clash) and logs
  any track that passes closer than 0.2 mm to a peg or leg so it can be rerouted. Generated by Claude. }
Var Board : IPCB_Board; Log : TStringList;

Procedure UsbReport;
Var
  It : IPCB_BoardIterator; GIt : IPCB_GroupIterator;
  C, J1 : IPCB_Component; P : IPCB_Pad; V : IPCB_Via; T : IPCB_Track;
  Pads, Kill : TInterfaceList; i, k : Integer; R, Dd : Double;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  Log := TStringList.Create;
  J1 := Nil;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eComponentObject)); It.AddFilter_LayerSet(AllLayers); It.AddFilter_Method(eProcessAll);
  C := It.FirstPCBObject;
  While C <> Nil Do Begin If C.Name.Text = 'J1' Then J1 := C; C := It.NextPCBObject; End;
  Board.BoardIterator_Destroy(It);
  If J1 = Nil Then Exit;
  Log.Add('J1 footprint: ' + J1.Pattern);
  Pads := TInterfaceList.Create; Kill := TInterfaceList.Create;
  GIt := J1.GroupIterator_Create; GIt.AddFilter_ObjectSet(MkSet(ePadObject));
  P := GIt.FirstPCBObject;
  While P <> Nil Do Begin If P.HoleSize > 0 Then Pads.Add(P); P := GIt.NextPCBObject; End;
  J1.GroupIterator_Destroy(GIt);
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eViaObject)); It.AddFilter_LayerSet(AllLayers); It.AddFilter_Method(eProcessAll);
  V := It.FirstPCBObject;
  While V <> Nil Do
  Begin
    For i := 0 To Pads.Count - 1 Do
    Begin
      P := Pads.Items[i];
      R := CoordToMMs(Max(P.TopXSize, P.TopYSize)) / 2 + CoordToMMs(V.Size) / 2 + 0.25;
      Dd := Sqrt(Sqr(CoordToMMs(V.X - P.X)) + Sqr(CoordToMMs(V.Y - P.Y)));
      If Dd < R Then
      Begin
        If Kill.IndexOf(V) < 0 Then Kill.Add(V);
      End;
    End;
    V := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  For k := 0 To Kill.Count - 1 Do
  Begin
    V := Kill.Items[k];
    If V.Net <> Nil Then Log.Add('V;' + V.Net.Name + ';' + FloatToStr(CoordToMMs(V.X - J1.X)) + ';' + FloatToStr(CoordToMMs(V.Y - J1.Y)))
    Else Log.Add('V;-;' + FloatToStr(CoordToMMs(V.X - J1.X)) + ';' + FloatToStr(CoordToMMs(V.Y - J1.Y)));
  End;
  GIt := J1.GroupIterator_Create; GIt.AddFilter_ObjectSet(MkSet(ePadObject));
  P := GIt.FirstPCBObject;
  While P <> Nil Do
  Begin
    If P.Net <> Nil Then R := 1 Else R := 0;
    Log.Add('P;' + P.Name + ';' + FloatToStr(CoordToMMs(P.X - J1.X)) + ';' + FloatToStr(CoordToMMs(P.Y - J1.Y)) + ';' + FloatToStr(CoordToMMs(P.HoleSize)) + ';' + FloatToStr(CoordToMMs(P.TopXSize)) + ';' + FloatToStr(CoordToMMs(P.TopYSize)) + ';' + IntToStr(P.Layer) + ';' + FloatToStr(R));
    P := GIt.NextPCBObject;
  End;
  J1.GroupIterator_Destroy(GIt);
  Log.Add('J1;' + FloatToStr(CoordToMMs(J1.X)) + ';' + FloatToStr(CoordToMMs(J1.Y)) + ';' + FloatToStr(J1.Rotation) + ';' + IntToStr(J1.Layer));
  Log.SaveToFile('C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\usbreport.txt');
End;
