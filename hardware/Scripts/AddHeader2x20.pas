{ Adds the 2x20 board-to-board header footprints (2.54 mm, pins in rows along X, centred, pad 1 square):
  HDR_2x20_P2.54   - pin header on top of the analog board
  HDR_2x20_P2.54_S - 8.5 mm socket on the bottom of the main board. Its odd/even rows are swapped, because a part
                     on the bottom side is mirrored; this way pin n of the socket sits right on pin n of the header.
  Open IoT_SYNTHPATCH.PcbLib, then File > Run Script > AddHeader2x20.pas > AddHeader2x20. Generated by Claude. }
Procedure AddPad(Lib : IPCB_Library; Comp : IPCB_LibComponent; Name : String; X, Y : Double; Square : Boolean);
Var
  P : IPCB_Pad;
Begin
  P := PCBServer.PCBObjectFactory(ePadObject, eNoDimension, eCreate_Default);
  P.X        := Lib.Board.XOrigin + MMsToCoord(X);
  P.Y        := Lib.Board.YOrigin + MMsToCoord(Y);
  P.Layer    := eMultiLayer;
  P.TopXSize := MMsToCoord(1.7);
  P.TopYSize := MMsToCoord(1.7);
  P.MidXSize := MMsToCoord(1.7);
  P.MidYSize := MMsToCoord(1.7);
  P.BotXSize := MMsToCoord(1.7);
  P.BotYSize := MMsToCoord(1.7);
  P.HoleSize := MMsToCoord(1.0);
  If Square Then P.TopShape := eRectangular Else P.TopShape := eRounded;
  If Square Then P.BotShape := eRectangular Else P.BotShape := eRounded;
  P.MidShape := eRounded;
  P.Name     := Name;
  Comp.AddPCBObject(P);
  PCBServer.SendMessageToRobots(Comp.I_ObjectAddress, c_Broadcast, PCBM_BoardRegisteration, P.I_ObjectAddress);
End;

Procedure AddLine(Lib : IPCB_Library; Comp : IPCB_LibComponent; Layer : TLayer; X1, Y1, X2, Y2, W : Double);
Var
  T : IPCB_Track;
Begin
  T := PCBServer.PCBObjectFactory(eTrackObject, eNoDimension, eCreate_Default);
  T.X1 := Lib.Board.XOrigin + MMsToCoord(X1);
  T.Y1 := Lib.Board.YOrigin + MMsToCoord(Y1);
  T.X2 := Lib.Board.XOrigin + MMsToCoord(X2);
  T.Y2 := Lib.Board.YOrigin + MMsToCoord(Y2);
  T.Layer := Layer;
  T.Width := MMsToCoord(W);
  Comp.AddPCBObject(T);
  PCBServer.SendMessageToRobots(Comp.I_ObjectAddress, c_Broadcast, PCBM_BoardRegisteration, T.I_ObjectAddress);
End;

Procedure AddRect(Lib : IPCB_Library; Comp : IPCB_LibComponent; Layer : TLayer; HX, HY, W : Double);
Begin
  AddLine(Lib, Comp, Layer, -HX, -HY,  HX, -HY, W);
  AddLine(Lib, Comp, Layer,  HX, -HY,  HX,  HY, W);
  AddLine(Lib, Comp, Layer,  HX,  HY, -HX,  HY, W);
  AddLine(Lib, Comp, Layer, -HX,  HY, -HX, -HY, W);
End;

Procedure Add2x20(Lib : IPCB_Library; Name, Descr : String; Swap : Boolean);
Var
  Comp : IPCB_LibComponent;
  n, r, c : Integer;
  X0, Y : Double;
Begin
  Comp := PCBServer.CreatePCBLibComp;
  Comp.Name := Name;
  Comp.Description := Descr;
  Comp.Height := MMsToCoord(8.5);
  Lib.RegisterComponent(Comp);
  PCBServer.PreProcess;
  X0 := -19 * 2.54 / 2;
  For n := 1 To 40 Do
  Begin
    r := (n - 1) Div 2;
    c := (n - 1) Mod 2;
    If (c = 0) <> Swap Then Y := 1.27 Else Y := -1.27;
    AddPad(Lib, Comp, IntToStr(n), X0 + r * 2.54, Y, n = 1);
  End;
  AddRect(Lib, Comp, eTopOverlay, 25.4, 2.54, 0.15);
  AddLine(Lib, Comp, eTopOverlay, X0 - 1.27 - 0.6, -2.8, X0 - 1.27 - 0.6, 2.8, 0.15);
  AddRect(Lib, Comp, eMechanical15, 25.65, 2.79, 0.05);
  PCBServer.PostProcess;
  Lib.CurrentComponent := Comp;
End;

Procedure AddHeader2x20;
Var
  Lib : IPCB_Library;
Begin
  Lib := PCBServer.GetCurrentPCBLibrary;
  If Lib = Nil Then
  Begin
    ShowMessage('Open IoT_SYNTHPATCH.PcbLib first.');
    Exit;
  End;
  Add2x20(Lib, 'HDR_2x20_P2.54', 'Pin header 2x20, 2.54 mm (analog board, top)', False);
  Add2x20(Lib, 'HDR_2x20_P2.54_S', 'Socket 2x20, 2.54 mm, 8.5 mm (main board, bottom; rows swapped)', True);
  Lib.Board.ViewManager_FullUpdate;
  ShowMessage('Added HDR_2x20_P2.54 and HDR_2x20_P2.54_S. Save the library.');
End;
