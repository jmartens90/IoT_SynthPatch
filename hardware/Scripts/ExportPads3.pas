{ Exports components, pads and vias (with nets) in mm from the bottom-left corner of the board outline.
  Writes Scripts\pads2_main.txt or pads2_analog.txt. Read-only. Generated by Claude. }
Function MM(C : TCoord) : String;
Begin
  Result := FloatToStrF(CoordToMMs(C), ffFixed, 8, 3);
End;

Procedure ExportPads3;
Var
  Board : IPCB_Board;
  Iter  : IPCB_BoardIterator;
  P     : IPCB_Pad;
  C     : IPCB_Component;
  L     : TStringList;
  RC    : TCoordRect;
  X0, Y0 : TCoord;
  N, FN : String;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  RC := Board.BoardOutline.BoundingRectangle;
  X0 := RC.Left;
  Y0 := RC.Bottom;
  L := TStringList.Create;
  L.Add('B;' + MM(RC.Right - RC.Left) + ';' + MM(RC.Top - RC.Bottom) + ';' + MM(X0) + ';' + MM(Y0));
  Iter := Board.BoardIterator_Create;
  Iter.AddFilter_ObjectSet(MkSet(eComponentObject));
  Iter.AddFilter_LayerSet(AllLayers);
  Iter.AddFilter_Method(eProcessAll);
  C := Iter.FirstPCBObject;
  While C <> Nil Do
  Begin
    RC := C.BoundingRectangleNoNameComment;
    L.Add('C;' + C.Name.Text + ';' + MM(C.X - X0) + ';' + MM(C.Y - Y0) + ';' + IntToStr(C.Layer) + ';' +
          FloatToStr(C.Rotation) + ';' + C.Pattern + ';' + MM(RC.Left - X0) + ';' + MM(RC.Bottom - Y0) + ';' +
          MM(RC.Right - X0) + ';' + MM(RC.Top - Y0));
    C := Iter.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(Iter);
  Iter := Board.BoardIterator_Create;
  Iter.AddFilter_ObjectSet(MkSet(ePadObject));
  Iter.AddFilter_LayerSet(AllLayers);
  Iter.AddFilter_Method(eProcessAll);
  P := Iter.FirstPCBObject;
  While P <> Nil Do
  Begin
    If P.Net = Nil Then N := '' Else N := P.Net.Name;
    If P.Component <> Nil Then
      L.Add('P;' + P.Component.Name.Text + ';' + P.Name + ';' + N + ';' + MM(P.X - X0) + ';' + MM(P.Y - Y0) + ';' + IntToStr(P.Layer));
    P := Iter.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(Iter);
  Iter := Board.BoardIterator_Create;
  Iter.AddFilter_ObjectSet(MkSet(eViaObject));
  Iter.AddFilter_LayerSet(AllLayers);
  Iter.AddFilter_Method(eProcessAll);
  P := Iter.FirstPCBObject;
  While P <> Nil Do
  Begin
    If P.Net = Nil Then N := '' Else N := P.Net.Name;
    L.Add('V;' + N + ';' + MM(P.X - X0) + ';' + MM(P.Y - Y0));
    P := Iter.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(Iter);
  If Pos('\ANALOG\', UpperCase(Board.FileName)) > 0 Then FN := 'pads2_analog.txt' Else FN := 'pads2_main.txt';
  L.SaveToFile('C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\' + FN);
  L.Free;
  ShowMessage('Wrote Scripts\' + FN);
End;
