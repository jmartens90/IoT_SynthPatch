{ Changes H4 pin 20 from +5 to GND on the active CONNECTORS sheet (the analog board doesn't use +5, so the
  net had one pin there). Run on both CONNECTORS sheets. Generated by Claude. }
Procedure FixH4Pin20;
Var
  Doc  : ISch_Document;
  Iter : ISch_Iterator;
  PW   : ISch_PowerObject;
  n    : Integer;
Begin
  Doc := SchServer.GetCurrentSchDocument;
  If Doc = Nil Then Exit;
  n := 0;
  SchServer.ProcessControl.PreProcess(Doc, '');
  Iter := Doc.SchIterator_Create;
  Iter.AddFilter_ObjectSet(MkSet(ePowerObject));
  PW := Iter.FirstSchObject;
  While PW <> Nil Do
  Begin
    If (PW.Text = '+5') And (PW.Location.X = MilsToCoord(2000)) And (PW.Location.Y = MilsToCoord(2800)) Then
    Begin
      SchServer.RobotManager.SendMessage(PW.I_ObjectAddress, c_BroadCast, SCHM_BeginModify, c_NoEventData);
      PW.Text := 'GND';
      PW.Style := ePowerGndPower;
      PW.Orientation := eRotate0;
      SchServer.RobotManager.SendMessage(PW.I_ObjectAddress, c_BroadCast, SCHM_EndModify, c_NoEventData);
      n := n + 1;
    End;
    PW := Iter.NextSchObject;
  End;
  Doc.SchIterator_Destroy(Iter);
  SchServer.ProcessControl.PostProcess(Doc, '');
  Doc.GraphicallyInvalidate;
  ShowMessage('Changed ' + IntToStr(n) + ' power port(s). Save the sheet.');
End;
