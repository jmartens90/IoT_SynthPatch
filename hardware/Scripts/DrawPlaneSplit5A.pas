{ Adds a +5A island to the PWR plane (Internal Plane 1): x 42-57, y 64-76 mm from the board corner,
  closed at the top by the existing +3.3/+5 split line at y 76. Covers IC4, R19, C29.
  Generated by Claude. }
Const
  X0 = 5.0;
  Y0 = 10.0;
  W = 0.5;

Var
  Board : IPCB_Board;

Procedure Seg(XA, YA, XB, YB : Double);
Var
  T : IPCB_Track;
Begin
  T := PCBServer.PCBObjectFactory(eTrackObject, eNoDimension, eCreate_Default);
  T.X1 := MMsToCoord(XA + X0);
  T.Y1 := MMsToCoord(YA + Y0);
  T.X2 := MMsToCoord(XB + X0);
  T.Y2 := MMsToCoord(YB + Y0);
  T.Width := MMsToCoord(W);
  T.Layer := eInternalPlane1;
  Board.AddPCBObject(T);
End;

Procedure DrawPlaneSplit5A;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  PCBServer.PreProcess;
  Seg(42, 76, 42, 64);
  Seg(42, 64, 57, 64);
  Seg(57, 64, 57, 76);
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  ShowMessage('Placed the +5A island lines.');
End;
