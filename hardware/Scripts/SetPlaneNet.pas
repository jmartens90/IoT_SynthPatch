{ Assigns net GND to the internal plane named GND2 and reports every plane's net.
  Run with the PcbDoc active. Generated by Claude. }
Procedure SetPlaneNet;
Var
  Board : IPCB_Board;
  LS : IPCB_LayerStack;
  LO : IPCB_LayerObject;
  S : String;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  LS := Board.LayerStack;
  S := '';
  LO := LS.FirstLayer;
  While LO <> Nil Do
  Begin
    If (LO.LayerID >= eInternalPlane1) And (LO.LayerID <= eInternalPlane16) Then
    Begin
      If LO.Name = 'GND2' Then LO.NetName := 'GND';
      S := S + LO.Name + ' = ' + LO.NetName + #13#10;
    End;
    LO := LS.NextLayer(LO);
  End;
  Board.ViewManager_FullUpdate;
  ShowMessage(S);
End;
