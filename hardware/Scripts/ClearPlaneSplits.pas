{ Deletes every track and arc on Internal Plane 1 (the PWR plane split lines), so the layer can be
  turned into a signal layer without the split lines becoming copper. Reports the plane nets.
  Run with the PcbDoc active. Generated by Claude. }
Procedure ClearPlaneSplits;
Var
  Board : IPCB_Board;
  It : IPCB_BoardIterator;
  O : IPCB_Primitive;
  L : TInterfaceList;
  i, Other : Integer;
  LO : IPCB_LayerObject;
  S : String;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  L := TInterfaceList.Create;
  Other := 0;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(AllObjects);
  It.AddFilter_LayerSet(MkSet(eInternalPlane1));
  It.AddFilter_Method(eProcessAll);
  O := It.FirstPCBObject;
  While O <> Nil Do
  Begin
    If O.Layer = eInternalPlane1 Then
    Begin
      If (O.ObjectId = eTrackObject) Or (O.ObjectId = eArcObject) Then L.Add(O)
      Else Other := Other + 1;
    End;
    O := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  PCBServer.PreProcess;
  For i := 0 To L.Count - 1 Do
  Begin
    O := L.Items[i];
    Board.RemovePCBObject(O);
  End;
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  S := '';
  For i := eInternalPlane1 To eInternalPlane4 Do
  Begin
    LO := Board.LayerStack.LayerObject(i);
    If LO <> Nil Then S := S + LO.Name + ' = ' + LO.NetName + ' / ';
  End;
  ShowMessage('Removed ' + IntToStr(L.Count) + ' split lines from Internal Plane 1. Other objects on it: ' + IntToStr(Other) + '. Planes: ' + S);
End;
