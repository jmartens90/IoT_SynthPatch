{ Places 5 GND vias (0.6/0.3) in the centre and corner pads of the 3x3 ground pad of the ESP32-S3 module (IC2), so the
  pads join each other and the GND planes. mm from the board outline's bottom-left corner. Generated by Claude. }
Var
  Board : IPCB_Board;
  NG : IPCB_Net;
  X0, Y0 : TCoord;

Procedure AddVia(X, Y : Double);
Var
  V : IPCB_Via;
Begin
  V := PCBServer.PCBObjectFactory(eViaObject, eNoDimension, eCreate_Default);
  V.X := X0 + MMsToCoord(X);
  V.Y := Y0 + MMsToCoord(Y);
  V.Size := MMsToCoord(0.6);
  V.HoleSize := MMsToCoord(0.3);
  V.LowLayer := eBottomLayer;
  V.HighLayer := eTopLayer;
  Board.AddPCBObject(V);
  NG.AddPCBObject(V);
End;

Procedure EspGndVias2;
Var
  It : IPCB_BoardIterator;
  N : IPCB_Net;
  RC : TCoordRect;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  RC := Board.BoardOutline.BoundingRectangle;
  X0 := RC.Left;
  Y0 := RC.Bottom;
  NG := Nil;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eNetObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  N := It.FirstPCBObject;
  While N <> Nil Do
  Begin
    If UpperCase(N.Name) = 'GND' Then NG := N;
    N := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  If NG = Nil Then Exit;
  PCBServer.PreProcess;
  AddVia(25.639, 92.966);
  AddVia(24.239, 91.566);
  AddVia(27.039, 91.566);
  AddVia(24.239, 94.366);
  AddVia(27.039, 94.366);
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  ShowMessage('Placed 5 GND vias in the ESP32 ground pad.');
End;

