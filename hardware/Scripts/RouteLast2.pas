{ Adds the GND via for R107-2 (last open connection) on the main board:
  - GND Q15-2 -> new GND via 0.9 mm below it (0.3 mm Bottom track).
  - GND IC10-10 -> existing GND via at (40.687, 70.028) (0.3 mm Bottom track).
  - Rebuilds the track pairs at the 4 zero-length gaps (IO37 x2, IO40, +5A) as fresh copies with their
    net, so Altium recomputes their connectivity.
  mm from the board outline's bottom-left corner. Generated by Claude. }
Var
  Board : IPCB_Board;
  X0, Y0 : TCoord;

Function FindNet(S : String) : IPCB_Net;
Var
  It : IPCB_BoardIterator;
  N : IPCB_Net;
Begin
  Result := Nil;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eNetObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  N := It.FirstPCBObject;
  While N <> Nil Do
  Begin
    If UpperCase(N.Name) = UpperCase(S) Then Result := N;
    N := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
End;

Procedure AddTrack(N : IPCB_Net; XA, YA, XB, YB, W : Double);
Var
  T : IPCB_Track;
Begin
  T := PCBServer.PCBObjectFactory(eTrackObject, eNoDimension, eCreate_Default);
  T.X1 := X0 + MMsToCoord(XA);
  T.Y1 := Y0 + MMsToCoord(YA);
  T.X2 := X0 + MMsToCoord(XB);
  T.Y2 := Y0 + MMsToCoord(YB);
  T.Width := MMsToCoord(W);
  T.Layer := eBottomLayer;
  Board.AddPCBObject(T);
  N.AddPCBObject(T);
End;

Procedure AddVia(N : IPCB_Net; X, Y : Double);
Var
  V : IPCB_Via;
Begin
  V := PCBServer.PCBObjectFactory(eViaObject, eNoDimension, eCreate_Default);
  V.X := X0 + MMsToCoord(X);
  V.Y := Y0 + MMsToCoord(Y);
  V.Size := MMsToCoord(0.6);
  V.HoleSize := MMsToCoord(0.3);
  V.LowLayer := eBottomLayer;
  V.HighLayer := eTopLayer;
  Board.AddPCBObject(V);
  N.AddPCBObject(V);
End;

Function AtPoint(T : IPCB_Track; X, Y : Double) : Boolean;
Var
  PX, PY, D : TCoord;
Begin
  PX := X0 + MMsToCoord(X);
  PY := Y0 + MMsToCoord(Y);
  D := MMsToCoord(0.01);
  Result := ((Abs(T.X1 - PX) < D) And (Abs(T.Y1 - PY) < D)) Or ((Abs(T.X2 - PX) < D) And (Abs(T.Y2 - PY) < D));
End;

Function Rebuild(NetName : String; X, Y : Double) : Integer;
Var
  It : IPCB_BoardIterator;
  T, C : IPCB_Track;
  L : TInterfaceList;
  N : IPCB_Net;
  i : Integer;
Begin
  Result := 0;
  N := FindNet(NetName);
  If N = Nil Then Exit;
  L := TInterfaceList.Create;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eTrackObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  T := It.FirstPCBObject;
  While T <> Nil Do
  Begin
    If (T.Net <> Nil) And (Not T.InPolygon) And (Not T.InComponent) Then
      If (UpperCase(T.Net.Name) = UpperCase(NetName)) And AtPoint(T, X, Y) Then L.Add(T);
    T := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  For i := 0 To L.Count - 1 Do
  Begin
    T := L.Items[i];
    C := PCBServer.PCBObjectFactory(eTrackObject, eNoDimension, eCreate_Default);
    C.X1 := T.X1;
    C.Y1 := T.Y1;
    C.X2 := T.X2;
    C.Y2 := T.Y2;
    C.Width := T.Width;
    C.Layer := T.Layer;
    Board.RemovePCBObject(T);
    Board.AddPCBObject(C);
    N.AddPCBObject(C);
  End;
  Result := L.Count;
End;

Procedure RouteLast2;
Var
  RC : TCoordRect;
  G : IPCB_Net;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  RC := Board.BoardOutline.BoundingRectangle;
  X0 := RC.Left;
  Y0 := RC.Bottom;
  G := FindNet('GND');
  If G = Nil Then Exit;
  PCBServer.PreProcess;
  AddVia(G, 92.31, 37.69);
  AddTrack(G, 91.008, 37.692, 92.31, 37.69, 0.3);
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  ShowMessage('Placed GND via and track at R107-2.');
End;
