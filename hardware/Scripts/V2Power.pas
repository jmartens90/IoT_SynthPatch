{ V2Power.pas - Generated by Claude for the V2 power changes.
  FixPowerSch : run with POWER.SchDoc active
  FixConnSch  : run with POWER_CONNECTOR.SchDoc active
  Log: Scripts\v2power_log.txt (appended) }

Var Log : TStringList; Doc : ISch_Document; GndStyle, RailStyle : Integer;
Const LogPath = 'C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\v2power_log.txt';
      LibPath = 'C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\IoT_SYNTHPATCH.SchLib';

Procedure OpenLog;
Begin
  Log := TStringList.Create;
  If FileExists(LogPath) Then Log.LoadFromFile(LogPath);
End;

Function M(V) : Integer;
Begin
  Result := MilsToCoord(V);
End;

Function FindComp(Des) : ISch_Component;
Var It, C;
Begin
  Result := Nil;
  It := Doc.SchIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eSchComponent));
  C := It.FirstSchObject;
  While C <> Nil Do
  Begin
    If C.Designator.Text = Des Then Result := C;
    C := It.NextSchObject;
  End;
  Doc.SchIterator_Destroy(It);
End;

Function FindAt(LibRef, X, Y) : ISch_Component;
Var It, C;
Begin
  Result := Nil;
  It := Doc.SchIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eSchComponent));
  C := It.FirstSchObject;
  While C <> Nil Do
  Begin
    If (C.LibReference = LibRef) And (Abs(C.Location.X - M(X)) < M(1)) And (Abs(C.Location.Y - M(Y)) < M(1)) Then Result := C;
    C := It.NextSchObject;
  End;
  Doc.SchIterator_Destroy(It);
End;

Procedure GetStyles;
Var It, P;
Begin
  GndStyle := -1; RailStyle := -1;
  It := Doc.SchIterator_Create;
  It.AddFilter_ObjectSet(MkSet(ePowerObject));
  P := It.FirstSchObject;
  While P <> Nil Do
  Begin
    If (P.Text = 'GND') And (GndStyle < 0) Then GndStyle := P.Style;
    If (P.Text <> 'GND') And (RailStyle < 0) Then RailStyle := P.Style;
    P := It.NextSchObject;
  End;
  Doc.SchIterator_Destroy(It);
  Log.Add('styles gnd=' + IntToStr(GndStyle) + ' rail=' + IntToStr(RailStyle));
End;

Procedure AddPower(Txt, X, Y, Ori);
Var P;
Begin
  P := SchServer.SchObjectFactory(ePowerObject, eCreate_Default);
  If P = Nil Then Begin Log.Add('power factory failed'); Exit; End;
  P.Location := Point(M(X), M(Y));
  P.Text := Txt;
  If Txt = 'GND' Then Begin If GndStyle >= 0 Then P.Style := GndStyle; End
  Else Begin If RailStyle >= 0 Then P.Style := RailStyle; End;
  P.Orientation := Ori;
  P.ShowNetName := True;
  Doc.RegisterSchObjectInContainer(P);
  SchServer.RobotManager.SendMessage(Doc.I_ObjectAddress, c_BroadCast, SCHM_PrimitiveRegistration, P.I_ObjectAddress);
  Log.Add('power ' + Txt + ' at ' + IntToStr(X) + ',' + IntToStr(Y));
End;

Procedure AddWire(X1, Y1, X2, Y2, X3, Y3, N);
Var W;
Begin
  W := SchServer.SchObjectFactory(eWire, eCreate_Default);
  If W = Nil Then Begin Log.Add('wire factory failed'); Exit; End;
  W.Location := Point(M(X1), M(Y1));
  W.InsertVertex := 1;
  W.SetState_Vertex(1, Point(M(X1), M(Y1)));
  W.InsertVertex := 2;
  W.SetState_Vertex(2, Point(M(X2), M(Y2)));
  If N >= 3 Then
  Begin
    W.InsertVertex := 3;
    W.SetState_Vertex(3, Point(M(X3), M(Y3)));
  End;
  W.LineWidth := eSmall;
  Doc.RegisterSchObjectInContainer(W);
  SchServer.RobotManager.SendMessage(Doc.I_ObjectAddress, c_BroadCast, SCHM_PrimitiveRegistration, W.I_ObjectAddress);
  Log.Add('wire ' + IntToStr(X1) + ',' + IntToStr(Y1) + ' -> ' + IntToStr(X2) + ',' + IntToStr(Y2));
End;

Procedure SetParams(C, Des, Cmt, Fp, Mpn);
Var It, P;
Begin
  C.Designator.Text := Des;
  C.Comment.Text := Cmt;
  It := C.SchIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eParameter, eImplementation));
  P := It.FirstSchObject;
  While P <> Nil Do
  Begin
    If P.ObjectId = eParameter Then
    Begin
      If (P.Name = 'Value') Then P.Text := Cmt
      Else If (Mpn <> '') And ((Pos('Part', P.Name) > 0) Or (Pos('Manufacturer', P.Name) > 0) Or (Pos('Mouser', P.Name) > 0)) Then
      Begin
        Log.Add('  param ' + P.Name + ' was ' + P.Text);
        If Pos('Manufacturer', P.Name) > 0 Then P.Text := '' Else P.Text := Mpn;
      End;
    End
    Else
    Begin
      If (Fp <> '') And (P.ModelType = 'PCBLIB') Then
      Begin
        Log.Add('  footprint was ' + P.ModelName + ' -> ' + Fp);
        P.ModelName := Fp;
      End
      Else If P.ModelType = 'PCBLIB' Then Log.Add('  footprint ' + P.ModelName);
    End;
    P := It.NextSchObject;
  End;
  C.SchIterator_Destroy(It);
  C.GraphicallyInvalidate;
End;

Procedure PlaceNew(LibRef, X, Y, Ori, Des, Cmt, Fp, Mpn);
Var C;
Begin
  If FindComp(Des) <> Nil Then Begin Log.Add(Des + ' already exists, skipped'); Exit; End;
  IntegratedLibraryManager.PlaceLibraryComponent(LibRef, LibPath,
    'Orientation=' + IntToStr(Ori) + '|Location.X=' + IntToStr(M(X)) + '|Location.Y=' + IntToStr(M(Y)));
  C := FindAt(LibRef, X, Y);
  If C = Nil Then Begin Log.Add('PLACE FAILED ' + Des + ' (' + LibRef + ')'); Exit; End;
  Log.Add('placed ' + Des + ' ' + LibRef + ' ori ' + IntToStr(C.Orientation));
  SetParams(C, Des, Cmt, Fp, Mpn);
End;

Procedure SetPowerText(X, Y, OldT, NewT);
Var It, P;
Begin
  It := Doc.SchIterator_Create;
  It.AddFilter_ObjectSet(MkSet(ePowerObject));
  P := It.FirstSchObject;
  While P <> Nil Do
  Begin
    If (P.Text = OldT) And (Abs(P.Location.X - M(X)) < M(1)) And (Abs(P.Location.Y - M(Y)) < M(1)) Then
    Begin
      P.Text := NewT; P.GraphicallyInvalidate;
      Log.Add('port ' + OldT + ' at ' + IntToStr(X) + ',' + IntToStr(Y) + ' -> ' + NewT);
    End;
    P := It.NextSchObject;
  End;
  Doc.SchIterator_Destroy(It);
End;

Procedure MoveRes(Des, X, Y);
Var C;
Begin
  C := FindComp(Des);
  If C = Nil Then Begin Log.Add(Des + ' not found'); Exit; End;
  C.MoveToXY(M(X), M(Y));
  SetParams(C, Des, '1K', '', '');
  Log.Add(Des + ' moved to ' + IntToStr(X) + ',' + IntToStr(Y) + ' now 1K (LED resistor)');
End;

Procedure FixPowerSch;
Begin
  OpenLog;
  Doc := SchServer.GetCurrentSchDocument;
  If Doc = Nil Then Begin Log.Add('no sch'); Log.SaveToFile(LogPath); Exit; End;
  Log.Add('=== FixPowerSch ' + Doc.DocumentName);
  If FindComp('DS20') <> Nil Then Begin Log.Add('already done'); Log.SaveToFile(LogPath); Exit; End;
  GetStyles;
  { new parts first (PlaceLibraryComponent handles its own undo) }
  PlaceNew('LED-Y', 10000, 4800, 3, 'DS20', 'LED +3.3V', '', '');
  PlaceNew('SCHOTTKY', 9300, 4600, 2, 'D16', 'SMAJ3.3A', 'FP-SMA-MFG', 'SMAJ3.3A');
  PlaceNew('Testpoint', 9800, 6350, 0, 'tp9', 'GND', '', '');
  PlaceNew('Pinheader_1x2', 10500, 1600, 1, 'J32', '+5V OUT jumper', '', '');
  PlaceNew('LED-Y', 9300, 2100, 3, 'DS21', 'LED +5V', '', '');
  PlaceNew('SCHOTTKY', 8900, 1500, 2, 'D17', 'SMAJ5.0A', 'FP-SMA-MFG', 'SMAJ5.0A');
  PlaceNew('Testpoint', 9300, 3100, 0, 'tp10', 'GND', '', '');

  SchServer.ProcessControl.PreProcess(Doc, '');
  { R4 / R16 out of the feedback path: fixed wire, resistors reused for the LEDs }
  AddWire(9600, 6100, 10300, 6100, 0, 0, 2);
  AddWire(9100, 2800, 9800, 2800, 0, 0, 2);
  MoveRes('R4', 9700, 5000);
  MoveRes('R16', 9000, 2300);
  { +3.3 LED + TVS + GND test point }
  AddPower('+3.3', 9000, 5000, 1);
  AddWire(9700, 5000, 9900, 5000, 0, 0, 2);
  AddPower('GND', 9900, 4500, 3);
  AddPower('+3.3', 8700, 4600, 1);
  AddPower('GND', 9300, 4600, 3);
  AddPower('GND', 9800, 6350, 3);
  { +5: buck side becomes +5_BUCK, jumper J32 to the +5 rail }
  SetPowerText(8200, 3700, '+5', '+5_BUCK');
  SetPowerText(10900, 2800, '+5', '+5_BUCK');
  AddWire(10500, 1600, 10500, 1500, 10300, 1500, 3);
  AddPower('+5_BUCK', 10300, 1500, 2);
  AddWire(10600, 1600, 10600, 1500, 10800, 1500, 3);
  AddPower('+5', 10800, 1500, 0);
  { +5 LED on the buck side, TVS on the rail, GND test point }
  AddPower('+5_BUCK', 8300, 2300, 1);
  AddWire(9000, 2300, 9200, 2300, 0, 0, 2);
  AddPower('GND', 9200, 1800, 3);
  AddPower('+5', 8300, 1500, 1);
  AddPower('GND', 8900, 1500, 3);
  AddPower('GND', 9300, 3100, 3);
  SchServer.ProcessControl.PostProcess(Doc, '');
  Doc.GraphicallyInvalidate;
  Log.SaveToFile(LogPath);
End;

Procedure FixConnSch;
Var It, W, Found, I, N;
Begin
  OpenLog;
  Doc := SchServer.GetCurrentSchDocument;
  If Doc = Nil Then Begin Log.Add('no sch'); Log.SaveToFile(LogPath); Exit; End;
  Log.Add('=== FixConnSch ' + Doc.DocumentName);
  If FindComp('F1') <> Nil Then Begin Log.Add('already done'); Log.SaveToFile(LogPath); Exit; End;
  { find the +12 bus wire that runs (4700,4100) ... (3900,4000) (3200,4000) (2700,4000) }
  Found := Nil;
  It := Doc.SchIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eWire));
  W := It.FirstSchObject;
  While W <> Nil Do
  Begin
    N := W.VerticesCount;
    If (N = 6) And (Abs(W.Vertex[6].X - M(2700)) < M(1)) And (Abs(W.Vertex[6].Y - M(4000)) < M(1))
       And (Abs(W.Vertex[4].X - M(3900)) < M(1)) Then Found := W;
    W := It.NextSchObject;
  End;
  Doc.SchIterator_Destroy(It);
  If Found = Nil Then Begin Log.Add('+12 wire not found, nothing changed'); Log.SaveToFile(LogPath); Exit; End;
  PlaceNew('Resistor', 3900, 4000, 2, 'F1', 'PTC 0.5A hold 16V 1210', 'CAP_1210', 'PTC 0.5A 1210');
  If FindComp('F1') = Nil Then Begin Log.SaveToFile(LogPath); Exit; End;
  SchServer.ProcessControl.PreProcess(Doc, '');
  Doc.RemoveSchObject(Found);
  SchServer.RobotManager.SendMessage(Doc.I_ObjectAddress, c_BroadCast, SCHM_PrimitiveRegistration, Found.I_ObjectAddress);
  Log.Add('old +12 wire removed');
  W := SchServer.SchObjectFactory(eWire, eCreate_Default);
  W.Location := Point(M(4700), M(4100));
  W.InsertVertex := 1; W.SetState_Vertex(1, Point(M(4700), M(4100)));
  W.InsertVertex := 2; W.SetState_Vertex(2, Point(M(4700), M(4000)));
  W.InsertVertex := 3; W.SetState_Vertex(3, Point(M(4300), M(4000)));
  W.InsertVertex := 4; W.SetState_Vertex(4, Point(M(3900), M(4000)));
  W.LineWidth := eSmall;
  Doc.RegisterSchObjectInContainer(W);
  SchServer.RobotManager.SendMessage(Doc.I_ObjectAddress, c_BroadCast, SCHM_PrimitiveRegistration, W.I_ObjectAddress);
  AddWire(3200, 4000, 2700, 4000, 0, 0, 2);
  Log.Add('F1 inserted between connector side (3900) and D15/FB2 side (3200)');
  SchServer.ProcessControl.PostProcess(Doc, '');
  Doc.GraphicallyInvalidate;
  Log.SaveToFile(LogPath);
End;
