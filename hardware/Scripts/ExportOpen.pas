{ Read-only. Lists every open ratsnest connection (net, from, to in mm from the board corner) and
  whether its net's connections are shown. Writes Scripts\open_export.txt. Generated by Claude. }
Function MM(C : TCoord) : String;
Begin
  Result := FloatToStrF(CoordToMMs(C), ffFixed, 8, 3);
End;

Procedure ExportOpen;
Var
  Board : IPCB_Board;
  It : IPCB_BoardIterator;
  Cn : IPCB_Connection;
  L : TStringList;
  RC : TCoordRect;
  X0, Y0 : TCoord;
  N, Vis : String;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  RC := Board.BoardOutline.BoundingRectangle;
  X0 := RC.Left;
  Y0 := RC.Bottom;
  L := TStringList.Create;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eConnectionObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  Cn := It.FirstPCBObject;
  While Cn <> Nil Do
  Begin
    If Cn.Net = Nil Then N := '' Else N := Cn.Net.Name;
    If Cn.Net = Nil Then Vis := '?' Else If Cn.Net.ConnectsVisible Then Vis := 'shown' Else Vis := 'hidden';
    L.Add(N + ';' + Vis + ';' + Layer2String(Cn.Layer) + ';' + MM(Cn.X1 - X0) + ';' + MM(Cn.Y1 - Y0) + ';' + MM(Cn.X2 - X0) + ';' + MM(Cn.Y2 - Y0));
    Cn := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  L.SaveToFile('C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\open_export.txt');
  ShowMessage('Open connections: ' + IntToStr(L.Count));
  L.Free;
End;
