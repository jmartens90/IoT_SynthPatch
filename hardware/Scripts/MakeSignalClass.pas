{ Creates (or refills) net class SIGNALS with every net except the power nets and GND,
  so the autorouter can route only signals (Route > Auto Route > Net Class > SIGNALS).
  Report: Scripts\signal_class.txt. Run with the PcbDoc active. Generated by Claude. }
Const
  RP = 'C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\signal_class.txt';

Function IsPower(S : String) : Boolean;
Begin
  S := UpperCase(S);
  Result := (S = '+3.3') Or (S = '+5') Or (S = '+5A') Or (S = '+5_USB') Or (S = '+12') Or (S = '-12') Or
            (S = 'GND') Or (S = 'VBUS') Or (S = '+12_IN') Or (S = '-12_IN');
End;

Procedure MakeSignalClass;
Var
  Board : IPCB_Board;
  It : IPCB_BoardIterator;
  NetO : IPCB_Net;
  C, Cls : IPCB_ObjectClass;
  Rep : TStringList;
  n, k : Integer;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  Rep := TStringList.Create;

  Cls := Nil;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eClassObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  C := It.FirstPCBObject;
  While C <> Nil Do
  Begin
    If (C.MemberKind = eClassMemberKind_Net) And (C.Name = 'SIGNALS') Then Cls := C;
    C := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);

  PCBServer.PreProcess;
  If Cls = Nil Then
  Begin
    Cls := PCBServer.PCBClassFactoryByClassMember(eClassMemberKind_Net);
    Cls.SuperClass := False;
    Cls.Name := 'SIGNALS';
    Board.AddPCBObject(Cls);
  End
  Else
    Cls.RemoveAllMembers;

  n := 0; k := 0;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eNetObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  NetO := It.FirstPCBObject;
  While NetO <> Nil Do
  Begin
    If IsPower(NetO.Name) Then
    Begin
      Rep.Add('skip ' + NetO.Name);
      k := k + 1;
    End
    Else
    Begin
      Cls.AddMemberByName(NetO.Name);
      n := n + 1;
    End;
    NetO := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  PCBServer.PostProcess;
  Rep.Add('SIGNALS: ' + IntToStr(n) + ' nets, skipped ' + IntToStr(k));
  Rep.SaveToFile(RP);
  ShowMessage('Net class SIGNALS: ' + IntToStr(n) + ' nets (skipped ' + IntToStr(k) + ' power nets).');
End;
