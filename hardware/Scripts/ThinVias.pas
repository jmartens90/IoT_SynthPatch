{ Thins out the GND stitching vias around the SPI traces near IC2 and puts the unconnected vias along the USB pair on GND.
  Keeps vias next to signal vias, next to GND pads, and a ~5 mm grid. Generated by Claude.
  Run with the PCB open: File > Run Script > ThinVias.pas > ThinVias. }
Procedure ThinVias;
Var
  Board : IPCB_Board;
  Iter  : IPCB_BoardIterator;
  V     : IPCB_Via;
  N     : IPCB_Net;
  Gnd   : IPCB_Net;
  L     : TStringList;
  Dels  : TInterfaceList;
  i, j, p, Removed, Netted : Integer;
  S : String;
  X, Y : TCoord;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  L := TStringList.Create;
  L.Add('44933;73457');
  L.Add('42113;72111');
  L.Add('43231;74066');
  L.Add('41326;69037');
  L.Add('35611;76175');
  L.Add('36576;77267');
  L.Add('37973;78283');
  L.Add('39675;78384');
  L.Add('41199;78410');
  L.Add('42875;78461');
  L.Add('44450;78257');
  L.Add('45517;77343');
  L.Add('43764;76957');
  L.Add('41885;76937');
  L.Add('41961;75514');
  L.Add('40302;76900');
  L.Add('38202;76378');
  L.Add('36779;75032');
  L.Add('37719;72314');
  L.Add('35992;71780');
  L.Add('37668;70841');
  L.Add('37287;69164');
  L.Add('36017;67843');
  L.Add('18110;80924');
  L.Add('17196;79426');
  L.Add('18186;78410');
  L.Add('19406;79654');
  L.Add('21666;77419');
  L.Add('22860;78511');
  L.Add('24592;76272');
  L.Add('24181;77724');
  L.Add('25212;76894');
  L.Add('22555;73330');
  L.Add('24016;75696');
  L.Add('24646;74236');
  L.Add('23896;73503');
  L.Add('24039;79504');
  L.Add('28040;79456');
  L.Add('26314;79548');
  L.Add('28142;77570');
  L.Add('26487;78268');
  L.Add('30353;75082');
  L.Add('29134;78511');
  L.Add('30124;77572');
  L.Add('31217;76454');
  L.Add('31394;73965');
  L.Add('28778;75997');
  L.Add('29134;74473');
  L.Add('30074;73457');
  L.Add('31090;72415');
  L.Add('32156;71374');
  L.Add('29261;71933');
  L.Add('30201;70891');
  L.Add('32207;68961');
  Gnd := Nil;
  Iter := Board.BoardIterator_Create;
  Iter.AddFilter_ObjectSet(MkSet(eNetObject));
  Iter.AddFilter_LayerSet(AllLayers);
  Iter.AddFilter_Method(eProcessAll);
  N := Iter.FirstPCBObject;
  While N <> Nil Do
  Begin
    If N.Name = 'GND' Then Gnd := N;
    N := Iter.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(Iter);
  Dels := TInterfaceList.Create;
  Netted := 0;
  PCBServer.PreProcess;
  Iter := Board.BoardIterator_Create;
  Iter.AddFilter_ObjectSet(MkSet(eViaObject));
  Iter.AddFilter_LayerSet(AllLayers);
  Iter.AddFilter_Method(eProcessAll);
  V := Iter.FirstPCBObject;
  While V <> Nil Do
  Begin
    If V.Net = Nil Then
    Begin
      If Gnd <> Nil Then
      Begin
        PCBServer.SendMessageToRobots(V.I_ObjectAddress, c_Broadcast, PCBM_BeginModify, c_NoEventData);
        V.Net := Gnd;
        PCBServer.SendMessageToRobots(V.I_ObjectAddress, c_Broadcast, PCBM_EndModify, c_NoEventData);
        Netted := Netted + 1;
      End;
    End
    Else If V.Net.Name = 'GND' Then
    Begin
      For i := 0 To L.Count - 1 Do
      Begin
        S := L[i];
        p := Pos(';', S);
        X := MMsToCoord(StrToInt(Copy(S, 1, p - 1)) / 1000);
        Y := MMsToCoord(StrToInt(Copy(S, p + 1, Length(S))) / 1000);
        If (Abs(V.X - Board.XOrigin - X) < MMsToCoord(0.01)) And (Abs(V.Y - Board.YOrigin - Y) < MMsToCoord(0.01)) Then
        Begin
          Dels.Add(V);
          Break;
        End;
      End;
    End;
    V := Iter.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(Iter);
  Removed := 0;
  For j := 0 To Dels.Count - 1 Do
  Begin
    V := Dels[j];
    Board.RemovePCBObject(V);
    Removed := Removed + 1;
  End;
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  ShowMessage('Removed ' + IntToStr(Removed) + ' GND vias, put ' + IntToStr(Netted) + ' unconnected vias on GND');
  L.Free;
End;
