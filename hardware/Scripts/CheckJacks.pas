{ CheckJacks.pas - dumps jack pads (name, net, position relative to origin) to Scripts\checkjacks.txt. Generated by Claude. }
Procedure CheckJacks;
Var Board : IPCB_Board; It : IPCB_BoardIterator; C : IPCB_Component; GIt : IPCB_GroupIterator; P : IPCB_Pad; L : TStringList; N : String;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  L := TStringList.Create;
  L.Add('file=' + Board.FileName);
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eComponentObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  C := It.FirstPCBObject;
  While C <> Nil Do
  Begin
    If Copy(UpperCase(C.Name.Text), 1, 1) = 'J' Then
    Begin
      L.Add('C;' + C.Name.Text + ';' + C.Pattern + ';' + FloatToStr(CoordToMMs(C.X)) + ';' + FloatToStr(CoordToMMs(C.Y)));
      GIt := C.GroupIterator_Create;
      GIt.AddFilter_ObjectSet(MkSet(ePadObject));
      P := GIt.FirstPCBObject;
      While P <> Nil Do
      Begin
        If P.Net = Nil Then N := '-' Else N := P.Net.Name;
        L.Add('P;' + P.Name + ';' + N + ';' + FloatToStr(CoordToMMs(P.X - C.X)) + ';' + FloatToStr(CoordToMMs(P.Y - C.Y)));
        P := GIt.NextPCBObject;
      End;
      C.GroupIterator_Destroy(GIt);
    End;
    C := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  L.SaveToFile('C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\checkjacks.txt');
End;
