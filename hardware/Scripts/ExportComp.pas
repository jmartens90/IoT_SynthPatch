{ ExportComp.pas - run with IoT_SYNTHPATCH.PcbDoc active. Dumps all primitives of J1 and ENC1
  to Scripts\comp_export.txt (mm, absolute). Generated by Claude. }
Procedure ExportComp;
Var
  NetN : String;
  Board : IPCB_Board; It : IPCB_BoardIterator; GIt : IPCB_GroupIterator;
  C : IPCB_Component; P : IPCB_Primitive; T : IPCB_Track; A : IPCB_Arc; Pd : IPCB_Pad;
  Log : TStringList; S : String;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  Log := TStringList.Create;
  Log.Add('ORIGIN;' + FloatToStr(CoordToMMs(Board.XOrigin)) + ';' + FloatToStr(CoordToMMs(Board.YOrigin)));
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eComponentObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  C := It.FirstPCBObject;
  While C <> Nil Do
  Begin
    If (C.Name.Text = 'J1') Or (C.Name.Text = 'ENC1') Then
    Begin
      Log.Add('C;' + C.Name.Text + ';' + C.Pattern + ';' + FloatToStr(CoordToMMs(C.X)) + ';' + FloatToStr(CoordToMMs(C.Y)) + ';' + FloatToStr(C.Rotation) + ';' + Layer2String(C.Layer));
      GIt := C.GroupIterator_Create;
      GIt.AddFilter_ObjectSet(AllObjects);
      P := GIt.FirstPCBObject;
      While P <> Nil Do
      Begin
        S := C.Name.Text + ';' + IntToStr(P.ObjectId) + ';' + Layer2String(P.Layer) + ';';
        If P.ObjectId = eTrackObject Then
          S := 'T;' + S + FloatToStr(CoordToMMs(P.X1)) + ';' + FloatToStr(CoordToMMs(P.Y1)) + ';' + FloatToStr(CoordToMMs(P.X2)) + ';' + FloatToStr(CoordToMMs(P.Y2)) + ';' + FloatToStr(CoordToMMs(P.Width))
        Else If P.ObjectId = eArcObject Then
          S := 'A;' + S + FloatToStr(CoordToMMs(P.XCenter)) + ';' + FloatToStr(CoordToMMs(P.YCenter)) + ';' + FloatToStr(CoordToMMs(P.Radius)) + ';' + FloatToStr(P.StartAngle) + ';' + FloatToStr(P.EndAngle) + ';' + FloatToStr(CoordToMMs(P.LineWidth))
        Else If P.ObjectId = ePadObject Then
        Begin
          NetN := '';
          If P.Net <> Nil Then NetN := P.Net.Name;
          S := 'P;' + S + P.Name + ';' + FloatToStr(CoordToMMs(P.X)) + ';' + FloatToStr(CoordToMMs(P.Y)) + ';' + FloatToStr(CoordToMMs(P.TopXSize)) + ';' + FloatToStr(CoordToMMs(P.TopYSize)) + ';' + FloatToStr(CoordToMMs(P.HoleSize)) + ';' + FloatToStr(CoordToMMs(P.HoleWidth)) + ';' + IntToStr(P.HoleType) + ';' + FloatToStr(P.HoleRotation) + ';' + IntToStr(P.TopShape) + ';' + FloatToStr(P.Rotation) + ';' + NetN;
        End
        Else
          S := 'O;' + S;
        Log.Add(S);
        P := GIt.NextPCBObject;
      End;
      C.GroupIterator_Destroy(GIt);
    End;
    C := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  Log.SaveToFile('C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\comp_export.txt');
End;
