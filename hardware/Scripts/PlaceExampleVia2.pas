{ Example of feeding an SMD pad from the PWR plane: C29 pad 2 (+5A, bottom side) gets a short
  0.4 mm track on the Bottom layer to a new +5A via inside the +5A island. The via connects to
  the PWR plane with thermal relief automatically and is cleared in the GND planes.
  Coordinates in mm from the board corner (outline at X0, Y0). Generated by Claude. }
Const
  X0 = 5.0;
  Y0 = 10.0;
  PX = 54.793;
  PY = 74.624;
  VX = 53.1;
  VY = 74.624;

Procedure PlaceExampleVia2;
Var
  Board : IPCB_Board;
  It : IPCB_BoardIterator;
  N, NN : IPCB_Net;
  V : IPCB_Via;
  T : IPCB_Track;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  NN := Nil;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eNetObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  N := It.FirstPCBObject;
  While N <> Nil Do
  Begin
    If UpperCase(N.Name) = '+5A' Then NN := N;
    N := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  If NN = Nil Then
  Begin
    ShowMessage('Net +5A not found.');
    Exit;
  End;

  PCBServer.PreProcess;
  V := PCBServer.PCBObjectFactory(eViaObject, eNoDimension, eCreate_Default);
  V.X := MMsToCoord(VX + X0);
  V.Y := MMsToCoord(VY + Y0);
  V.Size := MMsToCoord(0.6);
  V.HoleSize := MMsToCoord(0.3);
  V.LowLayer := eBottomLayer;
  V.HighLayer := eTopLayer;
  Board.AddPCBObject(V);
  NN.AddPCBObject(V);

  T := PCBServer.PCBObjectFactory(eTrackObject, eNoDimension, eCreate_Default);
  T.X1 := MMsToCoord(PX + X0);
  T.Y1 := MMsToCoord(PY + Y0);
  T.X2 := MMsToCoord(VX + X0);
  T.Y2 := MMsToCoord(VY + Y0);
  T.Width := MMsToCoord(0.4);
  T.Layer := eBottomLayer;
  Board.AddPCBObject(T);
  NN.AddPCBObject(T);
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  ShowMessage('Placed a +5A via and track at C29 pad 2.');
End;
