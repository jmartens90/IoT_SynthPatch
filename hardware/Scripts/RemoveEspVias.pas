{ Removes the 5 extra GND vias placed earlier in the ESP32 (IC2) ground pad. The module's own
  12 thermal vias (now on GND) do the job, and the extra ones broke hole-to-hole spacing and hit a
  SIG_MID track. Generated by Claude. }
Var
  X0, Y0 : TCoord;

Function Hit(V : IPCB_Via; X, Y : Double) : Boolean;
Begin
  Result := (Abs(V.X - X0 - MMsToCoord(X)) < MMsToCoord(0.05)) And (Abs(V.Y - Y0 - MMsToCoord(Y)) < MMsToCoord(0.05));
End;

Procedure RemoveEspVias;
Var
  Board : IPCB_Board;
  It : IPCB_BoardIterator;
  V : IPCB_Via;
  L : TInterfaceList;
  RC : TCoordRect;
  i : Integer;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  RC := Board.BoardOutline.BoundingRectangle;
  X0 := RC.Left;
  Y0 := RC.Bottom;
  L := TInterfaceList.Create;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eViaObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  V := It.FirstPCBObject;
  While V <> Nil Do
  Begin
    If Hit(V, 25.639, 92.966) Or Hit(V, 24.239, 91.566) Or Hit(V, 27.039, 91.566) Or
       Hit(V, 24.239, 94.366) Or Hit(V, 27.039, 94.366) Then L.Add(V);
    V := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  PCBServer.PreProcess;
  For i := 0 To L.Count - 1 Do
  Begin
    V := L.Items[i];
    Board.RemovePCBObject(V);
  End;
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  ShowMessage('Removed ' + IntToStr(L.Count) + ' extra ESP32 GND vias.');
End;
