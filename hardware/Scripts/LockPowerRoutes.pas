{ Locks every track, arc and via on the power nets and GND, so an autorouter run without
  "Lock All Pre-routes" can rip up signal routing but leaves power routing alone.
  Run with the PcbDoc active. Generated by Claude. }
Function IsPower(S : String) : Boolean;
Begin
  S := UpperCase(S);
  Result := (S = '+3.3') Or (S = '+5') Or (S = '+5A') Or (S = '+5_USB') Or (S = '+12') Or (S = '-12') Or (S = 'GND');
End;

Procedure LockPowerRoutes;
Var
  Board : IPCB_Board;
  It : IPCB_BoardIterator;
  O : IPCB_Primitive;
  L : TInterfaceList;
  i : Integer;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  L := TInterfaceList.Create;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eTrackObject, eArcObject, eViaObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  O := It.FirstPCBObject;
  While O <> Nil Do
  Begin
    If (O.Net <> Nil) And (Not O.InPolygon) And (Not O.InComponent) Then
      If IsPower(O.Net.Name) And (Not O.Moveable = False) Then L.Add(O);
    O := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  PCBServer.PreProcess;
  For i := 0 To L.Count - 1 Do
  Begin
    O := L.Items[i];
    O.Moveable := False;
  End;
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  ShowMessage('Locked ' + IntToStr(L.Count) + ' power/GND tracks, arcs and vias.');
End;
