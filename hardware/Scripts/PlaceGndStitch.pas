{ Places GND stitching vias (0.6/0.3) and short GND tracks from Scripts\gnd_plan.txt
  (lines "V;x;y" and "T;layer;x1;y1;x2;y2", mm from the board outline's bottom-left corner,
  decimal comma), and puts the 12 net-less IC2 thermal vias (pads named GND) on net GND.
  Clearances were checked when the plan was made. Generated by Claude. }
Var
  Board : IPCB_Board;
  X0, Y0 : TCoord;
  NG : IPCB_Net;

Function Field(S : String; Idx : Integer) : String;
Var
  i, k : Integer;
Begin
  Result := '';
  k := 0;
  For i := 1 To Length(S) Do
  Begin
    If S[i] = ';' Then k := k + 1
    Else If k = Idx Then Result := Result + S[i];
  End;
End;

Function Num(S : String) : Double;
Begin
  Result := StrToFloat(S);
End;

Procedure PlaceGndStitch;
Var
  It : IPCB_BoardIterator;
  N : IPCB_Net;
  P : IPCB_Pad;
  V : IPCB_Via;
  T : IPCB_Track;
  L, PL : TInterfaceList;
  RC : TCoordRect;
  F : TStringList;
  i, NV, NT, NP : Integer;
  S : String;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  RC := Board.BoardOutline.BoundingRectangle;
  X0 := RC.Left;
  Y0 := RC.Bottom;
  NG := Nil;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eNetObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  N := It.FirstPCBObject;
  While N <> Nil Do
  Begin
    If UpperCase(N.Name) = 'GND' Then NG := N;
    N := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  If NG = Nil Then Exit;

  PL := TInterfaceList.Create;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(ePadObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  P := It.FirstPCBObject;
  While P <> Nil Do
  Begin
    If (P.Net = Nil) And (P.Component <> Nil) Then
      If (P.Component.Name.Text = 'IC2') And (UpperCase(P.Name) = 'GND') Then PL.Add(P);
    P := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);

  F := TStringList.Create;
  F.LoadFromFile('C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\gnd_plan.txt');
  NV := 0;
  NT := 0;
  PCBServer.PreProcess;
  For i := 0 To PL.Count - 1 Do
  Begin
    P := PL.Items[i];
    P.BeginModify;
    NG.AddPCBObject(P);
    P.EndModify;
  End;
  NP := PL.Count;
  For i := 0 To F.Count - 1 Do
  Begin
    S := F.Strings[i];
    If Field(S, 0) = 'V' Then
    Begin
      V := PCBServer.PCBObjectFactory(eViaObject, eNoDimension, eCreate_Default);
      V.X := X0 + MMsToCoord(Num(Field(S, 1)));
      V.Y := Y0 + MMsToCoord(Num(Field(S, 2)));
      V.Size := MMsToCoord(0.6);
      V.HoleSize := MMsToCoord(0.3);
      V.LowLayer := eBottomLayer;
      V.HighLayer := eTopLayer;
      Board.AddPCBObject(V);
      NG.AddPCBObject(V);
      NV := NV + 1;
    End
    Else If Field(S, 0) = 'T' Then
    Begin
      T := PCBServer.PCBObjectFactory(eTrackObject, eNoDimension, eCreate_Default);
      T.X1 := X0 + MMsToCoord(Num(Field(S, 2)));
      T.Y1 := Y0 + MMsToCoord(Num(Field(S, 3)));
      T.X2 := X0 + MMsToCoord(Num(Field(S, 4)));
      T.Y2 := Y0 + MMsToCoord(Num(Field(S, 5)));
      T.Width := MMsToCoord(0.3);
      If Field(S, 1) = 'Top Layer' Then T.Layer := eTopLayer Else T.Layer := eBottomLayer;
      Board.AddPCBObject(T);
      NG.AddPCBObject(T);
      NT := NT + 1;
    End;
  End;
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  ShowMessage('Placed ' + IntToStr(NV) + ' GND vias and ' + IntToStr(NT) + ' GND tracks; ' + IntToStr(NP) + ' IC2 thermal vias set to GND.');
End;
