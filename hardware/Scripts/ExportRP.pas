{ Read-only: exports copper for a return-path check to Scripts\rp_<board>.txt (mm from the board
  origin, decimal comma): L layer names, B board bbox, T tracks, A arcs, V vias, P pads,
  O polygon outlines (vertices), F fills, R regions (bbox). Generated by Claude. }
Var
  Board : IPCB_Board;
  S : TStringList;

Function F(C : TCoord; O : TCoord) : String;
Begin
  Result := FloatToStr(Round(CoordToMMs(C - O) * 1000) / 1000);
End;

Function NetOf(O : IPCB_Primitive) : String;
Begin
  If O.Net = Nil Then Result := '' Else Result := O.Net.Name;
End;

Procedure ExportRP;
Var
  It : IPCB_BoardIterator;
  O : IPCB_Primitive;
  T : IPCB_Track;
  A : IPCB_Arc;
  V : IPCB_Via;
  P : IPCB_Pad;
  Pg : IPCB_Polygon;
  R : TCoordRect;
  i : Integer;
  Ln, Nm : String;
  X0, Y0 : TCoord;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  X0 := Board.XOrigin; Y0 := Board.YOrigin;
  S := TStringList.Create;
  For i := 1 To 6 Do
    S.Add('L;' + Layer2String(i + 1) + ';' + Board.LayerStack.LayerObject(i + 1).Name);
  S.Add('L;Plane1;' + Board.LayerStack.LayerObject(eInternalPlane1).Name);
  S.Add('L;Plane2;' + Board.LayerStack.LayerObject(eInternalPlane2).Name);
  R := Board.BoardOutline.BoundingRectangle;
  S.Add('B;' + F(R.Left, X0) + ';' + F(R.Bottom, Y0) + ';' + F(R.Right, X0) + ';' + F(R.Top, Y0));

  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eTrackObject, eArcObject, eViaObject, ePadObject, eFillObject, eRegionObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  O := It.FirstPCBObject;
  While O <> Nil Do
  Begin
    Ln := Layer2String(O.Layer);
    If O.ObjectId = eTrackObject Then
    Begin
      T := O;
      S.Add('T;' + NetOf(O) + ';' + Ln + ';' + F(T.Width, 0) + ';' + F(T.X1, X0) + ';' + F(T.Y1, Y0) + ';' + F(T.X2, X0) + ';' + F(T.Y2, Y0) + ';' + BoolToStr(O.InPolygon, True));
    End
    Else If O.ObjectId = eArcObject Then
    Begin
      A := O;
      S.Add('A;' + NetOf(O) + ';' + Ln + ';' + F(A.LineWidth, 0) + ';' + F(A.XCenter, X0) + ';' + F(A.YCenter, Y0) + ';' + F(A.Radius, 0) + ';' + FloatToStr(A.StartAngle) + ';' + FloatToStr(A.EndAngle) + ';' + BoolToStr(O.InPolygon, True));
    End
    Else If O.ObjectId = eViaObject Then
    Begin
      V := O;
      S.Add('V;' + NetOf(O) + ';' + F(V.Size, 0) + ';' + F(V.HoleSize, 0) + ';' + F(V.X, X0) + ';' + F(V.Y, Y0) + ';' + Layer2String(V.LowLayer) + ';' + Layer2String(V.HighLayer));
    End
    Else If O.ObjectId = ePadObject Then
    Begin
      P := O;
      If P.Component <> Nil Then Nm := P.Component.Name.Text + '-' + P.Name Else Nm := '-' + P.Name;
      R := P.BoundingRectangle;
      S.Add('P;' + Nm + ';' + NetOf(O) + ';' + Ln + ';' + F(P.X, X0) + ';' + F(P.Y, Y0) + ';' + F(R.Left, X0) + ';' + F(R.Bottom, Y0) + ';' + F(R.Right, X0) + ';' + F(R.Top, Y0) + ';' + F(P.HoleSize, 0));
    End
    Else
    Begin
      R := O.BoundingRectangle;
      S.Add('F;' + NetOf(O) + ';' + Ln + ';' + F(R.Left, X0) + ';' + F(R.Bottom, Y0) + ';' + F(R.Right, X0) + ';' + F(R.Top, Y0) + ';' + BoolToStr(O.InPolygon, True));
    End;
    O := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);

  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(ePolyObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  Pg := It.FirstPCBObject;
  While Pg <> Nil Do
  Begin
    Ln := 'O;' + Pg.Name + ';' + NetOf(Pg) + ';' + Layer2String(Pg.Layer) + ';';
    For i := 0 To Pg.PointCount - 1 Do
      Ln := Ln + F(Pg.Segments[i].vx, X0) + ' ' + F(Pg.Segments[i].vy, Y0) + ',';
    S.Add(Ln);
    Pg := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  If Pos('ANALOG', UpperCase(Board.FileName)) > 0 Then Nm := 'analog' Else Nm := 'main';
  S.SaveToFile('C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\rp_' + Nm + '.txt');
  ShowMessage('Exported ' + IntToStr(S.Count) + ' lines to rp_' + Nm + '.txt');
End;
