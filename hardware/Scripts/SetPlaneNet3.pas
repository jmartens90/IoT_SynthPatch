{ Sets plane nets to match their names: PWR = +3.3, GND and GND2 = GND, and reports every plane's net.
  Run with the PcbDoc active. Generated by Claude. }
Procedure SetPlaneNet3;
Var
  Board : IPCB_Board;
  LO : IPCB_InternalPlane;
  S : String;
  L : Integer;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  S := '';
  For L := eInternalPlane1 To eInternalPlane4 Do
  Begin
    LO := Board.LayerStack.LayerObject(L);
    If LO <> Nil Then
    Begin
      If LO.Name = 'PWR' Then LO.NetName := '+3.3';
      If (LO.Name = 'GND') Or (LO.Name = 'GND2') Then LO.NetName := 'GND';
      S := S + LO.Name + ' = ' + LO.NetName + ' / ';
    End;
  End;
  Board.ViewManager_FullUpdate;
  ShowMessage(S);
End;
