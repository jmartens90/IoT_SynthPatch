{ MakeUsbHro.pas - run with IoT_SYNTHPATCH.PcbLib active.
  Copies FP-216990-0002-MFG (Molex mid-mount USB-C) to a new footprint USB_C_HRO_TYPE-C-31-M-12
  and turns it into the top-mount HRO TYPE-C-31-M-12 land pattern:
  - same pad names, signal pads unchanged (0.5 mm pitch), VBUS at +-2.45, GND at +-3.25, pads 1.45 long
  - shell legs moved to x +-4.32: near legs 0.915 mm from the pad row (slot 0.6x1.7, pad 1.0x2.1),
    far legs 5.095 mm (slot 0.6x1.2, pad 1.0x1.6)
  - two NPTH 0.65 mm locating pegs at x +-2.89, 1.445 mm from the pad row
  - board-cutout regions and the Molex 3D body removed.
  Generated by Claude. }
Var
  Lib : IPCB_Library;
  Log : TStringList;

Function FindFp(Name : String) : IPCB_LibComponent;
Var It : IPCB_LibraryIterator; C : IPCB_LibComponent;
Begin
  Result := Nil;
  It := Lib.LibraryIterator_Create;
  It.SetState_FilterAll;
  C := It.FirstPCBObject;
  While C <> Nil Do
  Begin
    If UpperCase(C.Name) = UpperCase(Name) Then Result := C;
    C := It.NextPCBObject;
  End;
  Lib.LibraryIterator_Destroy(It);
End;

Procedure SetSizes(P : IPCB_Pad; LongV, ShortV : Double);
Begin
  If P.TopXSize >= P.TopYSize Then
  Begin
    P.TopXSize := MMsToCoord(LongV); P.TopYSize := MMsToCoord(ShortV);
    P.MidXSize := MMsToCoord(LongV); P.MidYSize := MMsToCoord(ShortV);
    P.BotXSize := MMsToCoord(LongV); P.BotYSize := MMsToCoord(ShortV);
  End Else Begin
    P.TopXSize := MMsToCoord(ShortV); P.TopYSize := MMsToCoord(LongV);
    P.MidXSize := MMsToCoord(ShortV); P.MidYSize := MMsToCoord(LongV);
    P.BotXSize := MMsToCoord(ShortV); P.BotYSize := MMsToCoord(LongV);
  End;
End;

Procedure MakeUsbHro;
Var
  Src, Dst : IPCB_LibComponent;
  GIt : IPCB_GroupIterator;
  Prim, Copy : IPCB_Primitive;
  P : IPCB_Pad;
  L : TInterfaceList;
  i : Integer;
  XC, YS, Dir, SX, DY : Double;
  XA6, XA7, YLeg : Double;
  NP : IPCB_Pad;
Begin
  Lib := PCBServer.GetCurrentPCBLibrary;
  If Lib = Nil Then Begin ShowMessage('Make IoT_SYNTHPATCH.PcbLib the active document first'); Exit; End;
  Log := TStringList.Create;
  If FindFp('USB_C_HRO_TYPE-C-31-M-12') <> Nil Then Begin ShowMessage('USB_C_HRO_TYPE-C-31-M-12 already exists'); Exit; End;
  Src := FindFp('FP-216990-0002-MFG');
  If Src = Nil Then Begin ShowMessage('FP-216990-0002-MFG not found'); Exit; End;

  PCBServer.PreProcess;
  Dst := PCBServer.CreatePCBLibComp;
  Dst.Name := 'USB_C_HRO_TYPE-C-31-M-12';
  Dst.Description := 'USB-C 16P top mount, HRO TYPE-C-31-M-12 (pin compatible with the 216990-0002 pad row)';
  Lib.RegisterComponent(Dst);

  L := TInterfaceList.Create;
  GIt := Src.GroupIterator_Create;
  GIt.AddFilter_ObjectSet(AllObjects);
  Prim := GIt.FirstPCBObject;
  While Prim <> Nil Do Begin L.Add(Prim); Prim := GIt.NextPCBObject; End;
  Src.GroupIterator_Destroy(GIt);
  For i := 0 To L.Count - 1 Do
  Begin
    Prim := L.Items[i];
    If Prim.ObjectId = eComponentBodyObject Then Continue;
    If Prim.ObjectId = eRegionObject Then
      If Prim.Kind = eRegionKind_BoardCutout Then Continue;
    Copy := Prim.Replicate;
    Dst.AddPCBObject(Copy);
  End;
  Log.Add('copied ' + IntToStr(L.Count) + ' primitives');

  { find pad row and centre from A6/A7 }
  L.Clear;
  GIt := Dst.GroupIterator_Create;
  GIt.AddFilter_ObjectSet(MkSet(ePadObject));
  P := GIt.FirstPCBObject;
  While P <> Nil Do Begin L.Add(P); P := GIt.NextPCBObject; End;
  Dst.GroupIterator_Destroy(GIt);
  XA6 := 0; XA7 := 0; YS := 0; YLeg := 0;
  For i := 0 To L.Count - 1 Do
  Begin
    P := L.Items[i];
    If P.Name = 'A6' Then Begin XA6 := CoordToMMs(P.X); YS := CoordToMMs(P.Y); End;
    If P.Name = 'A7' Then XA7 := CoordToMMs(P.X);
    If P.Name = '1' Then YLeg := CoordToMMs(P.Y);
  End;
  XC := (XA6 + XA7) / 2;
  If YLeg > YS Then Dir := 1 Else Dir := -1;
  Log.Add('centre x ' + FloatToStr(XC) + ' pad row y ' + FloatToStr(YS) + ' dir ' + FloatToStr(Dir));

  For i := 0 To L.Count - 1 Do
  Begin
    P := L.Items[i];
    P.BeginModify;
    If CoordToMMs(P.X) > XC Then SX := 1 Else SX := -1;
    If (P.Name = '1') Or (P.Name = '2') Or (P.Name = '3') Or (P.Name = '4') Then
    Begin
      DY := Abs(CoordToMMs(P.Y) - YS);
      P.X := MMsToCoord(XC + SX * 4.32);
      If DY < 3 Then
      Begin
        P.Y := MMsToCoord(YS + Dir * 0.915);
        SetSizes(P, 2.1, 1.0);
        If P.HoleWidth > P.HoleSize Then P.HoleWidth := MMsToCoord(1.7) Else P.HoleSize := MMsToCoord(1.7);
      End Else Begin
        P.Y := MMsToCoord(YS + Dir * 5.095);
        SetSizes(P, 1.6, 1.0);
        If P.HoleWidth > P.HoleSize Then P.HoleWidth := MMsToCoord(1.2) Else P.HoleSize := MMsToCoord(1.2);
      End;
      Log.Add('shell ' + P.Name + ' -> ' + FloatToStr(CoordToMMs(P.X)-XC) + ', ' + FloatToStr(CoordToMMs(P.Y)-YS) + ' hole ' + FloatToStr(CoordToMMs(P.HoleSize)) + ' x ' + FloatToStr(CoordToMMs(P.HoleWidth)));
    End Else
    Begin
      If (P.Name = 'A4-B9') Or (P.Name = 'B4-A9') Then P.X := MMsToCoord(XC + SX * 2.45);
      If (P.Name = 'A1-B12') Or (P.Name = 'B1-A12') Then P.X := MMsToCoord(XC + SX * 3.25);
      If (P.TopXSize > P.TopYSize) Then SetSizes(P, 1.45, CoordToMMs(P.TopYSize)) Else SetSizes(P, 1.45, CoordToMMs(P.TopXSize));
      Log.Add('smd ' + P.Name + ' x ' + FloatToStr(CoordToMMs(P.X)-XC));
    End;
    P.EndModify;
  End;

  { two NPTH pegs }
  For i := 0 To 1 Do
  Begin
    NP := PCBServer.PCBObjectFactory(ePadObject, eNoDimension, eCreate_Default);
    If i = 0 Then SX := -1 Else SX := 1;
    NP.X := MMsToCoord(XC + SX * 2.89);
    NP.Y := MMsToCoord(YS + Dir * 1.445);
    NP.Layer := eMultiLayer;
    NP.HoleSize := MMsToCoord(0.65);
    NP.TopXSize := MMsToCoord(0.65); NP.TopYSize := MMsToCoord(0.65);
    NP.MidXSize := MMsToCoord(0.65); NP.MidYSize := MMsToCoord(0.65);
    NP.BotXSize := MMsToCoord(0.65); NP.BotYSize := MMsToCoord(0.65);
    NP.TopShape := eRounded; NP.MidShape := eRounded; NP.BotShape := eRounded;
    NP.Plated := False;
    NP.Name := '';
    Dst.AddPCBObject(NP);
  End;
  PCBServer.PostProcess;
  Lib.CurrentComponent := Dst;
  Lib.Board.ViewManager_FullUpdate;
  Log.SaveToFile(ExtractFilePath(Lib.Board.FileName) + 'Scripts\makeusb_log.txt');
  ShowMessage('USB_C_HRO_TYPE-C-31-M-12 created. Check it, then save the PcbLib. Log: Scripts\makeusb_log.txt');
End;
