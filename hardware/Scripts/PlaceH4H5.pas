{ Places the 1x20 board-to-board headers H4 and H5, removes the four M3 mounting holes (free pads named MH),
  moves parts that collide with H4/H5 to the nearest free spot, and on the analog board places the parts that
  came over from INPUTS_GATES, MUTE_BUTTONS and MENU_BUTTONS in free space on the bottom side.
  Main board: H4/H5 on the bottom (sockets). Analog board (path contains \ANALOG\): H4/H5 on top (pin headers).
  Run with the PcbDoc active: File > Run Script > PlaceH4H5.pas > PlaceH4H5. Generated by Claude. }
Const
  CELL = 0.5;
  GX0 = -6.0;
  GY0 = -1.0;
  NX = 224;
  NY = 222;
  CLR = 0.25;
  KMAX = 230;

Var
  Board : IPCB_Board;
  GridB, GridT : Variant;
  RL, RB, RR, RT : Double;
  Names, Rep : TStringList;
  SeedX, SeedY, SeedS : TStringList;
  BX, BY : Double;

Function FindComp(Board : IPCB_Board; Des : String) : IPCB_Component;
Var
  It : IPCB_BoardIterator;
  C  : IPCB_Component;
Begin
  Result := Nil;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eComponentObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  C := It.FirstPCBObject;
  While C <> Nil Do
  Begin
    If C.Name.Text = Des Then Result := C;
    C := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
End;

Function Pad1(C : IPCB_Component) : IPCB_Pad;
Var
  GI : IPCB_GroupIterator;
  P  : IPCB_Pad;
Begin
  Result := Nil;
  GI := C.GroupIterator_Create;
  GI.AddFilter_ObjectSet(MkSet(ePadObject));
  P := GI.FirstPCBObject;
  While P <> Nil Do
  Begin
    If P.Name = '1' Then Result := P;
    P := GI.NextPCBObject;
  End;
  C.GroupIterator_Destroy(GI);
End;

Procedure PlaceOne(Board : IPCB_Board; C : IPCB_Component; X, Y, Rot : Double; Bottom : Boolean);
Begin
  PCBServer.SendMessageToRobots(C.I_ObjectAddress, c_Broadcast, PCBM_BeginModify, c_NoEventData);
  If Bottom Then C.Layer := eBottomLayer Else C.Layer := eTopLayer;
  C.Rotation := Rot;
  C.MoveToXY(Board.XOrigin + MMsToCoord(X), Board.YOrigin + MMsToCoord(Y));
  PCBServer.SendMessageToRobots(C.I_ObjectAddress, c_Broadcast, PCBM_EndModify, c_NoEventData);
End;

{ Places a header so that its pad 1 lands where pad 1 of the mating header on the other board is.
  Pad 1 target: rot 0 -> left end, rot 90 -> bottom end. Turns the part 180 deg if needed. }
Function PlaceHeader(Board : IPCB_Board; Des : String; X, Y, Rot : Double; N : Integer; Bottom : Boolean) : String;
Var
  C : IPCB_Component;
  P : IPCB_Pad;
  TX, TY, Half : Double;
Begin
  Result := Des + ' not found';
  C := FindComp(Board, Des);
  If C = Nil Then Exit;
  Half := (N - 1) * 2.54 / 2;
  If Rot = 0 Then Begin TX := X - Half; TY := Y; End Else Begin TX := X; TY := Y - Half; End;
  PlaceOne(Board, C, X, Y, Rot, Bottom);
  P := Pad1(C);
  If (Abs(CoordToMMs(P.X - Board.XOrigin) - TX) > 0.1) Or (Abs(CoordToMMs(P.Y - Board.YOrigin) - TY) > 0.1) Then
    PlaceOne(Board, C, X, Y, Rot + 180, Bottom);
  P := Pad1(C);
  Result := Des + ' pad 1 at ' + FloatToStrF(CoordToMMs(P.X - Board.XOrigin), ffFixed, 6, 2) + ', ' +
            FloatToStrF(CoordToMMs(P.Y - Board.YOrigin), ffFixed, 6, 2) + ' (target ' +
            FloatToStrF(TX, ffFixed, 6, 2) + ', ' + FloatToStrF(TY, ffFixed, 6, 2) + ')';
End;

Function MX(C : TCoord) : Double;
Begin
  Result := CoordToMMs(C - Board.XOrigin);
End;

Function MY(C : TCoord) : Double;
Begin
  Result := CoordToMMs(C - Board.YOrigin);
End;

Function F2(V : Double) : String;
Begin
  Result := FloatToStrF(V, ffFixed, 7, 2);
End;

Procedure Mark(Side : Integer; L, B, R, T : Double);
Var
  ix, iy, x1, x2, y1, y2 : Integer;
Begin
  If (R < GX0) Or (T < GY0) Or (L > GX0 + NX * CELL) Or (B > GY0 + NY * CELL) Then Exit;
  x1 := Trunc((L - GX0) / CELL); If x1 < 0 Then x1 := 0;
  x2 := Trunc((R - GX0) / CELL); If x2 > NX - 1 Then x2 := NX - 1;
  y1 := Trunc((B - GY0) / CELL); If y1 < 0 Then y1 := 0;
  y2 := Trunc((T - GY0) / CELL); If y2 > NY - 1 Then y2 := NY - 1;
  For iy := y1 To y2 Do
    For ix := x1 To x2 Do
      If Side = 0 Then GridB[iy * NX + ix] := 1 Else GridT[iy * NX + ix] := 1;
End;

Function Free(Side : Integer; L, B, R, T : Double) : Boolean;
Var
  ix, iy, x1, x2, y1, y2 : Integer;
Begin
  Result := False;
  If (L < RL) Or (B < RB) Or (R > RR) Or (T > RT) Then Exit;
  x1 := Trunc((L - GX0) / CELL);
  x2 := Trunc((R - GX0) / CELL);
  y1 := Trunc((B - GY0) / CELL);
  y2 := Trunc((T - GY0) / CELL);
  For iy := y1 To y2 Do
    For ix := x1 To x2 Do
    Begin
      If Side = 0 Then
      Begin
        If GridB[iy * NX + ix] = 1 Then Exit;
      End
      Else If GridT[iy * NX + ix] = 1 Then Exit;
    End;
  Result := True;
End;

Function Overlap(A, B : TCoordRect; M : Double) : Boolean;
Var
  G : TCoord;
Begin
  G := MMsToCoord(M);
  Result := (A.Left - G < B.Right) And (B.Left < A.Right + G) And (A.Bottom - G < B.Top) And (B.Bottom < A.Top + G);
End;

Function SideOf(C : IPCB_Component) : Integer;
Begin
  If C.Layer = eBottomLayer Then Result := 0 Else Result := 1;
End;

Procedure MarkComp(C : IPCB_Component);
Var
  R : TCoordRect;
Begin
  R := C.BoundingRectangleNoNameComment;
  Mark(SideOf(C), MX(R.Left) - CLR, MY(R.Bottom) - CLR, MX(R.Right) + CLR, MY(R.Top) + CLR);
End;

Procedure BuildGrid;
Var
  It : IPCB_BoardIterator;
  C  : IPCB_Component;
  P  : IPCB_Pad;
  R  : TCoordRect;
  i  : Integer;
Begin
  GridB := VarArrayCreate([0, NX * NY - 1], 3);
  GridT := VarArrayCreate([0, NX * NY - 1], 3);
  For i := 0 To NX * NY - 1 Do
  Begin
    GridB[i] := 0;
    GridT[i] := 0;
  End;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eComponentObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  C := It.FirstPCBObject;
  While C <> Nil Do
  Begin
    If Names.IndexOf(C.Name.Text) < 2 Then MarkComp(C);  { H4, H5 are entries 0 and 1 }
    C := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  { through-hole pads block both sides }
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(ePadObject));
  It.AddFilter_LayerSet(MkSet(eMultiLayer));
  It.AddFilter_Method(eProcessAll);
  P := It.FirstPCBObject;
  While P <> Nil Do
  Begin
    R := P.BoundingRectangle;
    Mark(0, MX(R.Left) - CLR, MY(R.Bottom) - CLR, MX(R.Right) + CLR, MY(R.Top) + CLR);
    Mark(1, MX(R.Left) - CLR, MY(R.Bottom) - CLR, MX(R.Right) + CLR, MY(R.Top) + CLR);
    P := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
End;

Procedure SetPose(C : IPCB_Component; Side : Integer; Rot : Double);
Begin
  PCBServer.SendMessageToRobots(C.I_ObjectAddress, c_Broadcast, PCBM_BeginModify, c_NoEventData);
  If Side = 0 Then C.Layer := eBottomLayer Else C.Layer := eTopLayer;
  C.Rotation := Rot;
  PCBServer.SendMessageToRobots(C.I_ObjectAddress, c_Broadcast, PCBM_EndModify, c_NoEventData);
End;

{ Spiral search from (SX, SY) for the nearest spot where the part's body fits. Result in BX, BY. }
Function Search(C : IPCB_Component; Side : Integer; SX, SY : Double) : Boolean;
Var
  R : TCoordRect;
  dl, db, dr, dt, x, y : Double;
  k, i : Integer;
Begin
  Result := True;
  R := C.BoundingRectangleNoNameComment;
  dl := MX(R.Left) - MX(C.X) - CLR;
  dr := MX(R.Right) - MX(C.X) + CLR;
  db := MY(R.Bottom) - MY(C.Y) - CLR;
  dt := MY(R.Top) - MY(C.Y) + CLR;
  BX := SX; BY := SY;
  If Free(Side, SX + dl, SY + db, SX + dr, SY + dt) Then Exit;
  For k := 1 To KMAX Do
  Begin
    For i := -k To k Do
    Begin
      x := SX + i * CELL;
      y := SY - k * CELL;
      If Free(Side, x + dl, y + db, x + dr, y + dt) Then Begin BX := x; BY := y; Exit; End;
      y := SY + k * CELL;
      If Free(Side, x + dl, y + db, x + dr, y + dt) Then Begin BX := x; BY := y; Exit; End;
    End;
    For i := -k + 1 To k - 1 Do
    Begin
      y := SY + i * CELL;
      x := SX - k * CELL;
      If Free(Side, x + dl, y + db, x + dr, y + dt) Then Begin BX := x; BY := y; Exit; End;
      x := SX + k * CELL;
      If Free(Side, x + dl, y + db, x + dr, y + dt) Then Begin BX := x; BY := y; Exit; End;
    End;
  End;
  Result := False;
End;

Procedure PlaceFree(C : IPCB_Component; Side : Integer; SX, SY : Double);
Var
  r, s : Integer;
  Ok : Boolean;
Begin
  Ok := False;
  For s := 0 To 1 Do
  Begin
    If Not Ok Then
    For r := 0 To 1 Do
      If Not Ok Then
      Begin
        SetPose(C, Abs(Side - s), r * 90);
        If Search(C, Abs(Side - s), SX, SY) Then Ok := True;
      End;
  End;
  If Not Ok Then
  Begin
    Rep.Add(C.Name.Text + ': no free spot found, left where it was');
    Exit;
  End;
  PCBServer.SendMessageToRobots(C.I_ObjectAddress, c_Broadcast, PCBM_BeginModify, c_NoEventData);
  C.MoveToXY(Board.XOrigin + MMsToCoord(BX), Board.YOrigin + MMsToCoord(BY));
  PCBServer.SendMessageToRobots(C.I_ObjectAddress, c_Broadcast, PCBM_EndModify, c_NoEventData);
  MarkComp(C);
  If C.Layer = eBottomLayer Then
    Rep.Add(C.Name.Text + ' -> ' + F2(BX) + ', ' + F2(BY) + ' bottom rot ' + IntToStr(Round(C.Rotation)))
  Else
    Rep.Add(C.Name.Text + ' -> ' + F2(BX) + ', ' + F2(BY) + ' TOP rot ' + IntToStr(Round(C.Rotation)));
End;

Procedure AddMove(Side : Integer; Des : String; SX, SY : Double);
Begin
  If Names.IndexOf(Des) >= 0 Then Exit;
  Names.Add(Des);
  SeedX.Add(FloatToStr(SX));
  SeedY.Add(FloatToStr(SY));
  SeedS.Add(IntToStr(Side));
End;

Procedure RemoveHoles;
Var
  It : IPCB_BoardIterator;
  P  : IPCB_Pad;
  Kill : TInterfaceList;
  i : Integer;
Begin
  Kill := TInterfaceList.Create;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(ePadObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  P := It.FirstPCBObject;
  While P <> Nil Do
  Begin
    If (P.Name = 'MH') And (Not P.InComponent) Then Kill.Add(P);
    P := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  For i := 0 To Kill.Count - 1 Do
  Begin
    P := Kill.Items[i];
    Board.RemovePCBObject(P);
  End;
  Rep.Add('Mounting holes removed: ' + IntToStr(Kill.Count));
  Kill.Free;
End;

Procedure PlaceH4H5;
Var
  It : IPCB_BoardIterator;
  C, H4, H5 : IPCB_Component;
  R4, R5, RC : TCoordRect;
  Analog : Boolean;
  i : Integer;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  Analog := Pos('\ANALOG\', UpperCase(Board.FileName)) > 0;
  Rep := TStringList.Create;
  Names := TStringList.Create;
  SeedX := TStringList.Create;
  SeedY := TStringList.Create;
  SeedS := TStringList.Create;
  RL := -4.5; RR := 103.5; RB := 0.5;
  If Analog Then RT := 53.5 Else RT := 107.5;
  PCBServer.PreProcess;
  RemoveHoles;
  Rep.Add(PlaceHeader(Board, 'H4', 0.04, 27.54, 90, 20, Not Analog));
  Rep.Add(PlaceHeader(Board, 'H5', 98.96, 27.54, 90, 20, Not Analog));
  H4 := FindComp(Board, 'H4');
  H5 := FindComp(Board, 'H5');
  If (H4 = Nil) Or (H5 = Nil) Then
  Begin
    PCBServer.PostProcess;
    ShowMessage(Rep.Text);
    Exit;
  End;
  R4 := H4.BoundingRectangleNoNameComment;
  R5 := H5.BoundingRectangleNoNameComment;
  AddMove(1, 'H4', 0, 0);
  AddMove(1, 'H5', 0, 0);
  { parts that now collide with H4/H5 move to the nearest free spot }
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eComponentObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  C := It.FirstPCBObject;
  While C <> Nil Do
  Begin
    RC := C.BoundingRectangleNoNameComment;
    If (C.Name.Text <> 'H4') And (C.Name.Text <> 'H5') And (Overlap(RC, R4, CLR) Or Overlap(RC, R5, CLR)) Then
      If Copy(C.Name.Text, 1, 1) <> 'H' Then
        AddMove(SideOf(C), C.Name.Text, MX(C.X), MY(C.Y));
    C := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  If Analog Then
  Begin
  AddMove(0, 'IC6', 12, 30);
  AddMove(0, 'Q1', 12, 30);
  AddMove(0, 'Q2', 12, 30);
  AddMove(0, 'Q3', 12, 30);
  AddMove(0, 'Q4', 12, 30);
  AddMove(0, 'Q5', 12, 30);
  AddMove(0, 'Q6', 12, 30);
  AddMove(0, 'Q7', 12, 30);
  AddMove(0, 'Q8', 12, 30);
  AddMove(0, 'D3', 12, 30);
  AddMove(0, 'D4', 12, 30);
  AddMove(0, 'D5', 12, 30);
  AddMove(0, 'D6', 12, 30);
  AddMove(0, 'D7', 12, 30);
  AddMove(0, 'D8', 12, 30);
  AddMove(0, 'D9', 12, 30);
  AddMove(0, 'D10', 12, 30);
  AddMove(0, 'R28', 12, 30);
  AddMove(0, 'R29', 12, 30);
  AddMove(0, 'R30', 12, 30);
  AddMove(0, 'R31', 12, 30);
  AddMove(0, 'R32', 12, 30);
  AddMove(0, 'R33', 12, 30);
  AddMove(0, 'R34', 12, 30);
  AddMove(0, 'R35', 12, 30);
  AddMove(0, 'R36', 12, 30);
  AddMove(0, 'R37', 12, 30);
  AddMove(0, 'R38', 12, 30);
  AddMove(0, 'R39', 12, 30);
  AddMove(0, 'R40', 12, 30);
  AddMove(0, 'R41', 12, 30);
  AddMove(0, 'R42', 12, 30);
  AddMove(0, 'R43', 12, 30);
  AddMove(0, 'R44', 12, 30);
  AddMove(0, 'R45', 12, 30);
  AddMove(0, 'R46', 12, 30);
  AddMove(0, 'R47', 12, 30);
  AddMove(0, 'R48', 12, 30);
  AddMove(0, 'R49', 12, 30);
  AddMove(0, 'R50', 12, 30);
  AddMove(0, 'R51', 12, 30);
  AddMove(0, 'C34', 12, 30);
  AddMove(0, 'IC12', 88, 30);
  AddMove(0, 'IC13', 88, 30);
  AddMove(0, 'R1', 88, 30);
  AddMove(0, 'R80', 88, 30);
  AddMove(0, 'R81', 88, 30);
  AddMove(0, 'R82', 88, 30);
  AddMove(0, 'R83', 88, 30);
  AddMove(0, 'R84', 88, 30);
  AddMove(0, 'R85', 88, 30);
  AddMove(0, 'R86', 88, 30);
  AddMove(0, 'R87', 88, 30);
  AddMove(0, 'R88', 88, 30);
  AddMove(0, 'C60', 88, 30);
  AddMove(0, 'IC17', 80, 45);
  AddMove(0, 'R132', 80, 45);
  AddMove(0, 'R133', 80, 45);
  AddMove(0, 'R134', 80, 45);
  AddMove(0, 'R135', 80, 45);
  AddMove(0, 'R136', 80, 45);
  AddMove(0, 'R137', 80, 45);
  AddMove(0, 'R138', 80, 45);
  AddMove(0, 'R139', 80, 45);
  AddMove(0, 'C87', 80, 45);
  End;
  BuildGrid;
  For i := 2 To Names.Count - 1 Do
  Begin
    C := FindComp(Board, Names.Strings[i]);
    If C = Nil Then Rep.Add(Names.Strings[i] + ' not found')
    Else PlaceFree(C, StrToInt(SeedS.Strings[i]), StrToFloat(SeedX.Strings[i]), StrToFloat(SeedY.Strings[i]));
  End;
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  Rep.SaveToFile('C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\place_h4h5_report.txt');
  ShowMessage('Done, see Scripts\place_h4h5_report.txt. ' + IntToStr(Rep.Count) + ' lines.');
  Rep.Free;
  Names.Free;
  SeedX.Free;
  SeedY.Free;
  SeedS.Free;
End;
