{ Adds a low-noise LDO (U2 LP2985-50, +12 -> +5A) with C90 1uF in, C91 4.7uF out and C92 10nF bypass
  on DAC_LFO, and moves the DAC supplies onto +5A. Every pin gets a short stub with a power port or
  net label, so nothing has to be wired by hand.
  DAC_LFO active: run AddDacLdo. DAC_VOCT active: run DacVoctTo5A. Generated by Claude. }

Const
  LibPath = 'C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\IoT_SYNTHPATCH.SchLib';

Var
  Doc : ISch_Document;

Procedure Reg(O : ISch_GraphicalObject);
Begin
  Doc.RegisterSchObjectInContainer(O);
  SchServer.RobotManager.SendMessage(Doc.I_ObjectAddress, c_BroadCast, SCHM_PrimitiveRegistration, O.I_ObjectAddress);
End;

Function DirX(R : Integer) : Integer;
Begin
  Result := 0;
  If R = 0 Then Result := 1;
  If R = 2 Then Result := -1;
End;

Function DirY(R : Integer) : Integer;
Begin
  Result := 0;
  If R = 1 Then Result := 1;
  If R = 3 Then Result := -1;
End;

{ Stub of 100 mil out of the pin end, then a power port (or a net label for LDO_BP) at the stub end. }
Procedure Tie(P : ISch_Pin; Net : String);
Var
  R, X1, Y1, X2, Y2 : Integer;
  W  : ISch_Wire;
  PW : ISch_PowerObject;
  NL : ISch_NetLabel;
Begin
  R := P.Orientation;
  X1 := P.Location.X + DirX(R) * P.PinLength;
  Y1 := P.Location.Y + DirY(R) * P.PinLength;
  X2 := X1 + DirX(R) * MilsToCoord(100);
  Y2 := Y1 + DirY(R) * MilsToCoord(100);
  W := SchServer.SchObjectFactory(eWire, eCreate_Default);
  W.Location := Point(X1, Y1);
  W.InsertVertex := 1;
  W.SetState_Vertex(1, Point(X1, Y1));
  W.InsertVertex := 2;
  W.SetState_Vertex(2, Point(X2, Y2));
  W.LineWidth := eSmall;
  Reg(W);
  If Net = 'LDO_BP' Then
  Begin
    NL := SchServer.SchObjectFactory(eNetLabel, eCreate_Default);
    NL.Text := Net;
    NL.Location := Point(X2, Y2);
    Reg(NL);
  End
  Else
  Begin
    PW := SchServer.SchObjectFactory(ePowerObject, eCreate_Default);
    PW.Text := Net;
    If Net = 'GND' Then PW.Style := ePowerGndPower Else PW.Style := ePowerBar;
    PW.Orientation := R;
    PW.ShowNetName := True;
    PW.Location := Point(X2, Y2);
    Reg(PW);
  End;
End;

Function Place(LibRef, Des, Cmt, Fp : String; X, Y, Rot : Integer) : ISch_Component;
Var
  C  : ISch_Component;
  It : ISch_Iterator;
  Im : ISch_Implementation;
Begin
  C := SchServer.LoadComponentFromLibrary(LibRef, LibPath);
  Result := C;
  If C = Nil Then Exit;
  C.Location := Point(MilsToCoord(X), MilsToCoord(Y));
  C.Orientation := Rot;
  C.Designator.Text := Des;
  C.Comment.Text := Cmt;
  C.Comment.IsHidden := False;
  It := C.SchIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eImplementation));
  Im := It.FirstSchObject;
  While Im <> Nil Do
  Begin
    If UpperCase(Im.ModelType) = 'PCBLIB' Then
    Begin
      If Im.ModelName = Fp Then
      Begin
        Im.ClearAllDatafileLinks;
        Im.AddDataFileLink(Fp, '', 'PCBLIB');
        Im.IsCurrent := True;
      End
      Else Im.IsCurrent := False;
    End;
    Im := It.NextSchObject;
  End;
  C.SchIterator_Destroy(It);
  Reg(C);
End;

Procedure TiePins(C : ISch_Component; Nets : String);
{ Nets: 'pin=net;pin=net;' }
Var
  It : ISch_Iterator;
  P  : ISch_Pin;
  S, Key : String;
  k  : Integer;
Begin
  It := C.SchIterator_Create;
  It.AddFilter_ObjectSet(MkSet(ePin));
  P := It.FirstSchObject;
  While P <> Nil Do
  Begin
    If (P.OwnerPartId = C.CurrentPartID) And (P.OwnerPartDisplayMode = C.DisplayMode) Then
    Begin
      Key := ';' + P.Designator + '=';
      k := Pos(Key, ';' + Nets);
      If k > 0 Then
      Begin
        S := Copy(';' + Nets, k + Length(Key), 100);
        S := Copy(S, 1, Pos(';', S) - 1);
        Tie(P, S);
      End;
    End;
    P := It.NextSchObject;
  End;
  C.SchIterator_Destroy(It);
End;

Function SwapPort(X, Y : Integer) : Integer;
Var
  It : ISch_Iterator;
  PW : ISch_PowerObject;
Begin
  Result := 0;
  It := Doc.SchIterator_Create;
  It.AddFilter_ObjectSet(MkSet(ePowerObject));
  PW := It.FirstSchObject;
  While PW <> Nil Do
  Begin
    If (PW.Text = '+5') And (Abs(PW.Location.X - MilsToCoord(X)) < MilsToCoord(5)) And (Abs(PW.Location.Y - MilsToCoord(Y)) < MilsToCoord(5)) Then
    Begin
      SchServer.RobotManager.SendMessage(PW.I_ObjectAddress, c_BroadCast, SCHM_BeginModify, c_NoEventData);
      PW.Text := '+5A';
      SchServer.RobotManager.SendMessage(PW.I_ObjectAddress, c_BroadCast, SCHM_EndModify, c_NoEventData);
      Result := Result + 1;
    End;
    PW := It.NextSchObject;
  End;
  Doc.SchIterator_Destroy(It);
End;

Procedure AddDacLdo;
Var
  C : ISch_Component;
  N, M : Integer;
Begin
  Doc := SchServer.GetCurrentSchDocument;
  If (Doc = Nil) Or (Pos('DAC_LFO', UpperCase(Doc.DocumentName)) = 0) Then
  Begin
    ShowMessage('Make DAC_LFO.SchDoc active first.');
    Exit;
  End;
  SchServer.ProcessControl.PreProcess(Doc, '');
  M := 0;
  C := Place('CMP-12756-000035-1', 'U2', 'LP2985-50DBVR', 'FP-SOT25-IPC_A', 5300, 4000, 0);
  If C <> Nil Then Begin C.ComponentDescription := 'Low-noise LDO 5.0 V 150 mA, SOT-23-5 (DAC supply +5A)'; TiePins(C, '1=+12;3=+12;2=GND;4=LDO_BP;5=+5A;'); M := M + 1; End;
  C := Place('CAP', 'C90', '1uF', 'CAPC2013X145X48NL20T23', 5300, 2600, 1);
  If C <> Nil Then Begin TiePins(C, '2=+12;1=GND;'); M := M + 1; End;
  C := Place('CAP', 'C91', '4.7uF', 'CAPC2013X145X48NL20T23', 5900, 2600, 1);
  If C <> Nil Then Begin TiePins(C, '2=+5A;1=GND;'); M := M + 1; End;
  C := Place('CAP', 'C92', '10nF', 'CAPC2013X145X48NL20T23', 6500, 2600, 1);
  If C <> Nil Then Begin TiePins(C, '2=LDO_BP;1=GND;'); M := M + 1; End;
  N := SwapPort(1600, 10300) + SwapPort(1800, 6600);
  SchServer.ProcessControl.PostProcess(Doc, '');
  Doc.GraphicallyInvalidate;
  ShowMessage('Placed ' + IntToStr(M) + ' of 4 parts, moved ' + IntToStr(N) + ' of 2 DAC supply ports to +5A. Check the LDO block, then save.');
End;

Procedure DacVoctTo5A;
Var
  N : Integer;
Begin
  Doc := SchServer.GetCurrentSchDocument;
  If (Doc = Nil) Or (Pos('DAC_VOCT', UpperCase(Doc.DocumentName)) = 0) Then
  Begin
    ShowMessage('Make DAC_VOCT.SchDoc active first.');
    Exit;
  End;
  SchServer.ProcessControl.PreProcess(Doc, '');
  N := SwapPort(9200, 3700) + SwapPort(3700, 3400);
  SchServer.ProcessControl.PostProcess(Doc, '');
  Doc.GraphicallyInvalidate;
  ShowMessage('Moved ' + IntToStr(N) + ' of 2 supply ports (DAC8562 AVDD, CLR pull-up) to +5A. Save the sheet.');
End;
