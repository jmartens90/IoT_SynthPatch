{ POWER sheet: the wire from C5 to C6 also ran from (2950,6500) straight down to (2950,6200), through C6,
  shorting the AP2112K VOUT net to GND. This removes that last vertical segment. Generated by Claude.
  Run with POWER.SchDoc active: File > Run Script > FixVoutWire.pas > FixVoutWire. }
Procedure FixVoutWire;
Var
  Doc  : ISch_Document;
  Iter : ISch_Iterator;
  W    : ISch_Wire;
  Fixed : Integer;
Begin
  Doc := SchServer.GetCurrentSchDocument;
  If Doc = Nil Then Exit;
  Fixed := 0;
  SchServer.ProcessControl.PreProcess(Doc, '');
  Iter := Doc.SchIterator_Create;
  Iter.AddFilter_ObjectSet(MkSet(eWire));
  W := Iter.FirstSchObject;
  While W <> Nil Do
  Begin
    If (W.VerticesCount = 3) And
       (Round(CoordToMils(W.Vertex[1].X)) = 2700) And (Round(CoordToMils(W.Vertex[1].Y)) = 6500) And
       (Round(CoordToMils(W.Vertex[2].X)) = 2950) And (Round(CoordToMils(W.Vertex[2].Y)) = 6500) And
       (Round(CoordToMils(W.Vertex[3].X)) = 2950) And (Round(CoordToMils(W.Vertex[3].Y)) = 6200) Then
    Begin
      SchServer.RobotManager.SendMessage(W.I_ObjectAddress, c_BroadCast, SCHM_BeginModify, c_NoEventData);
      W.VerticesCount := 2;
      SchServer.RobotManager.SendMessage(W.I_ObjectAddress, c_BroadCast, SCHM_EndModify, c_NoEventData);
      Fixed := Fixed + 1;
    End;
    W := Iter.NextSchObject;
  End;
  Doc.SchIterator_Destroy(Iter);
  SchServer.ProcessControl.PostProcess(Doc, '');
  Doc.GraphicallyInvalidate;
  ShowMessage('Fixed ' + IntToStr(Fixed) + ' wire');
End;
