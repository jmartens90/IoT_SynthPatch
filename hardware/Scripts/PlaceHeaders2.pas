{ Places the 2x20 board-to-board headers H1 (left) and H2 (right) and the 1x14 H3, measured from the board
  outline, so it works wherever the board sits. Each header is turned until pads 1, 2 and 3 all land on their
  targets. Parts that collide with a header move to the nearest free spot; on the analog board the ADC parts
  (IC15, C67-C73, D12, D13, R123) are placed in free space on the bottom near the ADC amp.
  Main board: headers on the bottom (sockets). Analog board (path contains \ANALOG\): on top.
  Run with the PcbDoc active: File > Run Script > PlaceHeaders2.pas > PlaceHeaders2. Generated by Claude. }
Const
  CELL = 0.5;
  CLR = 0.25;
  KMAX = 230;
  RP = 'C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\place_headers2_report.txt';

Var
  Board : IPCB_Board;
  GX0, GY0 : Double;
  NX, NY : Integer;
  MinX, MinY, MaxX, MaxY : Double;
  PX, PY : Double;
  AL, AB, AR, AT, BL, BB, BR, BT, DL, DB, DR, DT : Double;
  RowsB, RowsT : TStringList;
  OnesStr : String;
  RL, RB, RR, RT : Double;
  Names, Rep : TStringList;
  SeedX, SeedY, SeedS : TStringList;
  BX, BY : Double;
  HL, HB, HR, HT : Double;

Function FindComp(Board : IPCB_Board; Des : String) : IPCB_Component;
Var
  It : IPCB_BoardIterator;
  C  : IPCB_Component;
Begin
  Result := Nil;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eComponentObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  C := It.FirstPCBObject;
  While C <> Nil Do
  Begin
    If C.Name.Text = Des Then Result := C;
    C := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
End;

Function Pad1(C : IPCB_Component) : IPCB_Pad;
Var
  GI : IPCB_GroupIterator;
  P  : IPCB_Pad;
Begin
  Result := Nil;
  GI := C.GroupIterator_Create;
  GI.AddFilter_ObjectSet(MkSet(ePadObject));
  P := GI.FirstPCBObject;
  While P <> Nil Do
  Begin
    If P.Name = '1' Then Result := P;
    P := GI.NextPCBObject;
  End;
  C.GroupIterator_Destroy(GI);
End;

Procedure PlaceOne(Board : IPCB_Board; C : IPCB_Component; X, Y, Rot : Double; Bottom : Boolean);
Begin
  PCBServer.SendMessageToRobots(C.I_ObjectAddress, c_Broadcast, PCBM_BeginModify, c_NoEventData);
  If Bottom Then C.Layer := eBottomLayer Else C.Layer := eTopLayer;
  C.Rotation := Rot;
  C.MoveToXY(Board.XOrigin + MMsToCoord(X), Board.YOrigin + MMsToCoord(Y));
  PCBServer.SendMessageToRobots(C.I_ObjectAddress, c_Broadcast, PCBM_EndModify, c_NoEventData);
End;

{ Places a header so that its pad 1 lands where pad 1 of the mating header on the other board is.
  Pad 1 target: rot 0 -> left end, rot 90 -> bottom end. Turns the part 180 deg if needed. }
Function PlaceHeader(Board : IPCB_Board; Des : String; X, Y, Rot : Double; N : Integer; Bottom : Boolean) : String;
Var
  C : IPCB_Component;
  P : IPCB_Pad;
  TX, TY, Half : Double;
Begin
  Result := Des + ' not found';
  C := FindComp(Board, Des);
  If C = Nil Then Exit;
  Half := (N - 1) * 2.54 / 2;
  If Rot = 0 Then Begin TX := X - Half; TY := Y; End Else Begin TX := X; TY := Y - Half; End;
  PlaceOne(Board, C, X, Y, Rot, Bottom);
  P := Pad1(C);
  If (Abs(CoordToMMs(P.X - Board.XOrigin) - TX) > 0.1) Or (Abs(CoordToMMs(P.Y - Board.YOrigin) - TY) > 0.1) Then
    PlaceOne(Board, C, X, Y, Rot + 180, Bottom);
  P := Pad1(C);
  Result := Des + ' pad 1 at ' + FloatToStrF(CoordToMMs(P.X - Board.XOrigin), ffFixed, 6, 2) + ', ' +
            FloatToStrF(CoordToMMs(P.Y - Board.YOrigin), ffFixed, 6, 2) + ' (target ' +
            FloatToStrF(TX, ffFixed, 6, 2) + ', ' + FloatToStrF(TY, ffFixed, 6, 2) + ')';
End;

Function MX(C : TCoord) : Double;
Begin
  Result := CoordToMMs(C - Board.XOrigin);
End;

Function MY(C : TCoord) : Double;
Begin
  Result := CoordToMMs(C - Board.YOrigin);
End;

Function F2(V : Double) : String;
Begin
  Result := FloatToStrF(V, ffFixed, 7, 2);
End;

Function Ones(N : Integer) : String;
Begin
  Result := Copy(OnesStr, 1, N);
End;

{ Grid rows are strings of '0'/'1', one per 0.5 mm row; RowsB = bottom side, RowsT = top side. }
Procedure Mark(Side : Integer; L, B, R, T : Double);
Var
  iy, x1, x2, y1, y2 : Integer;
  S : String;
Begin
  If (R < GX0) Or (T < GY0) Or (L > GX0 + NX * CELL) Or (B > GY0 + NY * CELL) Then Exit;
  x1 := Trunc((L - GX0) / CELL); If x1 < 0 Then x1 := 0;
  x2 := Trunc((R - GX0) / CELL); If x2 > NX - 1 Then x2 := NX - 1;
  y1 := Trunc((B - GY0) / CELL); If y1 < 0 Then y1 := 0;
  y2 := Trunc((T - GY0) / CELL); If y2 > NY - 1 Then y2 := NY - 1;
  For iy := y1 To y2 Do
  Begin
    If Side = 0 Then S := RowsB.Strings[iy] Else S := RowsT.Strings[iy];
    S := Copy(S, 1, x1) + Ones(x2 - x1 + 1) + Copy(S, x2 + 2, NX);
    If Side = 0 Then RowsB.Strings[iy] := S Else RowsT.Strings[iy] := S;
  End;
End;

Function IsFree(Side : Integer; L, B, R, T : Double) : Boolean;
Var
  iy, x1, x2, y1, y2 : Integer;
  S : String;
Begin
  Result := False;
  If (L < RL) Or (B < RB) Or (R > RR) Or (T > RT) Then Exit;
  x1 := Trunc((L - GX0) / CELL);
  x2 := Trunc((R - GX0) / CELL);
  y1 := Trunc((B - GY0) / CELL);
  y2 := Trunc((T - GY0) / CELL);
  For iy := y1 To y2 Do
  Begin
    If Side = 0 Then S := RowsB.Strings[iy] Else S := RowsT.Strings[iy];
    If Pos('1', Copy(S, x1 + 1, x2 - x1 + 1)) > 0 Then Exit;
  End;
  Result := True;
End;

Function SideOf(C : IPCB_Component) : Integer;
Begin
  If C.Layer = eBottomLayer Then Result := 0 Else Result := 1;
End;

Procedure MarkComp(C : IPCB_Component);
Var
  R : TCoordRect;
Begin
  R := C.BoundingRectangleNoNameComment;
  Mark(SideOf(C), MX(R.Left) - CLR, MY(R.Bottom) - CLR, MX(R.Right) + CLR, MY(R.Top) + CLR);
End;

Procedure BuildGrid;
Var
  It : IPCB_BoardIterator;
  C  : IPCB_Component;
  R  : TCoordRect;
  i  : Integer;
  Z  : String;
  L, B, RR2, T : Double;
Begin
  OnesStr := '';
  Z := '';
  For i := 1 To NX Do
  Begin
    OnesStr := OnesStr + '1';
    Z := Z + '0';
  End;
  RowsB := TStringList.Create;
  RowsT := TStringList.Create;
  For i := 0 To NY - 1 Do
  Begin
    RowsB.Add(Z);
    RowsT.Add(Z);
  End;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eComponentObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  C := It.FirstPCBObject;
  While C <> Nil Do
  Begin
    If Names.IndexOf(C.Name.Text) < 3 Then  { H1, H2, H3 are entries 0-2 }
    Begin
      R := C.BoundingRectangleNoNameComment;
      L := MX(R.Left) - CLR; B := MY(R.Bottom) - CLR; RR2 := MX(R.Right) + CLR; T := MY(R.Top) + CLR;
      Mark(SideOf(C), L, B, RR2, T);
      { through-hole headers and jumpers block both sides }
      If (Copy(C.Name.Text, 1, 1) = 'H') Or (Copy(C.Name.Text, 1, 1) = 'J') Then Mark(1 - SideOf(C), L, B, RR2, T);
    End;
    C := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
End;

Procedure SetPose(C : IPCB_Component; Side : Integer; Rot : Double);
Begin
  PCBServer.SendMessageToRobots(C.I_ObjectAddress, c_Broadcast, PCBM_BeginModify, c_NoEventData);
  If Side = 0 Then C.Layer := eBottomLayer Else C.Layer := eTopLayer;
  C.Rotation := Rot;
  PCBServer.SendMessageToRobots(C.I_ObjectAddress, c_Broadcast, PCBM_EndModify, c_NoEventData);
End;

{ Spiral search from (SX, SY) for the nearest spot where the part's body fits. Result in BX, BY. }
Function Search(C : IPCB_Component; Side : Integer; SX, SY : Double) : Boolean;
Var
  R : TCoordRect;
  el, eb, er, et, x, y : Double;
  k, i : Integer;
Begin
  Result := True;
  R := C.BoundingRectangleNoNameComment;
  el := MX(R.Left) - MX(C.X) - CLR;
  er := MX(R.Right) - MX(C.X) + CLR;
  eb := MY(R.Bottom) - MY(C.Y) - CLR;
  et := MY(R.Top) - MY(C.Y) + CLR;
  BX := SX; BY := SY;
  If IsFree(Side, SX + el, SY + eb, SX + er, SY + et) Then Exit;
  For k := 1 To KMAX Do
  Begin
    For i := -k To k Do
    Begin
      x := SX + i * CELL;
      y := SY - k * CELL;
      If IsFree(Side, x + el, y + eb, x + er, y + et) Then Begin BX := x; BY := y; Exit; End;
      y := SY + k * CELL;
      If IsFree(Side, x + el, y + eb, x + er, y + et) Then Begin BX := x; BY := y; Exit; End;
    End;
    For i := -k + 1 To k - 1 Do
    Begin
      y := SY + i * CELL;
      x := SX - k * CELL;
      If IsFree(Side, x + el, y + eb, x + er, y + et) Then Begin BX := x; BY := y; Exit; End;
      x := SX + k * CELL;
      If IsFree(Side, x + el, y + eb, x + er, y + et) Then Begin BX := x; BY := y; Exit; End;
    End;
  End;
  Result := False;
End;

Procedure PlaceFree(C : IPCB_Component; Side : Integer; SX, SY : Double);
Var
  r, s : Integer;
  Ok : Boolean;
Begin
  Ok := False;
  For s := 0 To 1 Do
  Begin
    If Not Ok Then
    For r := 0 To 1 Do
      If Not Ok Then
      Begin
        SetPose(C, Abs(Side - s), r * 90);
        If Search(C, Abs(Side - s), SX, SY) Then Ok := True;
      End;
  End;
  If Not Ok Then
  Begin
    Rep.Add(C.Name.Text + ': no free spot found, left where it was');
    Exit;
  End;
  PCBServer.SendMessageToRobots(C.I_ObjectAddress, c_Broadcast, PCBM_BeginModify, c_NoEventData);
  C.MoveToXY(Board.XOrigin + MMsToCoord(BX), Board.YOrigin + MMsToCoord(BY));
  PCBServer.SendMessageToRobots(C.I_ObjectAddress, c_Broadcast, PCBM_EndModify, c_NoEventData);
  MarkComp(C);
  If C.Layer = eBottomLayer Then
    Rep.Add(C.Name.Text + ' -> ' + F2(BX) + ', ' + F2(BY) + ' bottom rot ' + IntToStr(Round(C.Rotation)))
  Else
    Rep.Add(C.Name.Text + ' -> ' + F2(BX) + ', ' + F2(BY) + ' TOP rot ' + IntToStr(Round(C.Rotation)));
End;

Procedure AddMove(Side : Integer; Des : String; SX, SY : Double);
Begin
  If Names.IndexOf(Des) >= 0 Then Exit;
  Names.Add(Des);
  SeedX.Add(FloatToStr(SX));
  SeedY.Add(FloatToStr(SY));
  SeedS.Add(IntToStr(Side));
End;

{ Sets PX, PY to the position of pad Name (mm from the origin). }
Function PadXY(C : IPCB_Component; Name : String) : Boolean;
Var
  GI : IPCB_GroupIterator;
  P  : IPCB_Pad;
Begin
  Result := False;
  GI := C.GroupIterator_Create;
  GI.AddFilter_ObjectSet(MkSet(ePadObject));
  P := GI.FirstPCBObject;
  While P <> Nil Do
  Begin
    If P.Name = Name Then
    Begin
      PX := MX(P.X);
      PY := MY(P.Y);
      Result := True;
    End;
    P := GI.NextPCBObject;
  End;
  C.GroupIterator_Destroy(GI);
End;

{ Puts pad 1 on (X1, Y1) and turns the part until pad 2 is on (X2, Y2) and pad 3 on (X3, Y3). }
Function PlaceByPads(Des : String; X1, Y1, X2, Y2, X3, Y3 : Double; Bottom : Boolean) : String;
Var
  C : IPCB_Component;
  k : Integer;
  ax, ay, qx, qy, rx, ry : Double;
Begin
  Result := Des + ' not found';
  C := FindComp(Board, Des);
  If C = Nil Then Exit;
  Result := Des + ': no rotation puts pads 1-3 on target';
  For k := 0 To 3 Do
  Begin
    PCBServer.SendMessageToRobots(C.I_ObjectAddress, c_Broadcast, PCBM_BeginModify, c_NoEventData);
    If Bottom Then C.Layer := eBottomLayer Else C.Layer := eTopLayer;
    C.Rotation := 90 * k;
    PCBServer.SendMessageToRobots(C.I_ObjectAddress, c_Broadcast, PCBM_EndModify, c_NoEventData);
    PadXY(C, '1'); ax := PX; ay := PY;
    PCBServer.SendMessageToRobots(C.I_ObjectAddress, c_Broadcast, PCBM_BeginModify, c_NoEventData);
    C.MoveToXY(C.X + MMsToCoord(X1 - ax), C.Y + MMsToCoord(Y1 - ay));
    PCBServer.SendMessageToRobots(C.I_ObjectAddress, c_Broadcast, PCBM_EndModify, c_NoEventData);
    PadXY(C, '1'); ax := PX; ay := PY;
    PadXY(C, '2'); qx := PX; qy := PY;
    PadXY(C, '3'); rx := PX; ry := PY;
    If (Abs(ax - X1) < 0.1) And (Abs(ay - Y1) < 0.1) And (Abs(qx - X2) < 0.1) And (Abs(qy - Y2) < 0.1) And
       (Abs(rx - X3) < 0.1) And (Abs(ry - Y3) < 0.1) Then
    Begin
      Result := Des + ' rot ' + IntToStr(90 * k) + ', pad 1 at ' + F2(ax - MinX) + ', ' + F2(ay - MinY) + ' from the board corner';
      Exit;
    End;
  End;
End;

{ Reads the body rectangles of H1, H2, H3 into AL..AT, BL..BT, DL..DT (outside any board iteration). }
Procedure HeaderRects;
Var
  H : IPCB_Component;
  RC : TCoordRect;
Begin
  AL := 0; AR := 0; AB := 0; AT := 0; BL := 0; BR := 0; BB := 0; BT := 0; DL := 0; DR := 0; DB := 0; DT := 0;
  H := FindComp(Board, 'H1');
  If H <> Nil Then
  Begin
    RC := H.BoundingRectangleNoNameComment;
    AL := MX(RC.Left) - CLR; AR := MX(RC.Right) + CLR; AB := MY(RC.Bottom) - CLR; AT := MY(RC.Top) + CLR;
  End;
  H := FindComp(Board, 'H2');
  If H <> Nil Then
  Begin
    RC := H.BoundingRectangleNoNameComment;
    BL := MX(RC.Left) - CLR; BR := MX(RC.Right) + CLR; BB := MY(RC.Bottom) - CLR; BT := MY(RC.Top) + CLR;
  End;
  H := FindComp(Board, 'H3');
  If H <> Nil Then
  Begin
    RC := H.BoundingRectangleNoNameComment;
    DL := MX(RC.Left) - CLR; DR := MX(RC.Right) + CLR; DB := MY(RC.Bottom) - CLR; DT := MY(RC.Top) + CLR;
  End;
End;

{ Adds C to the parts to move when its body overlaps one of the headers. }
Procedure CheckAdd(C : IPCB_Component);
Var
  RC : TCoordRect;
  CL, CB, CR, CT : Double;
  Hit : Boolean;
Begin
  If Copy(C.Name.Text, 1, 1) = 'H' Then Exit;
  RC := C.BoundingRectangleNoNameComment;
  CL := MX(RC.Left); CR := MX(RC.Right); CB := MY(RC.Bottom); CT := MY(RC.Top);
  If (CR > MaxX + 1) Or (CL < MinX - 1) Or (CB < MinY - 1) Or (CT > MaxY + 1) Then Exit;
  Hit := (CL < AR) And (AL < CR) And (CB < AT) And (AB < CT);
  Hit := Hit Or ((CL < BR) And (BL < CR) And (CB < BT) And (BB < CT));
  Hit := Hit Or ((CL < DR) And (DL < CR) And (CB < DT) And (DB < CT));
  If Hit And (Copy(C.Name.Text, 1, 1) = 'J') Then
  Begin
    Rep.Add(C.Name.Text + ' overlaps a header, not moved (panel part)');
    Exit;
  End;
  If Hit Then AddMove(SideOf(C), C.Name.Text, MX(C.X), MY(C.Y));
End;

Procedure Save(T : String);
Begin
  Rep.Add(T);
  Rep.SaveToFile(RP);
End;

Procedure PlaceHeaders2;
Var
  It : IPCB_BoardIterator;
  C : IPCB_Component;
  RC : TCoordRect;
  Analog : Boolean;
  i : Integer;
  Y0, SX, SY : Double;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  Analog := Pos('\ANALOG\', UpperCase(Board.FileName)) > 0;
  Rep := TStringList.Create;
  Names := TStringList.Create;
  SeedX := TStringList.Create;
  SeedY := TStringList.Create;
  SeedS := TStringList.Create;
  RC := Board.BoardOutline.BoundingRectangle;
  MinX := MX(RC.Left); MaxX := MX(RC.Right); MinY := MY(RC.Bottom); MaxY := MY(RC.Top);
  Save('outline ' + F2(MinX) + '..' + F2(MaxX) + ' x ' + F2(MinY) + '..' + F2(MaxY));
  GX0 := MinX - 1; GY0 := MinY - 1;
  NX := Trunc((MaxX - MinX + 2) / CELL) + 1;
  NY := Trunc((MaxY - MinY + 2) / CELL) + 1;
  RL := MinX + 0.5; RR := MaxX - 0.5; RB := MinY + 0.5; RT := MaxY - 0.5;
  PCBServer.PreProcess;
  Y0 := MinY + 3.41;
  { H1: rows along Y at the left edge, odd pins in the outer column. H2: pad 1 in the inner column at the right. }
  Save(PlaceByPads('H1', MinX + 2.5, Y0, MinX + 5.04, Y0, MinX + 2.5, Y0 + 2.54, Not Analog));
  Save(PlaceByPads('H2', MaxX - 5.04, Y0, MaxX - 2.5, Y0, MaxX - 5.04, Y0 + 2.54, Not Analog));
  Save(PlaceByPads('H3', MinX + 43.49, MinY + 51.1, MinX + 46.03, MinY + 51.1, MinX + 48.57, MinY + 51.1, Not Analog));
  AddMove(1, 'H1', 0, 0);
  AddMove(1, 'H2', 0, 0);
  AddMove(1, 'H3', 0, 0);
  HeaderRects;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eComponentObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  C := It.FirstPCBObject;
  While C <> Nil Do
  Begin
    CheckAdd(C);
    C := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  If Analog Then
  Begin
    SX := MinX + 85; SY := MinY + 30;
    AddMove(0, 'IC15', SX, SY);
    AddMove(0, 'D12', SX, SY);
    AddMove(0, 'D13', SX, SY);
    AddMove(0, 'C67', SX, SY);
    AddMove(0, 'C68', SX, SY);
    AddMove(0, 'C69', SX, SY);
    AddMove(0, 'C70', SX, SY);
    AddMove(0, 'C71', SX, SY);
    AddMove(0, 'C72', SX, SY);
    AddMove(0, 'C73', SX, SY);
    AddMove(0, 'R123', SX, SY);
  End;
  Save('to place: ' + IntToStr(Names.Count - 3));
  BuildGrid;
  Save('grid built');
  For i := 3 To Names.Count - 1 Do
  Begin
    C := FindComp(Board, Names.Strings[i]);
    If C = Nil Then Rep.Add(Names.Strings[i] + ' not found')
    Else PlaceFree(C, StrToInt(SeedS.Strings[i]), StrToFloat(SeedX.Strings[i]), StrToFloat(SeedY.Strings[i]));
  End;
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  Save('done');
  ShowMessage('Done, see Scripts\place_headers2_report.txt (' + IntToStr(Rep.Count) + ' lines).');
End;
