Procedure SplitThisSheet;
Var
  Doc  : ISch_Document;
  L    : TStringList;
  Name : String;
Begin
  Doc := SchServer.GetCurrentSchDocument;
  If Doc = Nil Then
  Begin
    ShowMessage('Make the schematic sheet active first.');
    Exit;
  End;
  Name := UpperCase(ExtractFileName(Doc.DocumentName));
  L := TStringList.Create;
  If Name = 'DAC_LFO.SCHDOC' Then Data_DAC_LFO(L)
  Else If Name = 'DAC_VOCT.SCHDOC' Then Data_DAC_VOCT(L)
  Else If Name = 'ADC.SCHDOC' Then Data_ADC(L)
  Else If Name = 'LFO_AMPS.SCHDOC' Then Data_LFO_AMPS(L)
  Else If Name = 'VOCT_AMPS.SCHDOC' Then Data_VOCT_AMPS(L)
  Else If Name = 'ADC_AMPS.SCHDOC' Then Data_ADC_AMPS(L)
  Else
  Begin
    ShowMessage('No split data for ' + Name);
    L.Free;
    Exit;
  End;
  DoSplit(Doc, L);
  L.Free;
End;
