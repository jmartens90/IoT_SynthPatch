Procedure FixJackPads;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Begin ShowMessage('Open the main PcbDoc first'); Exit; End;
  Log := TStringList.Create;
  NDel := 0; NAdd := 0;
  PCBServer.PreProcess;
  Try
    Body;
  Finally
    PCBServer.PostProcess;
  End;
  Log.Add('deleted ' + IntToStr(NDel) + ', added ' + IntToStr(NAdd));
  Log.SaveToFile(ExtractFilePath(Board.FileName) + 'Scripts\fixjacks_log.txt');
  Board.ViewManager_FullUpdate;
  ShowMessage('FixJackPads done: deleted ' + IntToStr(NDel) + ', added ' + IntToStr(NAdd) + '. Log in Scripts\fixjacks_log.txt');
End;
