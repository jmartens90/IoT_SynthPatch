{ FixJackPads.pas - Thonkiconn PJ398SM tip/sleeve fix on the main board.
  For each jack: swaps pad names AND nets 1<->3 (signal now on the tip hole, GND on the sleeve hole),
  deletes the signal tracks that ran into the old sleeve hole, and adds a new route from the cut track
  to the tip hole. Coordinates are mm relative to each jack's origin. Generated by Claude. }
Var
  Board : IPCB_Board;
  Comp : IPCB_Component;
  CX, CY : TCoord;
  SigNet : IPCB_Net;
  Log : TStringList;
  NDel, NAdd : Integer;

Function FindComp(S : String) : IPCB_Component;
Var It : IPCB_BoardIterator; C : IPCB_Component;
Begin
  Result := Nil;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eComponentObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  C := It.FirstPCBObject;
  While C <> Nil Do
  Begin
    If UpperCase(C.Name.Text) = UpperCase(S) Then Result := C;
    C := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
End;

Function Prep(Des, NetName : String) : Boolean;
Var GIt : IPCB_GroupIterator; P, P1, P3 : IPCB_Pad; N1, N3 : IPCB_Net;
Begin
  Result := False;
  Comp := FindComp(Des);
  If Comp = Nil Then Begin Log.Add('ERROR no comp ' + Des); Exit; End;
  CX := Comp.X; CY := Comp.Y;
  P1 := Nil; P3 := Nil;
  GIt := Comp.GroupIterator_Create;
  GIt.AddFilter_ObjectSet(MkSet(ePadObject));
  P := GIt.FirstPCBObject;
  While P <> Nil Do
  Begin
    If P.Name = '1' Then P1 := P;
    If P.Name = '3' Then P3 := P;
    P := GIt.NextPCBObject;
  End;
  Comp.GroupIterator_Destroy(GIt);
  If (P1 = Nil) Or (P3 = Nil) Or (P1.Net = Nil) Or (P3.Net = Nil) Then Begin Log.Add('ERROR pads ' + Des); Exit; End;
  { expected: pad 1 (signal) at sleeve hole CY-6.48, pad 3 (GND) at tip hole CY+4.92 }
  If (Abs(P1.Y - (CY - MMsToCoord(6.48))) > MMsToCoord(0.05)) Or (Abs(P3.Y - (CY + MMsToCoord(4.92))) > MMsToCoord(0.05)) Or (Abs(P1.X - CX) > MMsToCoord(0.05)) Then
  Begin Log.Add('ERROR geometry/already fixed? ' + Des); Exit; End;
  If UpperCase(P1.Net.Name) <> UpperCase(NetName) Then Begin Log.Add('ERROR net ' + Des + ' ' + P1.Net.Name); Exit; End;
  N1 := P1.Net; N3 := P3.Net;
  P1.BeginModify; P3.BeginModify;
  P1.Name := '3'; P3.Name := '1';
  P1.Net := N3; P3.Net := N1;
  P1.EndModify; P3.EndModify;
  SigNet := N1;
  Log.Add(Des + ' pads swapped');
  Result := True;
End;

Procedure Del(Lay : TLayer; XA, YA, XB, YB : Double);
Var It : IPCB_BoardIterator; T : IPCB_Track; D : TCoord; AX, AY, BX, BY : TCoord; Found : IPCB_Track;
Begin
  AX := CX + MMsToCoord(XA); AY := CY + MMsToCoord(YA);
  BX := CX + MMsToCoord(XB); BY := CY + MMsToCoord(YB);
  D := MMsToCoord(0.02);
  Found := Nil;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eTrackObject));
  It.AddFilter_LayerSet(MkSet(Lay));
  It.AddFilter_Method(eProcessAll);
  T := It.FirstPCBObject;
  While T <> Nil Do
  Begin
    If (Not T.InPolygon) And (Not T.InComponent) And (T.Net = SigNet) Then
      If (((Abs(T.X1-AX)<D) And (Abs(T.Y1-AY)<D) And (Abs(T.X2-BX)<D) And (Abs(T.Y2-BY)<D)) Or
          ((Abs(T.X1-BX)<D) And (Abs(T.Y1-BY)<D) And (Abs(T.X2-AX)<D) And (Abs(T.Y2-AY)<D))) Then Found := T;
    T := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  If Found = Nil Then Log.Add('  WARN track not found ' + FloatToStr(XA) + ',' + FloatToStr(YA) + ' ' + FloatToStr(XB) + ',' + FloatToStr(YB))
  Else Begin Board.RemovePCBObject(Found); Inc(NDel); End;
End;

Procedure Trk(Lay : TLayer; XA, YA, XB, YB, W : Double);
Var T : IPCB_Track;
Begin
  If (Abs(XA-XB) < 0.0005) And (Abs(YA-YB) < 0.0005) Then Exit;
  T := PCBServer.PCBObjectFactory(eTrackObject, eNoDimension, eCreate_Default);
  T.X1 := CX + MMsToCoord(XA); T.Y1 := CY + MMsToCoord(YA);
  T.X2 := CX + MMsToCoord(XB); T.Y2 := CY + MMsToCoord(YB);
  T.Width := MMsToCoord(W);
  T.Layer := Lay;
  Board.AddPCBObject(T);
  SigNet.AddPCBObject(T);
  Inc(NAdd);
End;

Procedure Via(X, Y : Double);
Var V : IPCB_Via;
Begin
  V := PCBServer.PCBObjectFactory(eViaObject, eNoDimension, eCreate_Default);
  V.X := CX + MMsToCoord(X); V.Y := CY + MMsToCoord(Y);
  V.Size := MMsToCoord(0.6); V.HoleSize := MMsToCoord(0.3);
  V.LowLayer := eBottomLayer; V.HighLayer := eTopLayer;
  Board.AddPCBObject(V);
  SigNet.AddPCBObject(V);
  Inc(NAdd);
End;

