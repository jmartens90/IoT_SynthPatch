{ DAC_LFO sheet: puts the VREF_5 net label back on the wire of the VREF_5 port, so the port joins the
  VREF_5 net of the DACs (a port and a net label only join when they sit on the same wire).
  Run with DAC_LFO.SchDoc active. Generated by Claude. }

Procedure FixVref5Lfo;
Var
  Doc : ISch_Document;
  N   : ISch_NetLabel;
Begin
  Doc := SchServer.GetCurrentSchDocument;
  If Doc = Nil Then Exit;
  If Pos('DAC_LFO', UpperCase(Doc.DocumentName)) = 0 Then
  Begin
    ShowMessage('Make the DAC_LFO sheet active first.');
    Exit;
  End;
  SchServer.ProcessControl.PreProcess(Doc, '');
  N := SchServer.SchObjectFactory(eNetLabel, eCreate_Default);
  N.Text := 'VREF_5';
  N.Location := Point(MilsToCoord(2300), MilsToCoord(3350));
  Doc.RegisterSchObjectInContainer(N);
  SchServer.RobotManager.SendMessage(Doc.I_ObjectAddress, c_BroadCast, SCHM_PrimitiveRegistration, N.I_ObjectAddress);
  SchServer.ProcessControl.PostProcess(Doc, '');
  Doc.GraphicallyInvalidate;
  ShowMessage('VREF_5 net label added at the port. Save the sheet.');
End;
