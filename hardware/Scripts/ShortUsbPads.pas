{ ShortUsbPads.pas - run with IoT_SYNTHPATCH.PcbLib active. Shortens the 12 SMD pads of
  USB_C_HRO_TYPE-C-31-M-12 from 1.45 to 1.10 mm (same as the old Molex footprint), so the existing
  USB routing between the pad rows keeps its clearance. Generated by Claude. }
Procedure ShortUsbPads;
Var Lib : IPCB_Library; Fp : IPCB_LibComponent; GIt : IPCB_GroupIterator; P : IPCB_Pad; L : TStringList; N : Integer;
Begin
  L := TStringList.Create; N := 0;
  Lib := PCBServer.GetCurrentPCBLibrary;
  If Lib = Nil Then Begin L.Add('ERROR no PcbLib active'); End
  Else
  Begin
    Fp := Lib.GetComponentByName('USB_C_HRO_TYPE-C-31-M-12');
    If Fp = Nil Then L.Add('ERROR footprint not found')
    Else
    Begin
      PCBServer.PreProcess;
      GIt := Fp.GroupIterator_Create; GIt.AddFilter_ObjectSet(MkSet(ePadObject));
      P := GIt.FirstPCBObject;
      While P <> Nil Do
      Begin
        If (P.HoleSize = 0) And (Abs(P.TopYSize - MMsToCoord(1.45)) < MMsToCoord(0.02)) Then
        Begin
          P.BeginModify;
          P.TopYSize := MMsToCoord(1.1); P.MidYSize := MMsToCoord(1.1); P.BotYSize := MMsToCoord(1.1);
          P.EndModify;
          Inc(N);
          L.Add('pad ' + P.Name + ' -> 1.1');
        End;
        P := GIt.NextPCBObject;
      End;
      Fp.GroupIterator_Destroy(GIt);
      PCBServer.PostProcess;
      Lib.RefreshView;
    End;
  End;
  L.Add('changed ' + IntToStr(N));
  L.SaveToFile('C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\shortusb_log.txt');
End;
