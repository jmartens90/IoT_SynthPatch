{ Adds a Power Plane Connect rule "PlaneConnect_Vias" (scope IsVia, direct connect) with top
  priority, so stitching vias tie solidly into the GND plane instead of thermal reliefs that the
  header antipads starve. Undo by deleting the rule in Design > Rules. Generated by Claude. }
Procedure ViaDirectPlane;
Var
  Board : IPCB_Board;
  R : IPCB_PowerPlaneConnectStyleRule;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  PCBServer.PreProcess;
  R := PCBServer.PCBRuleFactory(eRule_PowerPlaneConnectStyle);
  R.Name := 'PlaneConnect_Vias';
  R.Comment := 'Stitching vias direct to plane';
  R.Scope1Expression := 'IsVia';
  R.PlaneConnectStyle := eDirectConnectToPlane;
  Board.AddPCBObject(R);
  R.Priority := 1;
  PCBServer.PostProcess;
  ShowMessage('Rule ' + R.Name + ' added, priority ' + IntToStr(R.Priority));
End;
