{ Turns a copy of the main PcbDoc into the analog board: deletes every component that is not an analog-board
  part, all copper (tracks, arcs, vias, polygons, fills, regions, free pads) and cuts the outline from
  108 mm to 54 mm tall (outline vertices, Mech1 and plane edge lines). Afterwards run SelectMechOutline and
  Design > Board Shape > Define Board Shape from Selected Objects.
  Run with IoT_SYNTHPATCH_ANALOG.PcbDoc active: File > Run Script > ClearAnalogBoard.pas > ClearAnalogBoard. Generated by Claude. }
Procedure ClearAnalogBoard;
Var
  Board : IPCB_Board;
  It    : IPCB_BoardIterator;
  O     : IPCB_Primitive;
  Kill, Edge : TInterfaceList;
  Keep  : TStringList;
  BO    : IPCB_BoardOutline;
  Seg   : TPolySegment;
  T     : IPCB_Track;
  i, YT, YN, Tol, nV : Integer;
  IsSig : Boolean;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  If Pos('ANALOG', UpperCase(Board.FileName)) = 0 Then
  Begin
    ShowMessage('This is not the analog board. Open IoT_SYNTHPATCH_ANALOG.PcbDoc.');
    Exit;
  End;
  Keep := TStringList.Create;
  Keep.Sorted := True;
  Keep.Add('C30');
  Keep.Add('C31');
  Keep.Add('C32');
  Keep.Add('C33');
  Keep.Add('C35');
  Keep.Add('C36');
  Keep.Add('C44');
  Keep.Add('C45');
  Keep.Add('C46');
  Keep.Add('C47');
  Keep.Add('C48');
  Keep.Add('C49');
  Keep.Add('C50');
  Keep.Add('C51');
  Keep.Add('C52');
  Keep.Add('C53');
  Keep.Add('C54');
  Keep.Add('C55');
  Keep.Add('C56');
  Keep.Add('C57');
  Keep.Add('C58');
  Keep.Add('C59');
  Keep.Add('C74');
  Keep.Add('C75');
  Keep.Add('C76');
  Keep.Add('C77');
  Keep.Add('C78');
  Keep.Add('C79');
  Keep.Add('C80');
  Keep.Add('C81');
  Keep.Add('IC16');
  Keep.Add('IC5');
  Keep.Add('IC8');
  Keep.Add('IC9');
  Keep.Add('J25');
  Keep.Add('J27');
  Keep.Add('J29');
  Keep.Add('J30');
  Keep.Add('R102');
  Keep.Add('R103');
  Keep.Add('R108');
  Keep.Add('R109');
  Keep.Add('R114');
  Keep.Add('R115');
  Keep.Add('R124');
  Keep.Add('R125');
  Keep.Add('R126');
  Keep.Add('R127');
  Keep.Add('R128');
  Keep.Add('R129');
  Keep.Add('R130');
  Keep.Add('R131');
  Keep.Add('R20');
  Keep.Add('R21');
  Keep.Add('R22');
  Keep.Add('R23');
  Keep.Add('R24');
  Keep.Add('R25');
  Keep.Add('R26');
  Keep.Add('R27');
  Keep.Add('R52');
  Keep.Add('R53');
  Keep.Add('R54');
  Keep.Add('R55');
  Keep.Add('R56');
  Keep.Add('R57');
  Keep.Add('R58');
  Keep.Add('R59');
  Keep.Add('R60');
  Keep.Add('R61');
  Keep.Add('R62');
  Keep.Add('R63');
  Keep.Add('R64');
  Keep.Add('R65');
  Keep.Add('R66');
  Keep.Add('R67');
  Keep.Add('R68');
  Keep.Add('R69');
  Keep.Add('R70');
  Keep.Add('R71');
  Keep.Add('R72');
  Keep.Add('R73');
  Keep.Add('R74');
  Keep.Add('R75');
  Keep.Add('R96');
  Keep.Add('R97');
  YT := Board.YOrigin + MMsToCoord(108);
  YN := Board.YOrigin + MMsToCoord(54);
  Tol := MMsToCoord(0.05);
  Kill := TInterfaceList.Create;
  Edge := TInterfaceList.Create;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eComponentObject, eTrackObject, eArcObject, eViaObject, ePolyObject, eFillObject, eRegionObject, ePadObject, eTextObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  O := It.FirstPCBObject;
  While O <> Nil Do
  Begin
    If O.ObjectId = eComponentObject Then
    Begin
      If Keep.IndexOf(O.Name.Text) < 0 Then Kill.Add(O);
    End
    Else If O.InComponent Then
    Begin
    End
    Else
    Begin
      IsSig := (O.Layer = eTopLayer) Or (O.Layer = eBottomLayer) Or (O.Layer = eMultiLayer) Or
               (O.Layer = eMidLayer1) Or (O.Layer = eMidLayer2) Or (O.Layer = eTopOverlay) Or (O.Layer = eBottomOverlay);
      If (O.ObjectId = eViaObject) Or (O.ObjectId = ePolyObject) Or (O.ObjectId = ePadObject) Or IsSig Then
        Kill.Add(O)
      Else If O.ObjectId = eTrackObject Then
        Edge.Add(O);
    End;
    O := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);

  PCBServer.PreProcess;
  For i := 0 To Kill.Count - 1 Do
  Begin
    O := Kill.Items[i];
    Board.RemovePCBObject(O);
  End;
  For i := 0 To Edge.Count - 1 Do
  Begin
    T := Edge.Items[i];
    PCBServer.SendMessageToRobots(T.I_ObjectAddress, c_Broadcast, PCBM_BeginModify, c_NoEventData);
    If Abs(T.Y1 - YT) < Tol Then T.Y1 := YN;
    If Abs(T.Y2 - YT) < Tol Then T.Y2 := YN;
    PCBServer.SendMessageToRobots(T.I_ObjectAddress, c_Broadcast, PCBM_EndModify, c_NoEventData);
  End;
  nV := 0;
  BO := Board.BoardOutline;
  BO.BeginModify;
  For i := 0 To BO.PointCount - 1 Do
  Begin
    Seg := BO.Segments[i];
    If Abs(Seg.vy - YT) < Tol Then Begin Seg.vy := YN; nV := nV + 1; End;
    BO.Segments[i] := Seg;
  End;
  BO.EndModify;
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  ShowMessage('Removed ' + IntToStr(Kill.Count) + ' objects, moved ' + IntToStr(nV) + ' outline vertices and ' + IntToStr(Edge.Count) + ' edge lines checked.');
  Kill.Free;
  Edge.Free;
  Keep.Free;
End;
