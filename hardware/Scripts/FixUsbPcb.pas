{ FixUsbPcb.pas - run on the main PcbDoc after J1 got the HRO footprint.
  Removes GND vias that sit inside J1's shell-leg holes and narrows the +3.3 PWR-layer track that
  passes J1's leg 1 from 2.0 to 1.4 mm. Generated by Claude. }
Procedure FixUsbPcb;
Var Board : IPCB_Board; It : IPCB_BoardIterator; GIt : IPCB_GroupIterator;
  C, J1 : IPCB_Component; P : IPCB_Pad; V : IPCB_Via; T : IPCB_Track;
  Pads, Kill : TInterfaceList; i, k : Integer; R, Dd : Double; L : TStringList; W : IPCB_Track;
  AX, AY, BX, BY, D : TCoord;
Begin
  L := TStringList.Create;
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  J1 := Nil;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eComponentObject)); It.AddFilter_LayerSet(AllLayers); It.AddFilter_Method(eProcessAll);
  C := It.FirstPCBObject;
  While C <> Nil Do Begin If C.Name.Text = 'J1' Then J1 := C; C := It.NextPCBObject; End;
  Board.BoardIterator_Destroy(It);
  If J1 = Nil Then Begin L.Add('ERROR no J1'); L.SaveToFile('C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\fixusb_log.txt'); Exit; End;
  Pads := TInterfaceList.Create; Kill := TInterfaceList.Create;
  GIt := J1.GroupIterator_Create; GIt.AddFilter_ObjectSet(MkSet(ePadObject));
  P := GIt.FirstPCBObject;
  While P <> Nil Do Begin If P.HoleSize > 0 Then Pads.Add(P); P := GIt.NextPCBObject; End;
  J1.GroupIterator_Destroy(GIt);
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eViaObject)); It.AddFilter_LayerSet(AllLayers); It.AddFilter_Method(eProcessAll);
  V := It.FirstPCBObject;
  While V <> Nil Do
  Begin
    For i := 0 To Pads.Count - 1 Do
    Begin
      P := Pads.Items[i];
      R := CoordToMMs(Max(P.TopXSize, P.TopYSize)) / 2 + CoordToMMs(V.Size) / 2 + 0.2;
      Dd := Sqrt(Sqr(CoordToMMs(V.X - P.X)) + Sqr(CoordToMMs(V.Y - P.Y)));
      If (Dd < R) And (Kill.IndexOf(V) < 0) Then Kill.Add(V);
    End;
    V := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  { +3.3 track on the PWR layer: J1-relative (-10.914,-5.072)-(-1.375,-5.072) }
  AX := J1.X + MMsToCoord(-10.914); AY := J1.Y + MMsToCoord(-5.072);
  BX := J1.X + MMsToCoord(-1.375);  BY := J1.Y + MMsToCoord(-5.072);
  D := MMsToCoord(0.05); W := Nil;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eTrackObject)); It.AddFilter_LayerSet(AllLayers); It.AddFilter_Method(eProcessAll);
  T := It.FirstPCBObject;
  While T <> Nil Do
  Begin
    If (T.Net <> Nil) And (T.Net.Name = '+3.3') And (T.Width > MMsToCoord(1.5)) Then
      If ((Abs(T.X1-AX)<D) And (Abs(T.Y1-AY)<D) And (Abs(T.X2-BX)<D) And (Abs(T.Y2-BY)<D)) Or
         ((Abs(T.X1-BX)<D) And (Abs(T.Y1-BY)<D) And (Abs(T.X2-AX)<D) And (Abs(T.Y2-AY)<D)) Then W := T;
    T := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  PCBServer.PreProcess;
  For k := 0 To Kill.Count - 1 Do
  Begin
    V := Kill.Items[k];
    If V.Net <> Nil Then L.Add('removed via ' + V.Net.Name + ' at ' + FloatToStr(CoordToMMs(V.X - J1.X)) + ', ' + FloatToStr(CoordToMMs(V.Y - J1.Y)))
    Else L.Add('removed via (no net)');
    Board.RemovePCBObject(V);
  End;
  If W = Nil Then L.Add('WARN +3.3 PWR track not found')
  Else Begin W.BeginModify; W.Width := MMsToCoord(1.4); W.EndModify; L.Add('+3.3 PWR track narrowed to 1.4 mm on layer ' + IntToStr(W.Layer)); End;
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  L.SaveToFile('C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\fixusb_log.txt');
End;
