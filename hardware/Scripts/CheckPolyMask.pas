{ Read-only: reports each polygon's solder mask expansion mode (0 = no mask opening,
  1 = by rule, 2 = manual) and one GND track's mode for comparison. Generated by Claude. }
Procedure CheckPolyMask;
Var
  Board : IPCB_Board;
  It : IPCB_BoardIterator;
  P : IPCB_Polygon;
  S : String;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  S := '';
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(ePolyObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  P := It.FirstPCBObject;
  While P <> Nil Do
  Begin
    S := S + P.Name + ' (' + Layer2String(P.Layer) + '): mode ' + IntToStr(P.SolderMaskExpansionMode) + #13#10;
    P := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  ShowMessage(S);
End;
