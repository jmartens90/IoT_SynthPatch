{ IoT_SYNTHPATCH - component placement script (generated by Claude).
  Open IoT_SYNTHPATCH.PcbDoc, then File > Run Script > PlaceComponents.pas > PlaceAll.
  Coordinates are in micrometres relative to the board origin. Undo with Ctrl+Z. }

Function Fld(S : String; Idx : Integer) : Integer;
Var
  i, p : Integer;
  T    : String;
Begin
  T := S + ';';
  For i := 1 To Idx Do
  Begin
    p := Pos(';', T);
    T := Copy(T, p + 1, Length(T));
  End;
  p := Pos(';', T);
  Result := StrToInt(Copy(T, 1, p - 1));
End;

Procedure AddLabel(Board : IPCB_Board; Txt : String; X : Integer; Y : Integer);
Var
  T : IPCB_Text;
Begin
  T := PCBServer.PCBObjectFactory(eTextObject, eNoDimension, eCreate_Default);
  T.XLocation := Board.XOrigin + MMsToCoord(X / 1000);
  T.YLocation := Board.YOrigin + MMsToCoord(Y / 1000);
  T.Layer     := eMechanical1;
  T.Size      := MMsToCoord(2.5);
  T.Width     := MMsToCoord(0.25);
  T.Text      := Txt;
  Board.AddPCBObject(T);
  PCBServer.SendMessageToRobots(Board.I_ObjectAddress, c_Broadcast, PCBM_BoardRegisteration, T.I_ObjectAddress);
End;

