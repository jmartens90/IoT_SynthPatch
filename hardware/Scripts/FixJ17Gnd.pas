{ FixJ17Gnd.pas - J17's tip hole is now OUT_J17, but an old GND track (Q17 emitter) still ran into it.
  Removes that GND track chain and gives Q17-2 its own GND via (0.5/0.25 mm) to the GND plane.
  Coordinates in mm from the board origin (as in rp2_main.txt). Generated by Claude. }
Var Board : IPCB_Board; L : TStringList; GndNet : IPCB_Net; NDel : Integer;

Procedure DelT(XA, YA, XB, YB : Double);
Var It : IPCB_BoardIterator; T, Found : IPCB_Track; AX, AY, BX, BY, D : TCoord;
Begin
  AX := Board.XOrigin + MMsToCoord(XA); AY := Board.YOrigin + MMsToCoord(YA);
  BX := Board.XOrigin + MMsToCoord(XB); BY := Board.YOrigin + MMsToCoord(YB);
  D := MMsToCoord(0.01); Found := Nil;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eTrackObject)); It.AddFilter_LayerSet(MkSet(eBottomLayer)); It.AddFilter_Method(eProcessAll);
  T := It.FirstPCBObject;
  While T <> Nil Do
  Begin
    If (T.Net <> Nil) And (T.Net.Name = 'GND') And (Not T.InPolygon) Then
      If ((Abs(T.X1-AX)<D) And (Abs(T.Y1-AY)<D) And (Abs(T.X2-BX)<D) And (Abs(T.Y2-BY)<D)) Or
         ((Abs(T.X1-BX)<D) And (Abs(T.Y1-BY)<D) And (Abs(T.X2-AX)<D) And (Abs(T.Y2-AY)<D)) Then Found := T;
    T := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  If Found = Nil Then L.Add('WARN not found ' + FloatToStr(XA) + ',' + FloatToStr(YA))
  Else Begin GndNet := Found.Net; Board.RemovePCBObject(Found); Inc(NDel); End;
End;

Procedure FixJ17Gnd;
Var T : IPCB_Track; V : IPCB_Via;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  L := TStringList.Create; NDel := 0; GndNet := Nil;
  PCBServer.PreProcess;
  DelT(-236.223, -512.371, -234.117, -512.371);
  DelT(-234.117, -512.371, -233.863, -512.116);
  DelT(-233.863, -512.116, -231.845, -512.116);
  DelT(-231.845, -512.116, -231.737, -512.008);
  DelT(-231.737, -512.008, -230.957, -512.008);
  If GndNet <> Nil Then
  Begin
    V := PCBServer.PCBObjectFactory(eViaObject, eNoDimension, eCreate_Default);
    V.X := Board.XOrigin + MMsToCoord(-231.55); V.Y := Board.YOrigin + MMsToCoord(-512.0);
    V.Size := MMsToCoord(0.5); V.HoleSize := MMsToCoord(0.25);
    V.LowLayer := eBottomLayer; V.HighLayer := eTopLayer;
    Board.AddPCBObject(V); GndNet.AddPCBObject(V);
    T := PCBServer.PCBObjectFactory(eTrackObject, eNoDimension, eCreate_Default);
    T.X1 := Board.XOrigin + MMsToCoord(-231.55); T.Y1 := Board.YOrigin + MMsToCoord(-512.0);
    T.X2 := Board.XOrigin + MMsToCoord(-230.957); T.Y2 := Board.YOrigin + MMsToCoord(-512.008);
    T.Width := MMsToCoord(0.254); T.Layer := eBottomLayer;
    Board.AddPCBObject(T); GndNet.AddPCBObject(T);
    L.Add('added GND via + track');
  End;
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  L.Add('deleted ' + IntToStr(NDel));
  L.SaveToFile('C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\fixj17_log.txt');
End;
