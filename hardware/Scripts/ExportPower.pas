{ Read-only. Exports everything on the power nets (+3.3, +5, +5A, +5_USB, +12, -12, VREF_5, VBUS, GND and
  the *_IN nets): tracks with layer and width, vias with size and hole, polygons, power pads, and the
  ratsnest connections still open. mm from the board outline's bottom-left corner.
  Writes Scripts\power_export.txt. Generated by Claude. }
Function MM(C : TCoord) : String;
Begin
  Result := FloatToStrF(CoordToMMs(C), ffFixed, 8, 3);
End;

Function IsPwr(S : String) : Boolean;
Begin
  S := UpperCase(S);
  Result := (S = '+3.3') Or (S = '+5') Or (S = '+5A') Or (S = '+5_USB') Or (S = '+12') Or (S = '-12') Or
            (S = 'VREF_5') Or (S = 'VBUS') Or (S = 'GND') Or (Pos('_IN', S) > 0) Or (Pos('12', S) > 0);
End;

Procedure ExportPower;
Var
  Board : IPCB_Board;
  It : IPCB_BoardIterator;
  O : IPCB_Primitive;
  T : IPCB_Track;
  V : IPCB_Via;
  P : IPCB_Pad;
  Pg : IPCB_Polygon;
  Cn : IPCB_Connection;
  L : TStringList;
  RC : TCoordRect;
  X0, Y0 : TCoord;
  N, CN2 : String;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  RC := Board.BoardOutline.BoundingRectangle;
  X0 := RC.Left;
  Y0 := RC.Bottom;
  L := TStringList.Create;
  L.Add('B;' + MM(RC.Right - RC.Left) + ';' + MM(RC.Top - RC.Bottom));

  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eTrackObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  T := It.FirstPCBObject;
  While T <> Nil Do
  Begin
    If (T.Net <> Nil) And (Not T.InPolygon) And (Not T.InComponent) Then
      If IsPwr(T.Net.Name) Then
        L.Add('T;' + T.Net.Name + ';' + Layer2String(T.Layer) + ';' + MM(T.Width) + ';' + MM(T.X1 - X0) + ';' +
              MM(T.Y1 - Y0) + ';' + MM(T.X2 - X0) + ';' + MM(T.Y2 - Y0));
    T := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);

  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eViaObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  V := It.FirstPCBObject;
  While V <> Nil Do
  Begin
    If V.Net <> Nil Then
      If IsPwr(V.Net.Name) Then
        L.Add('V;' + V.Net.Name + ';' + MM(V.Size) + ';' + MM(V.HoleSize) + ';' + MM(V.X - X0) + ';' + MM(V.Y - Y0));
    V := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);

  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(ePadObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  P := It.FirstPCBObject;
  While P <> Nil Do
  Begin
    If (P.Net <> Nil) And (P.Component <> Nil) Then
      If IsPwr(P.Net.Name) Then
        L.Add('P;' + P.Component.Name.Text + ';' + P.Name + ';' + P.Net.Name + ';' + Layer2String(P.Layer) + ';' +
              MM(P.X - X0) + ';' + MM(P.Y - Y0));
    P := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);

  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(ePolyObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  Pg := It.FirstPCBObject;
  While Pg <> Nil Do
  Begin
    If Pg.Net = Nil Then N := '' Else N := Pg.Net.Name;
    RC := Pg.BoundingRectangle;
    L.Add('G;' + Pg.Name + ';' + N + ';' + Layer2String(Pg.Layer) + ';' + MM(RC.Left - X0) + ';' + MM(RC.Bottom - Y0) + ';' +
          MM(RC.Right - X0) + ';' + MM(RC.Top - Y0));
    Pg := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);

  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eConnectionObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  Cn := It.FirstPCBObject;
  While Cn <> Nil Do
  Begin
    If Cn.Net <> Nil Then
      If IsPwr(Cn.Net.Name) Then
        L.Add('R;' + Cn.Net.Name + ';' + MM(Cn.X1 - X0) + ';' + MM(Cn.Y1 - Y0) + ';' + MM(Cn.X2 - X0) + ';' + MM(Cn.Y2 - Y0));
    Cn := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);

  L.SaveToFile('C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\power_export.txt');
  ShowMessage('Wrote Scripts\power_export.txt (' + IntToStr(L.Count) + ' lines).');
  L.Free;
End;
