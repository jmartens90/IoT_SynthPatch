{ Main board: places the DAC LDO U2 (LP2985-50) and C90-C92 on the bottom side next to the DACs.
  Run with IoT_SYNTHPATCH.PcbDoc active. Generated by Claude. }

Function Fld(S : String; Idx : Integer) : String;
Var
  i, n : Integer;
Begin
  Result := '';
  n := 0;
  For i := 1 To Length(S) Do
  Begin
    If S[i] = ';' Then n := n + 1
    Else If n = Idx Then Result := Result + S[i];
  End;
End;

Function Num(S : String) : Double;
Begin
  Result := StrToInt(S) / 1000;  { values in micrometres: no decimal separator, so the Dutch locale can't trip it }
End;

Function FindComp(Board : IPCB_Board; Des : String) : IPCB_Component;
Var
  It : IPCB_BoardIterator;
  C  : IPCB_Component;
Begin
  Result := Nil;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eComponentObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  C := It.FirstPCBObject;
  While C <> Nil Do
  Begin
    If C.Name.Text = Des Then Result := C;
    C := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
End;

Function Pad1(C : IPCB_Component) : IPCB_Pad;
Var
  GI : IPCB_GroupIterator;
  P  : IPCB_Pad;
Begin
  Result := Nil;
  GI := C.GroupIterator_Create;
  GI.AddFilter_ObjectSet(MkSet(ePadObject));
  P := GI.FirstPCBObject;
  While P <> Nil Do
  Begin
    If P.Name = '1' Then Result := P;
    P := GI.NextPCBObject;
  End;
  C.GroupIterator_Destroy(GI);
End;

Procedure PlaceOne(Board : IPCB_Board; C : IPCB_Component; X, Y, Rot : Double; Bottom : Boolean);
Begin
  PCBServer.SendMessageToRobots(C.I_ObjectAddress, c_Broadcast, PCBM_BeginModify, c_NoEventData);
  If Bottom Then C.Layer := eBottomLayer Else C.Layer := eTopLayer;
  C.Rotation := Rot;
  C.MoveToXY(Board.XOrigin + MMsToCoord(X), Board.YOrigin + MMsToCoord(Y));
  PCBServer.SendMessageToRobots(C.I_ObjectAddress, c_Broadcast, PCBM_EndModify, c_NoEventData);
End;

Procedure PlaceLdo;
Var
  Board : IPCB_Board;
  C     : IPCB_Component;
  L     : TStringList;
  S     : String;
  i, N  : Integer;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  N := 0;
  L := TStringList.Create;
  L.Add('U2;38000;62000;0');
  L.Add('C90;38000;59300;0');
  L.Add('C91;38000;64800;0');
  L.Add('C92;38000;66700;0');
  PCBServer.PreProcess;
  For i := 0 To L.Count - 1 Do
  Begin
    S := L.Strings[i];
    C := FindComp(Board, Fld(S, 0));
    If C <> Nil Then Begin PlaceOne(Board, C, Num(Fld(S, 1)), Num(Fld(S, 2)), Num(Fld(S, 3)), True); N := N + 1; End;
  End;
  PCBServer.PostProcess;
  L.Free;
  Board.ViewManager_FullUpdate;
  ShowMessage('Placed ' + IntToStr(N) + ' of 4 LDO parts on the bottom, between SW6 and SW7 next to the DACs.');
End;
