{ Applies Scripts\silk_plan.txt (designator;centre x;centre y;size;stroke width[;90 to rotate], mm from the
  board origin, decimal comma): resizes each designator if needed and moves it so its box is
  centred on the given point. Undo with Ctrl+Z. Generated by Claude. }
Function Field(S : String; Idx : Integer) : String;
Var i, k : Integer;
Begin
  Result := ''; k := 0;
  For i := 1 To Length(S) Do
  Begin
    If S[i] = ';' Then k := k + 1
    Else If k = Idx Then Result := Result + S[i];
  End;
End;

Procedure ApplySilkA2;
Var
  Board : IPCB_Board;
  It : IPCB_BoardIterator;
  C : IPCB_Component;
  T : IPCB_Text;
  F, Names : TStringList;
  CL : TInterfaceList;
  i, j, n : Integer;
  S : String;
  R : TCoordRect;
  X, Y, Sz, W : TCoord;
  Rot : String;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  F := TStringList.Create;
  F.LoadFromFile('C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\silk_plan.txt');
  CL := TInterfaceList.Create;
  Names := TStringList.Create;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eComponentObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  C := It.FirstPCBObject;
  While C <> Nil Do
  Begin
    CL.Add(C); Names.Add(C.Name.Text);
    C := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  n := 0; Rot := '';
  PCBServer.PreProcess;
  For i := 0 To F.Count - 1 Do
  Begin
    S := F[i];
    j := Names.IndexOf(Field(S, 0));
    If j >= 0 Then
    Begin
      C := CL.Items[j];
      T := C.Name;
      X := Board.XOrigin + MMsToCoord(StrToFloat(Field(S, 1)));
      Y := Board.YOrigin + MMsToCoord(StrToFloat(Field(S, 2)));
      Sz := MMsToCoord(StrToFloat(Field(S, 3)));
      W := MMsToCoord(StrToFloat(Field(S, 4)));
      C.NameAutoPosition := eAutoPos_Manual;
      PCBServer.SendMessageToRobots(T.I_ObjectAddress, c_Broadcast, PCBM_BeginModify, c_NoEventData);
      If Abs(T.Size - Sz) > 100 Then T.Size := Sz;
      If Abs(T.Width - W) > 100 Then T.Width := W;
      PCBServer.SendMessageToRobots(T.I_ObjectAddress, c_Broadcast, PCBM_EndModify, c_NoEventData);
      If Trim(Field(S, 5)) = '90' Then
      Begin
        Rot := Rot + Field(S, 0) + ' ' + FloatToStr(T.Rotation);
        PCBServer.SendMessageToRobots(T.I_ObjectAddress, c_Broadcast, PCBM_BeginModify, c_NoEventData);
        T.Rotation := T.Rotation + 90;
        PCBServer.SendMessageToRobots(T.I_ObjectAddress, c_Broadcast, PCBM_EndModify, c_NoEventData);
        Rot := Rot + '->' + FloatToStr(T.Rotation) + '; ';
      End;
      PCBServer.SendMessageToRobots(T.I_ObjectAddress, c_Broadcast, PCBM_BeginModify, c_NoEventData);
      R := T.BoundingRectangle;
      T.MoveByXY(X - (R.Left + R.Right) Div 2, Y - (R.Bottom + R.Top) Div 2);
      PCBServer.SendMessageToRobots(T.I_ObjectAddress, c_Broadcast, PCBM_EndModify, c_NoEventData);
      n := n + 1;
    End;
  End;
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  ShowMessage('Placed ' + IntToStr(n) + ' of ' + IntToStr(F.Count) + ' designators. Rotated: ' + Rot);
End;
