Procedure SplitThisSheet3;
Var
  Doc  : ISch_Document;
  L    : TStringList;
  Name : String;
Begin
  Doc := SchServer.GetCurrentSchDocument;
  If Doc = Nil Then
  Begin
    ShowMessage('Make the schematic sheet active first.');
    Exit;
  End;
  Name := UpperCase(ExtractFileName(Doc.DocumentName));
  L := TStringList.Create;
  If Name = 'ADC.SCHDOC' Then Data3_ADC_main(L)
  Else If Name = 'ADC_A.SCHDOC' Then Data3_ADC_analog(L)
  Else
  Begin
    ShowMessage('No split data for ' + Name);
    L.Free;
    Exit;
  End;
  DoSplit(Doc, L);
  L.Free;
End;
