{ Third split: moves the PCM1808 audio ADC (IC15 and its parts) to the analog board. The jacks J26/J28 stay.
  Run with the sheet to split active: File > Run Script > SplitSheets3.pas > SplitThisSheet3.
  Works on ADC (main project) and ADC_A (analog project).
  Deletes the listed parts, wires, labels, power ports, ports and junctions, then places a port on every
  net that now crosses to the other board. Writes Scripts\split_report.txt. Generated by Claude. }
Const
  ReportPath = 'C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\split_report.txt';
  PortWidth = 700;

Function Mil(C : Integer) : String;
Begin
  Result := IntToStr(Round(CoordToMils(C)));
End;

Function KeyOf(O : ISch_GraphicalObject) : String;
Var
  i : Integer;
Begin
  Result := '';
  If O.ObjectId = eSchComponent Then
    Result := 'C|' + O.Designator.Text
  Else If O.ObjectId = eWire Then
  Begin
    Result := 'W|';
    For i := 1 To O.VerticesCount Do
    Begin
      If i > 1 Then Result := Result + ';';
      Result := Result + Mil(O.Vertex[i].X) + ',' + Mil(O.Vertex[i].Y);
    End;
  End
  Else If O.ObjectId = eNetLabel Then
    Result := 'N|' + O.Text + '|' + Mil(O.Location.X) + '|' + Mil(O.Location.Y)
  Else If O.ObjectId = ePowerObject Then
    Result := 'G|' + O.Text + '|' + Mil(O.Location.X) + '|' + Mil(O.Location.Y)
  Else If O.ObjectId = ePort Then
    Result := 'O|' + O.Name + '|' + Mil(O.Location.X) + '|' + Mil(O.Location.Y)
  Else If O.ObjectId = eJunction Then
    Result := 'J|' + Mil(O.Location.X) + '|' + Mil(O.Location.Y);
End;

Procedure AddPort(Doc : ISch_Document; Name : String; X, Y : Integer; Dir : String);
Var
  P : ISch_Port;
Begin
  P := SchServer.SchObjectFactory(ePort, eCreate_Default);
  If P = Nil Then Exit;
  P.Name := Name;
  P.IOType := ePortUnspecified;
  P.AutoSize := False;
  P.Width := MilsToCoord(PortWidth);
  If (Dir = 'R') Or (Dir = 'L') Then P.Style := ePortRight Else P.Style := ePortTop;
  If Dir = 'L' Then X := X - PortWidth;
  If Dir = 'D' Then Y := Y - PortWidth;
  P.Location := Point(MilsToCoord(X), MilsToCoord(Y));
  Doc.RegisterSchObjectInContainer(P);
  SchServer.RobotManager.SendMessage(Doc.I_ObjectAddress, c_BroadCast, SCHM_PrimitiveRegistration, P.I_ObjectAddress);
End;

Function Field(S : String; Idx : Integer) : String;
Var
  i, n : Integer;
Begin
  Result := '';
  n := 0;
  For i := 1 To Length(S) Do
  Begin
    If S[i] = '|' Then n := n + 1
    Else If n = Idx Then Result := Result + S[i];
  End;
End;

Procedure DoSplit(Doc : ISch_Document; Want : TStringList);
Var
  Iter    : ISch_Iterator;
  O       : ISch_GraphicalObject;
  Kill    : TInterfaceList;
  Found   : TStringList;
  Rep     : TStringList;
  K       : String;
  i, n    : Integer;
Begin
  Kill := TInterfaceList.Create;
  Found := TStringList.Create;
  Rep := TStringList.Create;
  Want.Sorted := True;
  Found.Sorted := True;
  Found.Duplicates := dupIgnore;
  Iter := Doc.SchIterator_Create;
  Iter.AddFilter_ObjectSet(MkSet(eSchComponent, eWire, eNetLabel, ePowerObject, ePort, eJunction));
  O := Iter.FirstSchObject;
  While O <> Nil Do
  Begin
    K := KeyOf(O);
    If (K <> '') And (Want.IndexOf(K) >= 0) Then
    Begin
      Kill.Add(O);
      Found.Add(K);
    End;
    O := Iter.NextSchObject;
  End;
  Doc.SchIterator_Destroy(Iter);

  SchServer.ProcessControl.PreProcess(Doc, '');
  For i := 0 To Kill.Count - 1 Do
  Begin
    O := Kill.Items[i];
    Doc.RemoveSchObject(O);
    SchServer.RobotManager.SendMessage(Doc.I_ObjectAddress, c_BroadCast, SCHM_PrimitiveRegistration, O.I_ObjectAddress);
  End;
  n := 0;
  For i := 0 To Want.Count - 1 Do
  Begin
    K := Want.Strings[i];
    If Copy(K, 1, 2) = 'A|' Then
    Begin
      AddPort(Doc, Field(K, 1), StrToInt(Field(K, 2)), StrToInt(Field(K, 3)), Field(K, 4));
      n := n + 1;
    End;
  End;
  SchServer.ProcessControl.PostProcess(Doc, '');
  Doc.GraphicallyInvalidate;

  Rep.Add('Sheet ' + Doc.DocumentName);
  Rep.Add('Deleted objects: ' + IntToStr(Kill.Count) + ', ports added: ' + IntToStr(n));
  For i := 0 To Want.Count - 1 Do
  Begin
    K := Want.Strings[i];
    If (Copy(K, 1, 2) <> 'A|') And (Found.IndexOf(K) < 0) Then Rep.Add('NOT FOUND ' + K);
  End;
  Rep.SaveToFile(ReportPath);
  ShowMessage('Deleted ' + IntToStr(Kill.Count) + ' objects, added ' + IntToStr(n) + ' ports. ' + IntToStr(Rep.Count - 2) + ' items not found (see split_report.txt). Save the sheet if it looks right.');
  Rep.Free;
  Found.Free;
  Kill.Free;
End;

