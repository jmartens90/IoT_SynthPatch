{ Deletes the dangling Bottom GND track from (81.08, 21.01) to (82.285, 21.012) mm (DRC
  coordinates, from the board origin) left after its via was removed. Generated by Claude. }
Procedure DeleteStubA;
Var
  Board : IPCB_Board;
  It : IPCB_BoardIterator;
  T, Del : IPCB_Track;
  X1, Y1, X2, Y2, Tol : TCoord;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  X1 := Board.XOrigin + MMsToCoord(81.08);  Y1 := Board.YOrigin + MMsToCoord(21.01);
  X2 := Board.XOrigin + MMsToCoord(82.285); Y2 := Board.YOrigin + MMsToCoord(21.012);
  Tol := MMsToCoord(0.02);
  Del := Nil;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eTrackObject));
  It.AddFilter_LayerSet(MkSet(eBottomLayer));
  It.AddFilter_Method(eProcessAll);
  T := It.FirstPCBObject;
  While T <> Nil Do
  Begin
    If ((Abs(T.X1 - X1) < Tol) And (Abs(T.Y1 - Y1) < Tol) And (Abs(T.X2 - X2) < Tol) And (Abs(T.Y2 - Y2) < Tol)) Or
       ((Abs(T.X1 - X2) < Tol) And (Abs(T.Y1 - Y2) < Tol) And (Abs(T.X2 - X1) < Tol) And (Abs(T.Y2 - Y1) < Tol)) Then Del := T;
    T := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  If Del = Nil Then
  Begin
    ShowMessage('Stub not found.');
    Exit;
  End;
  PCBServer.PreProcess;
  Board.RemovePCBObject(Del);
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  ShowMessage('Stub deleted.');
End;
