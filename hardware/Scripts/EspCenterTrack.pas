{ Joins the ESP32 (IC2) centre ground pad to its row neighbours with a 0.3 mm Bottom track
  through the module's GND thermal via, closing the last IC2 ground gap. Generated by Claude. }
Procedure EspCenterTrack;
Var
  Board : IPCB_Board;
  It : IPCB_BoardIterator;
  N, NG : IPCB_Net;
  T : IPCB_Track;
  RC : TCoordRect;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  RC := Board.BoardOutline.BoundingRectangle;
  NG := Nil;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eNetObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  N := It.FirstPCBObject;
  While N <> Nil Do
  Begin
    If UpperCase(N.Name) = 'GND' Then NG := N;
    N := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  If NG = Nil Then Exit;
  PCBServer.PreProcess;
  T := PCBServer.PCBObjectFactory(eTrackObject, eNoDimension, eCreate_Default);
  T.X1 := RC.Left + MMsToCoord(24.239);
  T.Y1 := RC.Bottom + MMsToCoord(92.966);
  T.X2 := RC.Left + MMsToCoord(27.039);
  T.Y2 := RC.Bottom + MMsToCoord(92.966);
  T.Width := MMsToCoord(0.3);
  T.Layer := eBottomLayer;
  Board.AddPCBObject(T);
  NG.AddPCBObject(T);
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  ShowMessage('Placed the ESP32 centre ground track.');
End;
