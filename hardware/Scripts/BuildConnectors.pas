{ Builds the board-to-board headers H1, H2 (1x18) and H3 (1x14) on the active, empty CONNECTORS sheet.
  Main project: female sockets. Analog project (path contains \ANALOG\): male pin headers.
  Every pin gets a short wire and a port (signals) or a power port (+12, -12, GND).
  Run: File > Run Script > BuildConnectors.pas > BuildConnectors. Generated by Claude. }
Var
  Doc : ISch_Document;

Procedure Reg(O : ISch_GraphicalObject);
Begin
  Doc.RegisterSchObjectInContainer(O);
  SchServer.RobotManager.SendMessage(Doc.I_ObjectAddress, c_BroadCast, SCHM_PrimitiveRegistration, O.I_ObjectAddress);
End;

Procedure AddWire(X1, Y1, X2, Y2 : Integer);
Var
  W : ISch_Wire;
Begin
  W := SchServer.SchObjectFactory(eWire, eCreate_Default);
  W.Location := Point(MilsToCoord(X1), MilsToCoord(Y1));
  W.InsertVertex := 1;
  W.SetState_Vertex(1, Point(MilsToCoord(X1), MilsToCoord(Y1)));
  W.InsertVertex := 2;
  W.SetState_Vertex(2, Point(MilsToCoord(X2), MilsToCoord(Y2)));
  W.LineWidth := eSmall;
  Reg(W);
End;

Procedure AddNet(Net : String; X, Y : Integer);
Var
  P  : ISch_Port;
  PW : ISch_PowerObject;
Begin
  If (Net = '+12') Or (Net = '-12') Or (Net = 'GND') Then
  Begin
    PW := SchServer.SchObjectFactory(ePowerObject, eCreate_Default);
    PW.Text := Net;
    If Net = 'GND' Then PW.Style := ePowerGndPower Else PW.Style := ePowerBar;
    PW.Orientation := eRotate270;
    If Net = 'GND' Then PW.Orientation := eRotate0;
    PW.ShowNetName := True;
    PW.Location := Point(MilsToCoord(X), MilsToCoord(Y));
    Reg(PW);
  End
  Else
  Begin
    P := SchServer.SchObjectFactory(ePort, eCreate_Default);
    P.Name := Net;
    P.IOType := ePortUnspecified;
    P.AutoSize := False;
    P.Width := MilsToCoord(700);
    P.Style := ePortRight;
    P.Location := Point(MilsToCoord(X), MilsToCoord(Y));
    Reg(P);
  End;
End;

Procedure AddHeader(Des, Fp, Cmt : String; X, Y : Integer; Nets : TStringList);
Var
  C    : ISch_Component;
  R    : ISch_Rectangle;
  P    : ISch_Pin;
  Impl : ISch_Implementation;
  i, N, PY : Integer;
Begin
  N := Nets.Count;
  C := SchServer.SchObjectFactory(eSchComponent, eCreate_Default);
  C.CurrentPartID := 1;
  C.DisplayMode := 0;
  C.LibReference := 'Header_1x' + IntToStr(N);
  C.ComponentDescription := Cmt;
  C.Location := Point(MilsToCoord(X), MilsToCoord(Y));
  R := SchServer.SchObjectFactory(eRectangle, eCreate_Default);
  R.Location := Point(MilsToCoord(X - 300), MilsToCoord(Y - N * 100));
  R.Corner := Point(MilsToCoord(X), MilsToCoord(Y + 100));
  R.OwnerPartId := 1;
  R.IsSolid := True;
  C.AddSchObject(R);
  For i := 0 To N - 1 Do
  Begin
    PY := Y - i * 100;
    P := SchServer.SchObjectFactory(ePin, eCreate_Default);
    P.Location := Point(MilsToCoord(X), MilsToCoord(PY));
    P.Orientation := eRotate0;
    P.PinLength := MilsToCoord(200);
    P.Designator := IntToStr(i + 1);
    P.Name := Nets.Strings[i];
    P.Electrical := eElectricPassive;
    P.OwnerPartId := 1;
    C.AddSchObject(P);
  End;
  C.Designator.Text := Des;
  C.Designator.Location := Point(MilsToCoord(X - 300), MilsToCoord(Y + 200));
  C.Comment.Text := Cmt;
  C.Comment.Location := Point(MilsToCoord(X - 300), MilsToCoord(Y - N * 100 - 150));
  Impl := C.AddSchImplementation;
  Impl.ClearAllDatafileLinks;
  Impl.Description := Fp;
  Impl.ModelName := Fp;
  Impl.ModelType := 'PCBLIB';
  Impl.AddDataFileLink(Fp, '', 'PCBLIB');
  Impl.IsCurrent := True;
  Reg(C);
  For i := 0 To N - 1 Do
  Begin
    PY := Y - i * 100;
    AddWire(X + 200, PY, X + 500, PY);
    AddNet(Nets.Strings[i], X + 500, PY);
  End;
End;

Procedure ClearSheet;
Var
  Iter : ISch_Iterator;
  O    : ISch_GraphicalObject;
  Kill : TInterfaceList;
  i    : Integer;
Begin
  Kill := TInterfaceList.Create;
  Iter := Doc.SchIterator_Create;
  Iter.AddFilter_ObjectSet(MkSet(eSheetSymbol, eSchComponent, eWire, eNetLabel, ePowerObject, ePort, eJunction));
  O := Iter.FirstSchObject;
  While O <> Nil Do
  Begin
    Kill.Add(O);
    O := Iter.NextSchObject;
  End;
  Doc.SchIterator_Destroy(Iter);
  For i := 0 To Kill.Count - 1 Do
  Begin
    O := Kill.Items[i];
    Doc.RemoveSchObject(O);
    SchServer.RobotManager.SendMessage(Doc.I_ObjectAddress, c_BroadCast, SCHM_PrimitiveRegistration, O.I_ObjectAddress);
  End;
  Kill.Free;
End;

Procedure BuildConnectors;
Var
  L : TStringList;
  Male : Boolean;
  Kind : String;
Begin
  Doc := SchServer.GetCurrentSchDocument;
  If Doc = Nil Then
  Begin
    ShowMessage('Make the CONNECTORS sheet active first.');
    Exit;
  End;
  Male := Pos('\ANALOG\', UpperCase(Doc.DocumentName)) > 0;
  If Male Then Kind := 'Pin header' Else Kind := 'Socket 8.5 mm';
  SchServer.ProcessControl.PreProcess(Doc, '');
  ClearSheet;
  L := TStringList.Create;
  L.Clear;
  L.Add('+12');
  L.Add('GND');
  L.Add('-12');
  L.Add('GND');
  L.Add('VREF_5');
  L.Add('GND');
  L.Add('VOUTA');
  L.Add('OUT_J10');
  L.Add('LED_Q10');
  L.Add('VOUTB');
  L.Add('OUT_J12');
  L.Add('LED_Q11');
  L.Add('VOUTC');
  L.Add('OUT_J14');
  L.Add('LED_Q12');
  L.Add('VOUTD');
  L.Add('OUT_J16');
  L.Add('LED_Q13');
  AddHeader('H1', 'HDR_1x18_P2.54', Kind + ' 1x18 2.54 mm', 1500, 7000, L);
  L.Clear;
  L.Add('+12');
  L.Add('GND');
  L.Add('-12');
  L.Add('GND');
  L.Add('VREF_5');
  L.Add('GND');
  L.Add('VOUTA2');
  L.Add('OUT_J11');
  L.Add('LED_Q14');
  L.Add('VOUTB2');
  L.Add('OUT_J13');
  L.Add('LED_Q15');
  L.Add('VOUTC2');
  L.Add('OUT_J15');
  L.Add('LED_Q16');
  L.Add('VOUTD2');
  L.Add('OUT_J17');
  L.Add('LED_Q17');
  AddHeader('H2', 'HDR_1x18_P2.54', Kind + ' 1x18 2.54 mm', 4500, 7000, L);
  L.Clear;
  L.Add('GND');
  L.Add('VREF');
  L.Add('VREF_BUF');
  L.Add('VOUT_REF');
  L.Add('VOCT_A');
  L.Add('VOCT_B');
  L.Add('OUT_J23');
  L.Add('OUT_J22');
  L.Add('GND');
  L.Add('IN_J26');
  L.Add('ADC_INL');
  L.Add('IN_J28');
  L.Add('ADC_INR');
  L.Add('GND');
  AddHeader('H3', 'HDR_1x14_P2.54', Kind + ' 1x14 2.54 mm', 7500, 7000, L);
  L.Free;
  SchServer.ProcessControl.PostProcess(Doc, '');
  Doc.GraphicallyInvalidate;
  ShowMessage('H1, H2 and H3 placed. Save the sheet.');
End;
