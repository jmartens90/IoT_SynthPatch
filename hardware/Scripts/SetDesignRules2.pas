{ Sets the general design rules for IoT_SYNTHPATCH (JLCPCB 4-layer, 1 oz). Generated by Claude.
  Clearance 0.2 mm, polygon clearance 0.3 mm, signal width 0.15/0.254 mm, via 0.3/0.6 mm,
  (hole to hole, board outline and silk to mask are set in the Rules dialog.)
  Run with IoT_SYNTHPATCH.PcbDoc active: File > Run Script > SetDesignRules2. }
Var
  Log : String;

Procedure SetClearance(R : IPCB_Rule);
Begin
  Try
    R.Gap := MMsToCoord(0.2);
    Log := Log + 'Clearance "' + R.Name + '" = 0.2 mm' + #13#10;
  Except
    Log := Log + 'FAILED clearance "' + R.Name + '"' + #13#10;
  End;
End;

Procedure SetWidth(R : IPCB_Rule);
Var Lyr : TLayer;
Begin
  Try
    For Lyr := eTopLayer To eBottomLayer Do
    Begin
      R.MinWidth[Lyr] := MMsToCoord(0.15);
      R.FavoredWidth[Lyr] := MMsToCoord(0.254);
      If R.MaxWidth[Lyr] < MMsToCoord(0.254) Then R.MaxWidth[Lyr] := MMsToCoord(2.0);
    End;
    Log := Log + 'Width "' + R.Name + '" = 0.15 / 0.254 mm' + #13#10;
  Except
    Log := Log + 'FAILED width "' + R.Name + '"' + #13#10;
  End;
End;

Procedure SetVia(R : IPCB_Rule);
Begin
  Try
    R.MinHoleWidth := MMsToCoord(0.3);
    R.PreferedHoleWidth := MMsToCoord(0.3);
    R.MaxHoleWidth := MMsToCoord(0.3);
    R.MinWidth := MMsToCoord(0.6);
    R.PreferedWidth := MMsToCoord(0.6);
    R.MaxWidth := MMsToCoord(0.6);
    Log := Log + 'Via style "' + R.Name + '" = 0.3 / 0.6 mm' + #13#10;
  Except
    Log := Log + 'FAILED via style "' + R.Name + '"' + #13#10;
  End;
End;

Procedure SetDesignRules2;
Var
  Board : IPCB_Board;
  Iter  : IPCB_BoardIterator;
  R     : IPCB_Rule;
  P     : IPCB_Rule;
  Found : Boolean;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  Log := '';
  Found := False;
  PCBServer.PreProcess;
  Iter := Board.BoardIterator_Create;
  Iter.AddFilter_ObjectSet(MkSet(eRuleObject));
  Iter.AddFilter_LayerSet(AllLayers);
  Iter.AddFilter_Method(eProcessAll);
  R := Iter.FirstPCBObject;
  While R <> Nil Do
  Begin
    If R.Name = 'Clearance_Polygon' Then Found := True
    Else If (R.RuleKind = eRule_Clearance) And (R.Scope1Expression = 'All') And (R.Scope2Expression = 'All') Then SetClearance(R)
    Else If (R.RuleKind = eRule_MaxMinWidth) And (R.Scope1Expression = 'All') Then SetWidth(R)
    Else If R.RuleKind = eRule_RoutingViaStyle Then SetVia(R);
    R := Iter.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(Iter);
  If Not Found Then
  Begin
    Try
      P := PCBServer.PCBRuleFactory(eRule_Clearance);
      P.Name := 'Clearance_Polygon';
      P.Scope1Expression := 'IsPolygon';
      P.Scope2Expression := 'All';
      P.Gap := MMsToCoord(0.3);
      P.Comment := 'Pour to other nets';
      Board.AddPCBObject(P);
      P.Priority := 1;
      Log := Log + 'Added "Clearance_Polygon" = 0.3 mm (priority 1)' + #13#10;
    Except
      Log := Log + 'FAILED adding Clearance_Polygon' + #13#10;
    End;
  End;
  PCBServer.PostProcess;
  ShowMessage(Log);
End;
