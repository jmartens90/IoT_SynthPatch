Procedure SplitThisSheet2;
Var
  Doc  : ISch_Document;
  L    : TStringList;
  Name : String;
Begin
  Doc := SchServer.GetCurrentSchDocument;
  If Doc = Nil Then
  Begin
    ShowMessage('Make the schematic sheet active first.');
    Exit;
  End;
  Name := UpperCase(ExtractFileName(Doc.DocumentName));
  L := TStringList.Create;
  If Name = 'INPUTS_GATES.SCHDOC' Then Data2_INPUTS_GATES_main(L)
  Else If Name = 'INPUTS_GATES_A.SCHDOC' Then Data2_INPUTS_GATES_analog(L)
  Else If Name = 'MUTE_BUTTONS.SCHDOC' Then Data2_MUTE_BUTTONS_main(L)
  Else If Name = 'MUTE_BUTTONS_A.SCHDOC' Then Data2_MUTE_BUTTONS_analog(L)
  Else If Name = 'MENU_BUTTONS.SCHDOC' Then Data2_MENU_BUTTONS_main(L)
  Else If Name = 'MENU_BUTTONS_A.SCHDOC' Then Data2_MENU_BUTTONS_analog(L)
  Else
  Begin
    ShowMessage('No split data for ' + Name);
    L.Free;
    Exit;
  End;
  DoSplit(Doc, L);
  L.Free;
End;
