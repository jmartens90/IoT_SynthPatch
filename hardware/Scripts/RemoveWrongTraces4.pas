{ Removes routing that ends on a header pad (H1, H2, H3) whose net no longer matches the track's net
  (left over after the header pin reorder). Polygon pour primitives are ignored. From each such pad it walks along the track chain of that net
  and deletes tracks and vias until it reaches another pad or a junction (where the net branches on),
  so routing that is still needed elsewhere stays. Report: Scripts\remove_wrong_traces.txt.
  Run with the PcbDoc active: File > Run Script > RemoveWrongTraces4.pas > RemoveWrongTraces. Generated by Claude. }
Const
  RP = 'C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\remove_wrong_traces.txt';

Var
  Board : IPCB_Board;
  Tracks, Vias, Pads, Del : TInterfaceList;
  Tol : TCoord;
  Rep : TStringList;

Function NetName(O : IPCB_Primitive) : String;
Begin
  If O.Net = Nil Then Result := '' Else Result := O.Net.Name;
End;

Function IsNear(X1, Y1, X2, Y2 : TCoord) : Boolean;
Begin
  Result := (Abs(X1 - X2) <= Tol) And (Abs(Y1 - Y2) <= Tol);
End;

Function IsDel(O : IPCB_Primitive) : Boolean;
Begin
  Result := Del.IndexOf(O) >= 0;
End;

Function OnPad(X, Y : TCoord; L : TLayer) : Boolean;
Var
  i : Integer;
  P : IPCB_Pad;
  H : TCoord;
Begin
  Result := False;
  For i := 0 To Pads.Count - 1 Do
  Begin
    P := Pads.Items[i];
    If (P.Layer = eMultiLayer) Or (P.Layer = L) Then
    Begin
      H := P.TopXSize;
      If P.TopYSize > H Then H := P.TopYSize;
      H := H Div 2;
      If (Abs(P.X - X) <= H) And (Abs(P.Y - Y) <= H) Then
      Begin
        Result := True;
        Exit;
      End;
    End;
  End;
End;

{ Deletes T, then follows its far end (X, Y) while the chain does not branch. }
Procedure Walk(T : IPCB_Track; X, Y : TCoord);
Var
  i, n : Integer;
  O, NextT : IPCB_Track;
  V, NextV : IPCB_Via;
  NetN : String;
  NX, NY : TCoord;
  Guard : Integer;
Begin
  NetN := NetName(T);
  Guard := 0;
  While (T <> Nil) And (Guard < 500) Do
  Begin
    Guard := Guard + 1;
    Del.Add(T);
    If OnPad(X, Y, T.Layer) Then Exit;
    NextV := Nil;
    For i := 0 To Vias.Count - 1 Do
    Begin
      V := Vias.Items[i];
      If (Not IsDel(V)) And IsNear(V.X, V.Y, X, Y) Then NextV := V;
    End;
    n := 0;
    NextT := Nil;
    For i := 0 To Tracks.Count - 1 Do
    Begin
      O := Tracks.Items[i];
      If (Not IsDel(O)) And (NetName(O) = NetN) And ((O.Layer = T.Layer) Or (NextV <> Nil)) Then
      Begin
        If IsNear(O.X1, O.Y1, X, Y) Then Begin n := n + 1; NextT := O; NX := O.X2; NY := O.Y2; End
        Else If IsNear(O.X2, O.Y2, X, Y) Then Begin n := n + 1; NextT := O; NX := O.X1; NY := O.Y1; End;
      End;
    End;
    If n > 1 Then Exit;      { junction: the rest of the net still needs it }
    If NextV <> Nil Then Del.Add(NextV);
    T := NextT;
    X := NX;
    Y := NY;
  End;
End;

Procedure RemoveWrongTraces;
Var
  It : IPCB_BoardIterator;
  O  : IPCB_Primitive;
  P  : IPCB_Pad;
  T  : IPCB_Track;
  i, j, Starts : Integer;
  HP : TInterfaceList;
  D  : String;
  H  : TCoord;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  Tol := MMsToCoord(0.02);
  Tracks := TInterfaceList.Create;
  Vias := TInterfaceList.Create;
  Pads := TInterfaceList.Create;
  HP := TInterfaceList.Create;
  Del := TInterfaceList.Create;
  Rep := TStringList.Create;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eTrackObject, eViaObject, ePadObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  O := It.FirstPCBObject;
  While O <> Nil Do
  Begin
    If O.ObjectId = eTrackObject Then
    Begin
      If (Not O.InPolygon) And ((O.Layer = eTopLayer) Or (O.Layer = eBottomLayer) Or (O.Layer = eMidLayer1) Or (O.Layer = eMidLayer2)) Then
        Tracks.Add(O);
    End
    Else If O.ObjectId = eViaObject Then Begin If Not O.InPolygon Then Vias.Add(O); End
    Else
    Begin
      Pads.Add(O);
      If O.Component <> Nil Then
      Begin
        D := O.Component.Name.Text;
        If (D = 'H1') Or (D = 'H2') Or (D = 'H3') Then HP.Add(O);
      End;
    End;
    O := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  Rep.Add('tracks ' + IntToStr(Tracks.Count) + ', vias ' + IntToStr(Vias.Count) + ', header pads ' + IntToStr(HP.Count));

  Starts := 0;
  For i := 0 To HP.Count - 1 Do
  Begin
    P := HP.Items[i];
    H := P.TopXSize;
    If P.TopYSize > H Then H := P.TopYSize;
    H := H Div 2;
    For j := 0 To Tracks.Count - 1 Do
    Begin
      T := Tracks.Items[j];
      If (Not IsDel(T)) And (NetName(T) <> '') And (NetName(T) <> NetName(P)) Then
      Begin
        If (Abs(T.X1 - P.X) <= H) And (Abs(T.Y1 - P.Y) <= H) Then
        Begin
          Rep.Add(P.Component.Name.Text + '-' + P.Name + ' is ' + NetName(P) + ', track was ' + NetName(T));
          Starts := Starts + 1;
          Walk(T, T.X2, T.Y2);
        End
        Else If (Abs(T.X2 - P.X) <= H) And (Abs(T.Y2 - P.Y) <= H) Then
        Begin
          Rep.Add(P.Component.Name.Text + '-' + P.Name + ' is ' + NetName(P) + ', track was ' + NetName(T));
          Starts := Starts + 1;
          Walk(T, T.X1, T.Y1);
        End;
      End;
    End;
  End;

  PCBServer.PreProcess;
  For i := 0 To Del.Count - 1 Do
  Begin
    O := Del.Items[i];
    Board.RemovePCBObject(O);
  End;
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  Rep.Add('removed ' + IntToStr(Del.Count) + ' tracks/vias from ' + IntToStr(Starts) + ' wrong pad connections');
  Rep.SaveToFile(RP);
  ShowMessage('Removed ' + IntToStr(Del.Count) + ' tracks/vias (' + IntToStr(Starts) + ' wrong header connections). See Scripts\remove_wrong_traces.txt. Save if it looks right.');
End;
