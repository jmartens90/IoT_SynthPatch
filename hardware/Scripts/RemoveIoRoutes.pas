{ Deletes all tracks, arcs and vias (not in polygons or footprints) on the ESP32 IO nets that go to
  the DACs (IO8, IO15, IO17, IO18, IO21), the PCM1808 ADC (IO35, IO36, IO37, IO42) and the TFT
  (IO4-IO7, IO9-IO12). Nets and pads stay, so the ratsnest shows what to reroute.
  Report: Scripts\remove_io_routes.txt. Run with the PcbDoc active. Generated by Claude. }
Const
  RP = 'C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\remove_io_routes.txt';
  NETS = ',IO4,IO5,IO6,IO7,IO8,IO9,IO10,IO11,IO12,IO15,IO17,IO18,IO21,IO35,IO36,IO37,IO42,';

Procedure RemoveIoRoutes;
Var
  Board : IPCB_Board;
  It : IPCB_BoardIterator;
  O : IPCB_Primitive;
  L : TInterfaceList;
  Rep : TStringList;
  i : Integer;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  L := TInterfaceList.Create;
  Rep := TStringList.Create;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eTrackObject, eArcObject, eViaObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  O := It.FirstPCBObject;
  While O <> Nil Do
  Begin
    If (O.Net <> Nil) And (Not O.InPolygon) And (Not O.InComponent) Then
      If Pos(',' + UpperCase(O.Net.Name) + ',', NETS) > 0 Then L.Add(O);
    O := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  PCBServer.PreProcess;
  For i := 0 To L.Count - 1 Do
  Begin
    O := L.Items[i];
    Rep.Add(O.Net.Name + ' ' + Layer2String(O.Layer));
    Board.RemovePCBObject(O);
  End;
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  Rep.Add('removed ' + IntToStr(L.Count));
  Rep.SaveToFile(RP);
  ShowMessage('Removed ' + IntToStr(L.Count) + ' tracks/arcs/vias on the DAC, ADC and TFT IO nets.');
End;
