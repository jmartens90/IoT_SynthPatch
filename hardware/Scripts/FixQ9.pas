{ MIDI sheet: points every PCB footprint link of Q9 at D8_N (the earlier script renamed the model but
  left the footprint lookup on 6n137), and sets the part number to HCPL-0700-000E.
  Run with MIDI.SchDoc active. Generated by Claude. }

Procedure FixQ9;
Var
  Sch   : ISch_Document;
  Iter  : ISch_Iterator;
  MIter : ISch_Iterator;
  Comp  : ISch_Component;
  Impl  : ISch_Implementation;
  Par   : ISch_Parameter;
  N, P  : Integer;
Begin
  Sch := SchServer.GetCurrentSchDocument;
  If Sch = Nil Then Exit;
  N := 0;
  P := 0;
  SchServer.ProcessControl.PreProcess(Sch, '');
  Iter := Sch.SchIterator_Create;
  Iter.AddFilter_ObjectSet(MkSet(eSchComponent));
  Comp := Iter.FirstSchObject;
  While Comp <> Nil Do
  Begin
    If Comp.Designator.Text = 'Q9' Then
    Begin
      MIter := Comp.SchIterator_Create;
      MIter.AddFilter_ObjectSet(MkSet(eImplementation));
      Impl := MIter.FirstSchObject;
      While Impl <> Nil Do
      Begin
        If UpperCase(Impl.ModelType) = 'PCBLIB' Then
        Begin
          SchServer.RobotManager.SendMessage(Impl.I_ObjectAddress, c_BroadCast, SCHM_BeginModify, c_NoEventData);
          Impl.ClearAllDatafileLinks;
          Impl.AddDataFileLink('D8_N', '', 'PCBLIB');
          Impl.ModelName := 'D8_N';
          SchServer.RobotManager.SendMessage(Impl.I_ObjectAddress, c_BroadCast, SCHM_EndModify, c_NoEventData);
          N := N + 1;
        End;
        Impl := MIter.NextSchObject;
      End;
      Comp.SchIterator_Destroy(MIter);
      MIter := Comp.SchIterator_Create;
      MIter.AddFilter_ObjectSet(MkSet(eParameter));
      Par := MIter.FirstSchObject;
      While Par <> Nil Do
      Begin
        If Par.Name = 'Manufacturer Part Number' Then Begin Par.Text := 'HCPL-0700-000E'; P := P + 1; End;
        If Par.Name = 'Octopart' Then Begin Par.Text := 'https://octopart.com/search?q=HCPL-0700-000E'; P := P + 1; End;
        Par := MIter.NextSchObject;
      End;
      Comp.SchIterator_Destroy(MIter);
      Comp.Comment.Text := 'HCPL-0700';
    End;
    Comp := Iter.NextSchObject;
  End;
  Sch.SchIterator_Destroy(Iter);
  SchServer.ProcessControl.PostProcess(Sch, '');
  Sch.GraphicallyInvalidate;
  ShowMessage('Q9: ' + IntToStr(N) + ' footprint links, ' + IntToStr(P) + ' parameters updated. Save the sheet.');
End;
