{ ShortUsbPadsPcb.pas - on the main PcbDoc: shortens J1's 12 SMD pads from 1.45 to 1.10 mm,
  matching the PcbLib change (ShortUsbPads.pas). Generated by Claude. }
Procedure ShortUsbPadsPcb;
Var Board : IPCB_Board; It : IPCB_BoardIterator; GIt : IPCB_GroupIterator; C, J1 : IPCB_Component; P : IPCB_Pad; L : TStringList; N : Integer;
Begin
  L := TStringList.Create; N := 0;
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  J1 := Nil;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eComponentObject)); It.AddFilter_LayerSet(AllLayers); It.AddFilter_Method(eProcessAll);
  C := It.FirstPCBObject;
  While C <> Nil Do Begin If C.Name.Text = 'J1' Then J1 := C; C := It.NextPCBObject; End;
  Board.BoardIterator_Destroy(It);
  If J1 = Nil Then L.Add('ERROR no J1')
  Else
  Begin
    PCBServer.PreProcess;
    GIt := J1.GroupIterator_Create; GIt.AddFilter_ObjectSet(MkSet(ePadObject));
    P := GIt.FirstPCBObject;
    While P <> Nil Do
    Begin
      If (P.HoleSize = 0) And (Abs(P.TopYSize - MMsToCoord(1.45)) < MMsToCoord(0.02)) Then
      Begin
        P.BeginModify;
        P.TopYSize := MMsToCoord(1.1); P.MidYSize := MMsToCoord(1.1); P.BotYSize := MMsToCoord(1.1);
        P.EndModify;
        Inc(N);
      End;
      P := GIt.NextPCBObject;
    End;
    J1.GroupIterator_Destroy(GIt);
    PCBServer.PostProcess;
    Board.ViewManager_FullUpdate;
  End;
  L.Add('J1 pads shortened: ' + IntToStr(N));
  L.SaveToFile('C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\shortusbpcb_log.txt');
End;
