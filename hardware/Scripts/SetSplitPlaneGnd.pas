{ Gives every split-plane region on internal plane layers the GND net (the analog board's
  only plane is GND) and reports what it found. Generated by Claude. }
Procedure SetSplitPlaneGnd;
Var
  Board : IPCB_Board;
  It : IPCB_BoardIterator;
  SP : IPCB_SplitPlane;
  N, NG : IPCB_Net;
  L : TInterfaceList;
  i : Integer;
  S, NN : String;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  NG := Nil;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eNetObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  N := It.FirstPCBObject;
  While N <> Nil Do
  Begin
    If N.Name = 'GND' Then NG := N;
    N := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  If NG = Nil Then
  Begin
    ShowMessage('Net GND not found.');
    Exit;
  End;

  L := TInterfaceList.Create;
  S := '';
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eSplitPlaneObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  SP := It.FirstPCBObject;
  While SP <> Nil Do
  Begin
    If SP.Net = Nil Then NN := '(none)' Else NN := SP.Net.Name;
    S := S + Layer2String(SP.Layer) + ': ' + NN + #13#10;
    L.Add(SP);
    SP := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);

  PCBServer.PreProcess;
  For i := 0 To L.Count - 1 Do
  Begin
    SP := L.Items[i];
    If SP.Net = Nil Then
    Begin
      PCBServer.SendMessageToRobots(SP.I_ObjectAddress, c_Broadcast, PCBM_BeginModify, c_NoEventData);
      NG.AddPCBObject(SP);
      PCBServer.SendMessageToRobots(SP.I_ObjectAddress, c_Broadcast, PCBM_EndModify, c_NoEventData);
    End;
  End;
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  ShowMessage('Split planes before: ' + #13#10 + S + 'Set the ones without a net to GND.');
End;
