{ Draws split lines on the PWR plane (Internal Plane 1) of the main board.
  Coordinates in mm from the board's bottom-left corner (outline at X0, Y0 below).
  Regions: +3.3 top (y > 80.5 left of x 41.5, y > 76 right of it), +5 below,
  +12 islands at the right (x > 91, 66 < y < 76) and around U2 (x 42-51.5, y 79-86),
  VREF_5 island (x 23.5-34, y 58.5-79.5). Nets are assigned afterwards by AssignPlaneSplits.
  Generated by Claude. }
Const
  X0 = 5.0;
  Y0 = 10.0;
  W = 0.5;

Var
  Board : IPCB_Board;
  Cnt : Integer;

Procedure Seg(XA, YA, XB, YB : Double);
Var
  T : IPCB_Track;
Begin
  T := PCBServer.PCBObjectFactory(eTrackObject, eNoDimension, eCreate_Default);
  T.X1 := MMsToCoord(XA + X0);
  T.Y1 := MMsToCoord(YA + Y0);
  T.X2 := MMsToCoord(XB + X0);
  T.Y2 := MMsToCoord(YB + Y0);
  T.Width := MMsToCoord(W);
  T.Layer := eInternalPlane1;
  Board.AddPCBObject(T);
  Cnt := Cnt + 1;
End;

Procedure Box(XA, YA, XB, YB : Double);
Begin
  Seg(XA, YA, XB, YA);
  Seg(XB, YA, XB, YB);
  Seg(XB, YB, XA, YB);
  Seg(XA, YB, XA, YA);
End;

Procedure DrawPlaneSplits;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  Cnt := 0;
  PCBServer.PreProcess;
  { +3.3 / +5 boundary, edge to edge }
  Seg(-1, 80.5, 41.5, 80.5);
  Seg(41.5, 80.5, 41.5, 76);
  Seg(41.5, 76, 110, 76);
  { +12 island at the right, closed by the boundary line and the board edge }
  Seg(91, 76, 91, 66);
  Seg(91, 66, 110, 66);
  { +12 island around U2 / C90 }
  Box(42, 79, 51.5, 86);
  { VREF_5 island }
  Box(23.5, 58.5, 34, 79.5);
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  ShowMessage('Placed ' + IntToStr(Cnt) + ' split lines on Internal Plane 1.');
End;
