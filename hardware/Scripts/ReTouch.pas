{ ReTouch.pas - Generated by Claude. Run with POWER.SchDoc active: re-applies power port
  texts through the modify messages so the compiler sees +5_BUCK. }
Procedure ReTouch;
Var Doc, It, P, Log, S, N;
Begin
  Log := TStringList.Create; N := 0;
  Doc := SchServer.GetCurrentSchDocument;
  If Doc = Nil Then Exit;
  SchServer.ProcessControl.PreProcess(Doc, '');
  It := Doc.SchIterator_Create;
  It.AddFilter_ObjectSet(MkSet(ePowerObject, eWire));
  P := It.FirstSchObject;
  While P <> Nil Do
  Begin
    If P.ObjectId = ePowerObject Then S := P.Text Else S := 'wire';
    SchServer.RobotManager.SendMessage(P.I_ObjectAddress, c_BroadCast, SCHM_BeginModify, c_NoEventData);
    If P.ObjectId = ePowerObject Then Begin P.Text := S + 'x'; P.Text := S; End;
    SchServer.RobotManager.SendMessage(P.I_ObjectAddress, c_BroadCast, SCHM_EndModify, c_NoEventData);
    If S = '+5_BUCK' Then Log.Add('port +5_BUCK at ' + IntToStr(CoordToMils(P.Location.X)) + ',' + IntToStr(CoordToMils(P.Location.Y)));
    N := N + 1;
    P := It.NextSchObject;
  End;
  Doc.SchIterator_Destroy(It);
  SchServer.ProcessControl.PostProcess(Doc, '');
  Log.Add('touched ' + IntToStr(N));
  Log.SaveToFile('C:\Users\12502784\Documents\IoTSynthPatch\IoT_SynthPatch\hardware\Scripts\retouch_log.txt');
End;
