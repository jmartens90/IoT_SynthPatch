{ For every component whose designator overlaps a pad (with mask margin), other silkscreen or
  the board edge, moves the designator to the nearest free spot (around the part, up to 4 mm
  away) that keeps 0.3 mm from pads and 0.27 mm from other silk. Size and rotation unchanged.
  Undo with Ctrl+Z. Generated by Claude. }
Var
  Board : IPCB_Board;
  BL, BB, BRt, BT : TCoord;
  GapPad, GapSilk : TCoord;

Function Hit(L, B, R, T : TCoord; O : IPCB_Primitive; G : TCoord) : Boolean;
Var Q : TCoordRect;
Begin
  Q := O.BoundingRectangle;
  Result := (L < Q.Right + G) And (Q.Left < R + G) And (B < Q.Top + G) And (Q.Bottom < T + G);
End;

Procedure Collect(T : IPCB_Text; L : TInterfaceList);
Var
  It : IPCB_SpatialIterator;
  O : IPCB_Primitive;
  R : TCoordRect;
  Side : TLayer;
  M : TCoord;
Begin
  If T.Layer = eTopOverlay Then Side := eTopLayer Else Side := eBottomLayer;
  R := T.BoundingRectangle;
  M := MMsToCoord(8);
  It := Board.SpatialIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eTrackObject, eArcObject, eTextObject, ePadObject, eFillObject, eRegionObject));
  It.AddFilter_LayerSet(MkSet(T.Layer, Side, eMultiLayer));
  It.AddFilter_Area(R.Left - M, R.Bottom - M, R.Right + M, R.Top + M);
  O := It.FirstPCBObject;
  While O <> Nil Do
  Begin
    If Not (O.I_ObjectAddress = T.I_ObjectAddress) Then
    Begin
      If O.ObjectId = ePadObject Then L.Add(O)
      Else If O.Layer = T.Layer Then
      Begin
        If O.ObjectId = eTextObject Then
        Begin
          If Not O.IsHidden Then L.Add(O);
        End
        Else L.Add(O);
      End;
    End;
    O := It.NextPCBObject;
  End;
  Board.SpatialIterator_Destroy(It);
End;

Function Fits(R : TCoordRect; DX, DY : TCoord; L : TInterfaceList) : Boolean;
Var
  i : Integer;
  O : IPCB_Primitive;
  XL, XB, XR, XT, G : TCoord;
Begin
  XL := R.Left + DX; XR := R.Right + DX; XB := R.Bottom + DY; XT := R.Top + DY;
  Result := (XL > BL) And (XR < BRt) And (XB > BB) And (XT < BT);
  i := 0;
  While Result And (i < L.Count) Do
  Begin
    O := L.Items[i];
    If O.ObjectId = ePadObject Then G := GapPad Else G := GapSilk;
    If Hit(XL, XB, XR, XT, O, G) Then Result := False;
    i := i + 1;
  End;
End;

Procedure ArrangeDesignatorsA2;
Var
  It : IPCB_BoardIterator;
  C : IPCB_Component;
  T : IPCB_Text;
  CL, L : TInterfaceList;
  R, BR : TCoordRect;
  i, k, s, d, nMoved, nFail, nOk : Integer;
  BX, BY, St : TCoord;
  Found : Boolean;
  Fail : String;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  GapPad := MMsToCoord(0.3);
  GapSilk := MMsToCoord(0.27);
  BR := Board.BoardOutline.BoundingRectangle;
  BL := BR.Left + MMsToCoord(0.6); BRt := BR.Right - MMsToCoord(0.6);
  BB := BR.Bottom + MMsToCoord(0.6); BT := BR.Top - MMsToCoord(0.6);
  St := MMsToCoord(0.1);

  CL := TInterfaceList.Create;
  It := Board.BoardIterator_Create;
  It.AddFilter_ObjectSet(MkSet(eComponentObject));
  It.AddFilter_LayerSet(AllLayers);
  It.AddFilter_Method(eProcessAll);
  C := It.FirstPCBObject;
  While C <> Nil Do
  Begin
    CL.Add(C);
    C := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);

  nMoved := 0; nFail := 0; nOk := 0; Fail := '';
  PCBServer.PreProcess;
  For i := 0 To CL.Count - 1 Do
  Begin
    C := CL.Items[i];
    T := C.Name;
    If C.NameOn Then
    Begin
      L := TInterfaceList.Create;
      Collect(T, L);
      R := T.BoundingRectangle;
      If Fits(R, 0, 0, L) Then nOk := nOk + 1
      Else
      Begin
        Found := False;
        { rings of growing distance (0.1 mm steps, up to 4 mm); first free spot wins }
        d := 1;
        While (Not Found) And (d <= 40) Do
        Begin
          For s := -d To d Do
            For k := -d To d Do
              If (Not Found) And ((Abs(s) = d) Or (Abs(k) = d)) Then
                If Fits(R, s * St, k * St, L) Then
                Begin
                  Found := True; BX := s * St; BY := k * St;
                End;
          d := d + 1;
        End;
        If Found Then
        Begin
          C.NameAutoPosition := eAutoPos_Manual;
          PCBServer.SendMessageToRobots(T.I_ObjectAddress, c_Broadcast, PCBM_BeginModify, c_NoEventData);
          T.MoveByXY(BX, BY);
          PCBServer.SendMessageToRobots(T.I_ObjectAddress, c_Broadcast, PCBM_EndModify, c_NoEventData);
          nMoved := nMoved + 1;
        End
        Else
        Begin
          nFail := nFail + 1;
          Fail := Fail + C.Name.Text + ' ';
        End;
      End;
    End;
  End;
  PCBServer.PostProcess;
  Board.ViewManager_FullUpdate;
  ShowMessage('Components ' + IntToStr(CL.Count) + '. Designators OK ' + IntToStr(nOk) + ', moved ' + IntToStr(nMoved) + ', no spot ' + IntToStr(nFail) + ': ' + Fail);
End;
