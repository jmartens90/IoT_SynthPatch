{ Reports which layer IDs the stack uses: mid signal layers and internal planes. Generated by Claude. }
Procedure CheckStack;
Var
  Board : IPCB_Board;
  LO : IPCB_LayerObject;
  L : Integer;
  S : String;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  S := 'Mid: ';
  For L := eMidLayer1 To eMidLayer4 Do
  Begin
    LO := Board.LayerStack.LayerObject(L);
    If LO <> Nil Then S := S + IntToStr(L - eMidLayer1 + 1) + '=' + LO.Name + ' ';
  End;
  S := S + ' / Planes: ';
  For L := eInternalPlane1 To eInternalPlane4 Do
  Begin
    LO := Board.LayerStack.LayerObject(L);
    If LO <> Nil Then S := S + IntToStr(L - eInternalPlane1 + 1) + '=' + LO.Name + ' (' + LO.NetName + ') ';
  End;
  ShowMessage(S);
End;
