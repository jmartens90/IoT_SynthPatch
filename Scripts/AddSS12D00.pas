{ Adds footprint SS12D00_SPDT (SS-12D00 slide switch, 3 pins, 2.54 mm pitch) to the open PcbLib.
  Open IoT_SYNTHPATCH.PcbLib, then File > Run Script > AddSS12D00.pas > AddSS12D00. Generated by Claude. }
Procedure AddPad(Lib : IPCB_Library; Comp : IPCB_LibComponent; Name : String; X : Double; Square : Boolean);
Var
  P : IPCB_Pad;
Begin
  P := PCBServer.PCBObjectFactory(ePadObject, eNoDimension, eCreate_Default);
  P.X        := Lib.Board.XOrigin + MMsToCoord(X);
  P.Y        := Lib.Board.YOrigin;
  P.Layer    := eMultiLayer;
  P.TopXSize := MMsToCoord(1.6);
  P.TopYSize := MMsToCoord(1.6);
  P.MidXSize := MMsToCoord(1.6);
  P.MidYSize := MMsToCoord(1.6);
  P.BotXSize := MMsToCoord(1.6);
  P.BotYSize := MMsToCoord(1.6);
  P.HoleSize := MMsToCoord(1.0);
  If Square Then P.TopShape := eRectangular Else P.TopShape := eRounded;
  If Square Then P.BotShape := eRectangular Else P.BotShape := eRounded;
  P.MidShape := eRounded;
  P.Name     := Name;
  Comp.AddPCBObject(P);
  PCBServer.SendMessageToRobots(Comp.I_ObjectAddress, c_Broadcast, PCBM_BoardRegisteration, P.I_ObjectAddress);
End;

Procedure AddLine(Lib : IPCB_Library; Comp : IPCB_LibComponent; Layer : TLayer; X1, Y1, X2, Y2, W : Double);
Var
  T : IPCB_Track;
Begin
  T := PCBServer.PCBObjectFactory(eTrackObject, eNoDimension, eCreate_Default);
  T.X1 := Lib.Board.XOrigin + MMsToCoord(X1);
  T.Y1 := Lib.Board.YOrigin + MMsToCoord(Y1);
  T.X2 := Lib.Board.XOrigin + MMsToCoord(X2);
  T.Y2 := Lib.Board.YOrigin + MMsToCoord(Y2);
  T.Layer := Layer;
  T.Width := MMsToCoord(W);
  Comp.AddPCBObject(T);
  PCBServer.SendMessageToRobots(Comp.I_ObjectAddress, c_Broadcast, PCBM_BoardRegisteration, T.I_ObjectAddress);
End;

Procedure AddRect(Lib : IPCB_Library; Comp : IPCB_LibComponent; Layer : TLayer; HX, HY, W : Double);
Begin
  AddLine(Lib, Comp, Layer, -HX, -HY,  HX, -HY, W);
  AddLine(Lib, Comp, Layer,  HX, -HY,  HX,  HY, W);
  AddLine(Lib, Comp, Layer,  HX,  HY, -HX,  HY, W);
  AddLine(Lib, Comp, Layer, -HX,  HY, -HX, -HY, W);
End;

Procedure AddSS12D00;
Var
  Lib  : IPCB_Library;
  Comp : IPCB_LibComponent;
Begin
  Lib := PCBServer.GetCurrentPCBLibrary;
  If Lib = Nil Then
  Begin
    ShowMessage('Open IoT_SYNTHPATCH.PcbLib first.');
    Exit;
  End;
  Comp := PCBServer.CreatePCBLibComp;
  Comp.Name := 'SS12D00_SPDT';
  Comp.Description := 'SS-12D00 SPDT slide switch, 3 pins 2.54 mm, body 8.5 x 4 mm';
  Comp.Height := MMsToCoord(10);
  Lib.RegisterComponent(Comp);
  PCBServer.PreProcess;
  AddPad(Lib, Comp, '1', -2.54, True);
  AddPad(Lib, Comp, '2',  0,    False);
  AddPad(Lib, Comp, '3',  2.54, False);
  AddRect(Lib, Comp, eTopOverlay, 4.3, 2.0, 0.15);
  AddLine(Lib, Comp, eTopOverlay, -0.75, 0.9, 0.75, 0.9, 0.15);
  AddRect(Lib, Comp, eMechanical15, 4.6, 2.3, 0.05);
  PCBServer.PostProcess;
  Lib.CurrentComponent := Comp;
  Lib.Board.ViewManager_FullUpdate;
  ShowMessage('Footprint SS12D00_SPDT added. Save the library.');
End;
