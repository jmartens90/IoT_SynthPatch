{ Sets the PCB footprint of SW1 and SW2 to SS12D00_SPDT on the open schematic sheet.
  Open Main.SchDoc, then File > Run Script > SetSwitchFootprint.pas > SetSwitchFootprint. Generated by Claude. }
Procedure SetSwitchFootprint;
Var
  Sch   : ISch_Document;
  Iter  : ISch_Iterator;
  MIter : ISch_Iterator;
  Comp  : ISch_Component;
  Impl  : ISch_Implementation;
  N     : Integer;
Begin
  Sch := SchServer.GetCurrentSchDocument;
  If Sch = Nil Then Exit;
  N := 0;
  SchServer.ProcessControl.PreProcess(Sch, '');
  Iter := Sch.SchIterator_Create;
  Iter.AddFilter_ObjectSet(MkSet(eSchComponent));
  Comp := Iter.FirstSchObject;
  While Comp <> Nil Do
  Begin
    If (Comp.Designator.Text = 'SW1') Or (Comp.Designator.Text = 'SW2') Then
    Begin
      MIter := Comp.SchIterator_Create;
      MIter.AddFilter_ObjectSet(MkSet(eImplementation));
      Impl := MIter.FirstSchObject;
      While Impl <> Nil Do
      Begin
        If UpperCase(Impl.ModelType) = 'PCBLIB' Then
        Begin
          SchServer.RobotManager.SendMessage(Impl.I_ObjectAddress, c_BroadCast, SCHM_BeginModify, c_NoEventData);
          Impl.ModelName := 'SS12D00_SPDT';
          Impl.Description := 'SS-12D00 slide switch';
          SchServer.RobotManager.SendMessage(Impl.I_ObjectAddress, c_BroadCast, SCHM_EndModify, c_NoEventData);
          N := N + 1;
        End;
        Impl := MIter.NextSchObject;
      End;
      Comp.SchIterator_Destroy(MIter);
      Comp.Comment.Text := 'SS-12D00G2';
    End;
    Comp := Iter.NextSchObject;
  End;
  Sch.SchIterator_Destroy(Iter);
  SchServer.ProcessControl.PostProcess(Sch, '');
  Sch.GraphicallyInvalidate;
  ShowMessage('Changed ' + IntToStr(N) + ' footprint links. Save the sheet, then Design > Update PCB Document.');
End;
