{ Net classes + width rules for power (generated by Claude).
  PWR_IN : connector, +/-12 V, buck input and switch nodes  -> 0.4 / 0.8 / 2.0 mm
  PWR_LV : +5, +3.3, +5_USB, GND                             -> 0.3 / 0.5 / 2.0 mm }
Procedure AddClass(Board : IPCB_Board; Name : String; Nets : String);
Var NC : IPCB_ObjectClass; L : TStringList; i : Integer;
Begin
  NC := PCBServer.PCBClassFactoryByClassMember(eClassMemberKind_Net);
  NC.SuperClass := False;
  NC.Name := Name;
  L := TStringList.Create;
  L.Delimiter := ','; L.StrictDelimiter := True; L.DelimitedText := Nets;
  For i := 0 To L.Count - 1 Do NC.AddMemberByName(L[i]);
  L.Free;
  Board.AddPCBObject(NC);
End;

Procedure AddWidth(Board : IPCB_Board; Name, Cls : String; MinW, PrefW, MaxW : Double; Prio : Integer);
Var R : IPCB_MaxMinWidthConstraint; Lyr : TLayer;
Begin
  R := PCBServer.PCBRuleFactory(eRule_MaxMinWidth);
  R.Name := Name;
  R.Scope1Expression := 'InNetClass(''' + Cls + ''')';
  For Lyr := eTopLayer To eBottomLayer Do
  Begin
    R.MinWidth[Lyr] := MMsToCoord(MinW);
    R.FavoredWidth[Lyr] := MMsToCoord(PrefW);
    R.MaxWidth[Lyr] := MMsToCoord(MaxW);
  End;
  Board.AddPCBObject(R);
End;

Procedure PowerRules2;
Var Board : IPCB_Board;
Begin
  Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Exit;
  PCBServer.PreProcess;
  AddWidth(Board, 'Width_PWR_LV', 'PWR_LV', 0.3, 0.5, 2.0, 2);
  PCBServer.PostProcess;
  ShowMessage('Width_PWR_LV added.');
End;
