{ Place all non-panel components on the bottom side (generated by Claude). Undo: Ctrl+Z }
Function Fld(S : String; Idx : Integer) : Integer;
Var i, p : Integer; T : String;
Begin
  T := S + ';';
  For i := 1 To Idx Do Begin p := Pos(';', T); T := Copy(T, p + 1, Length(T)); End;
  p := Pos(';', T);
  Result := StrToInt(Copy(T, 1, p - 1));
End;

